{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:weavec:schema:project-module-cache:v1",
  "title": "weavec-project-module-cache-v1",
  "type": "object",
  "required": [
    "format",
    "status",
    "cache_dir",
    "exit_code",
    "modules"
  ],
  "properties": {
    "format": {"const": "weavec-project-module-cache-v1"},
    "status": {"enum": ["succeeded", "failed"]},
    "cache_dir": {"type": "string"},
    "exit_code": {"type": "integer", "minimum": 0},
    "modules": {
      "type": "array",
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "succeeded"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "exit_code": {"const": 0},
          "cache_dir": {"type": "string", "minLength": 1},
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/successful_module"}
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "module": {
      "type": "object",
      "required": [
        "name",
        "source",
        "interface_sha256",
        "key",
        "decision",
        "reason"
      ],
      "properties": {
        "name": {"type": "string"},
        "source": {"type": "string"},
        "interface_sha256": {"type": "string"},
        "key": {"type": "string"},
        "decision": {"type": "string"},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    },
    "successful_module": {
      "allOf": [
        {"$ref": "#/$defs/module"},
        {
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "interface_sha256": {"$ref": "#/$defs/sha256"},
            "key": {"$ref": "#/$defs/sha256"},
            "decision": {"enum": ["rebuilt", "reused"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
