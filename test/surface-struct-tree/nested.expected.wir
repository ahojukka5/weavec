(core-module
  (core-version 3)
  (decls
    (extern malloc (params (size i64)) (returns ptr))
    (extern free (params (value ptr)) (returns void))
    (struct Inner (field n i32))
    (fn Inner_new (params (n i32)) (returns ptr)
      (do
        (let self ptr (call_ptr malloc (struct_size Inner)))
        (if (condition (eq_ptr (local_get self) (const_null)))
          (then (do (return (const_null))))
          (else (do)))
        (field_set_i32 Inner n (local_get self) (param_get n))
        (return (local_get self))))
    (fn Inner_get_n (params (self ptr)) (returns i32)
      (do (return (field_get_i32 Inner n (param_get self)))))
    (fn Inner_set_n (params (self ptr) (v i32)) (returns void)
      (do (field_set_i32 Inner n (param_get self) (param_get v)) (return_void)))
    (struct Holder (field child ptr) (field extra i32))
    (fn Holder_new (params (child ptr) (extra i32)) (returns ptr)
      (do
        (let self ptr (call_ptr malloc (struct_size Holder)))
        (if (condition (eq_ptr (local_get self) (const_null)))
          (then (do (return (const_null))))
          (else (do)))
        (field_set_ptr Holder child (local_get self) (param_get child))
        (field_set_i32 Holder extra (local_get self) (param_get extra))
        (return (local_get self))))
    (fn Holder_get_child (params (self ptr)) (returns ptr)
      (do (return (field_get_ptr Holder child (param_get self)))))
    (fn Holder_set_child (params (self ptr) (v ptr)) (returns void)
      (do (field_set_ptr Holder child (param_get self) (param_get v)) (return_void)))
    (fn Holder_get_extra (params (self ptr)) (returns i32)
      (do (return (field_get_i32 Holder extra (param_get self)))))
    (fn Holder_set_extra (params (self ptr) (v i32)) (returns void)
      (do (field_set_i32 Holder extra (param_get self) (param_get v)) (return_void)))
    (fn main (params) (returns i32) (do (let inner ptr (call_ptr Inner_new (const_i32 40))) (let holder ptr (call_ptr Holder_new inner (const_i32 1))) (call_void Holder_set_extra holder (add_i32 (call_i32 Holder_get_extra holder) (const_i32 1))) (let result i32 (add_i32 (call_i32 Inner_get_n inner) (call_i32 Holder_get_extra holder))) (call_void free holder) (call_void free inner) (return result)))
  )
)
