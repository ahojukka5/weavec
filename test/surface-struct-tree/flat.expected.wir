(core-module
  (core-version 3)
  (decls
    (extern malloc (params (size i64)) (returns ptr))
    (extern free (params (value ptr)) (returns void))
    (struct Point (field x i32) (field y i32))
    (fn Point_new (params (x i32) (y i32)) (returns ptr)
      (do
        (let self ptr (call_ptr malloc (struct_size Point)))
        (if (condition (eq_ptr (local_get self) (const_null)))
          (then (do (return (const_null))))
          (else (do)))
        (field_set_i32 Point x (local_get self) (param_get x))
        (field_set_i32 Point y (local_get self) (param_get y))
        (return (local_get self))))
    (fn Point_get_x (params (self ptr)) (returns i32)
      (do (return (field_get_i32 Point x (param_get self)))))
    (fn Point_set_x (params (self ptr) (v i32)) (returns void)
      (do (field_set_i32 Point x (param_get self) (param_get v)) (return_void)))
    (fn Point_get_y (params (self ptr)) (returns i32)
      (do (return (field_get_i32 Point y (param_get self)))))
    (fn Point_set_y (params (self ptr) (v i32)) (returns void)
      (do (field_set_i32 Point y (param_get self) (param_get v)) (return_void)))
    (fn main (params) (returns i32) (do (let p ptr (call_ptr Point_new (const_i32 40) (const_i32 2))) (call_void Point_set_y p (add_i32 (call_i32 Point_get_y p) (const_i32 0))) (let result i32 (call_i32 Point_get_x p)) (call_void free p) (return result)))
  )
)
