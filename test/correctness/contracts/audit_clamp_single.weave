(program
  (name "audit_clamp_single")
  (version "0.1")
  (entry main)
  (fn clamp
    (params (x i32) (lo i32) (hi i32))
    (returns i32)
    (do
      (if
        (condition (lt_i32 x lo))
        (then (do (return lo)))
        (else (do)))
      (if
        (condition (gt_i32 x hi))
        (then (do (return hi)))
        (else (do)))
      (return x)))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 clamp (const_i32 5) (const_i32 0) (const_i32 10))))))
