(program
  (name "audit_if_return_param")
  (version "0.1")
  (entry main)
  (fn f
    (params (x i32) (lo i32))
    (returns i32)
    (do
      (if
        (condition (lt_i32 x lo))
        (then (do (return lo)))
        (else (do)))
      (return x)))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 f (const_i32 5) (const_i32 0))))))
