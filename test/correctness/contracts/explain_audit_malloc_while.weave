; explain_audit_malloc_while.weave
; purpose: --explain audit counters for while loops, malloc/free, entry-only stub.

(program
  (name "explain_audit_malloc_while")
  (version "0.1")
  (entry bootstrap)
  (entry main)
  (extern malloc (params (size i64)) (returns ptr))
  (extern free (params (p ptr)) (returns void))
  (fn worker
    (params (n i32))
    (returns i32)
    (do
      (let buf ptr (call_ptr malloc (const_i64 8)))
      (let sum i32 (const_i32 0))
      (let i i32 (const_i32 0))
      (while
        (condition (lt_i32 (local_get i) (param_get n)))
        (do
          (store_i32 (local_get buf) (local_get sum))
          (set sum (add_i32 (local_get sum) (local_get i)))
          (set i (add_i32 (local_get i) (const_i32 1)))))
      (call_void free (local_get buf))
      (return (local_get sum))))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 worker (const_i32 5))))))
