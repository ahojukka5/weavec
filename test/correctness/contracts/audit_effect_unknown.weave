; audit_effect_unknown.weave — unknown external callee makes declared effects unknown

(program
  (name "audit_effect_unknown")
  (version "0.1")
  (extern external-solver (params (x i32)) (returns i32))
  (entry main)
  (fn wrapper
    (params (x i32))
    (returns i32)
    (pure)
    (no_alloc)
    (deterministic)
    (do
      (return (call_i32 external-solver x))))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 wrapper (const_i32 1))))))
