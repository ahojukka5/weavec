; audit_effect_malloc_fail.weave — (no_alloc) violated by malloc

(program
  (name "audit_effect_malloc_fail")
  (version "0.1")
  (extern malloc (params (size i64)) (returns ptr))
  (entry main)
  (fn make-buffer
    (params (n i64))
    (returns ptr)
    (no_alloc)
    (pure)
    (do
      (return (call_ptr malloc n))))
  (fn main
    (params)
    (returns i32)
    (do
      (let slot ptr (call_ptr make-buffer (const_i64 8)))
      (return (const_i32 42)))))
