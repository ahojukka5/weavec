; 67_contract_pure_ok.weave
; purpose: (pure) marker on a function with no allocation or runtime calls.
; expected runtime behavior: exit 42.

(program
  (name "contract_pure_ok")
  (version "0.1")
  (entry main)
  (fn add-pure
    (params (x i32) (y i32))
    (returns i32)
    (pure)
    (do
      (return (add_i32 x y))))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 add-pure (const_i32 20) (const_i32 22))))))
