; 72_contract_no_alloc_indirect_fail.weave
; purpose: (no_alloc) violated by transitive call to allocating helper.

(program
  (name "contract_no_alloc_indirect_fail")
  (version "0.1")
  (extern malloc (params (size i64)) (returns ptr))
  (entry main)
  (fn allocates-helper
    (params)
    (returns i32)
    (do
      (let slot ptr (call_ptr malloc (const_i64 8)))
      (return (const_i32 0))))
  (fn no-alloc-wrapper
    (params)
    (returns i32)
    (no_alloc)
    (do
      (return (call_i32 allocates-helper))))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 no-alloc-wrapper)))))
