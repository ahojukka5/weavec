; 64_contract_ensures_multi_return.weave
; purpose: ensures checked at every return site.
; expected runtime behavior: exit 10 (clamp 12 to [0,10]).

(program
  (name "contract_ensures_multi_return")
  (version "0.1")
  (entry main)
  (fn clamp
    (params (x i32) (lo i32) (hi i32))
    (returns i32)
    (requires (le_i32 lo hi))
    (ensures (ge_i32 result lo))
    (ensures (le_i32 result hi))
    (do
      (if
        (condition (lt_i32 x lo))
        (then (do (return lo)))
        (else (do)))
      (if
        (condition (gt_i32 x hi))
        (then (do (return hi)))
        (else (do)))
      (return x)))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 clamp (const_i32 12) (const_i32 0) (const_i32 10))))))
