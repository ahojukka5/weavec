; 70_contract_no_alloc_fail.weave
; purpose: (no_alloc) violated by malloc; frontend must reject at compile time.

(program
  (name "contract_no_alloc_fail")
  (version "0.1")
  (extern malloc (params (size i64)) (returns ptr))
  (entry main)
  (fn allocates
    (params)
    (returns i32)
    (no_alloc)
    (do
      (let slot ptr (call_ptr malloc (const_i64 8)))
      (return (const_i32 42))))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 allocates)))))
