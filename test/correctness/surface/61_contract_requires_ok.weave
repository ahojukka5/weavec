; 61_contract_requires_ok.weave
; purpose: requires clause passes at function entry.
; expected runtime behavior: exit 42.

(program
  (name "contract_requires_ok")
  (version "0.1")
  (entry main)
  (fn bounded
    (params (x i32))
    (returns i32)
    (requires (ge_i32 x (const_i32 0)))
    (do
      (return x)))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 bounded (const_i32 42))))))
