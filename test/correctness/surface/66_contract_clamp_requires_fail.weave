; 66_contract_clamp_requires_fail.weave
; purpose: requires fails when lo > hi.
; expected runtime behavior: exit 1 (contract failure).

(program
  (name "contract_clamp_requires_fail")
  (version "0.1")
  (entry main)
  (fn clamp
    (params (x i32) (lo i32) (hi i32))
    (returns i32)
    (requires (le_i32 lo hi))
    (ensures (ge_i32 result lo))
    (ensures (le_i32 result hi))
    (do
      (return x)))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 clamp (const_i32 5) (const_i32 10) (const_i32 0))))))
