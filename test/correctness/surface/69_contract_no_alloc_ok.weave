; 69_contract_no_alloc_ok.weave
; purpose: (no_alloc) marker on a function with no heap allocation.
; expected runtime behavior: exit 42.

(program
  (name "contract_no_alloc_ok")
  (version "0.1")
  (entry main)
  (fn scale
    (params (x i32))
    (returns i32)
    (no_alloc)
    (do
      (return (mul_i32 x (const_i32 2)))))
  (fn main
    (params)
    (returns i32)
    (do
      (return (call_i32 scale (const_i32 21))))))
