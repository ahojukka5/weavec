; SPDX-License-Identifier: Apache-2.0
; Qualification for structural module-envelope and ordinary-decl WIR builders.

(program
  (name "surface_decl_tree_envelope")
  (version "0.1")

  (fn sdte_equals
    (params (sdte_tree ptr) (sdte_root i64) (sdte_expected ptr))
    (returns i32)
    (do
      (let sdte_buffer ptr (call_ptr wir_buffer_new))
      (if
        (condition (eq_ptr (local_get sdte_buffer) (const_null)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32
          (call_i32 wir_serialize_into
            (local_get sdte_buffer) (param_get sdte_tree) (param_get sdte_root))
          (const_i32 0)))
        (then (do
          (call_void wir_buffer_free (local_get sdte_buffer))
          (return (const_i32 0))))
        (else (do)))
      (let sdte_len i64 (call_i64 wir_buffer_length (local_get sdte_buffer)))
      (let sdte_expected_len i64 (call_i64 strlen (param_get sdte_expected)))
      (if
        (condition (ne_i64 (local_get sdte_len) (local_get sdte_expected_len)))
        (then (do
          (call_void wir_buffer_free (local_get sdte_buffer))
          (return (const_i32 0))))
        (else (do)))
      (let sdte_data ptr (call_ptr wir_buffer_data (local_get sdte_buffer)))
      (let sdte_i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get sdte_i) (local_get sdte_len)))
        (do
          (if
            (condition (ne_i32
              (load_u8 (ptr_add (local_get sdte_data) (local_get sdte_i)))
              (load_u8 (ptr_add (param_get sdte_expected) (local_get sdte_i)))))
            (then (do
              (call_void wir_buffer_free (local_get sdte_buffer))
              (return (const_i32 0))))
            (else (do)))
          (set sdte_i (add_i64 (local_get sdte_i) (const_i64 1)))))
      (call_void wir_buffer_free (local_get sdte_buffer))
      (return (const_i32 1))))

  (fn main
    (params)
    (returns i32)
    (do
      (let tree ptr (call_ptr wir_tree_new))
      (if
        (condition (eq_ptr (local_get tree) (const_null)))
        (then (do (return (const_i32 1))))
        (else (do)))

      (let version i64 (call_i64 wir_decl_core_version (local_get tree)))
      (let decls i64 (call_i64 wir_decl_decls (local_get tree)))
      (let envelope i64 (call_i64 wir_decl_core_module
        (local_get tree) (local_get version) (local_get decls)))
      (if
        (condition (eq_i32 (call_i32 sdte_equals
          (local_get tree) (local_get envelope)
          (const_string_ptr "(core-module (core-version 3) (decls))"))
          (const_i32 0)))
        (then (do (return (const_i32 2))))
        (else (do)))

      (let abort_name i64 (call_i64 wir_decl_atom
        (local_get tree) (const_string_ptr "abort")))
      (let abort_params i64 (call_i64 wir_decl_params (local_get tree)))
      (let abort_ret_type i64 (call_i64 wir_decl_atom
        (local_get tree) (const_string_ptr "void")))
      (let abort_returns i64 (call_i64 wir_decl_returns
        (local_get tree) (local_get abort_ret_type)))
      (let abort_decl i64 (call_i64 wir_decl_extern
        (local_get tree) (local_get abort_name)
        (local_get abort_params) (local_get abort_returns)))
      (if
        (condition (eq_i32 (call_i32 sdte_equals
          (local_get tree) (local_get abort_decl)
          (const_string_ptr "(extern abort (params) (returns void))"))
          (const_i32 0)))
        (then (do (return (const_i32 3))))
        (else (do)))

      (let fn_name i64 (call_i64 wir_decl_atom
        (local_get tree) (const_string_ptr "main")))
      (let fn_params i64 (call_i64 wir_decl_params (local_get tree)))
      (let fn_ret_type i64 (call_i64 wir_decl_atom
        (local_get tree) (const_string_ptr "i32")))
      (let fn_returns i64 (call_i64 wir_decl_returns
        (local_get tree) (local_get fn_ret_type)))
      (let fn_value i64 (call_i64 wir_scalar_const_i32
        (local_get tree) (const_i64 42)))
      (let fn_ret i64 (call_i64 wir_stmt_return
        (local_get tree) (local_get fn_value)))
      (let fn_body i64 (call_i64 wir_decl_do (local_get tree)))
      (if
        (condition (eq_i32 (call_i32 wir_decl_append
          (local_get tree) (local_get fn_body) (local_get fn_ret))
          (const_i32 0)))
        (then (do (return (const_i32 4))))
        (else (do)))
      (let fn_decl i64 (call_i64 wir_decl_fn
        (local_get tree) (local_get fn_name) (local_get fn_params)
        (local_get fn_returns) (local_get fn_body)))
      (if
        (condition (eq_i32 (call_i32 sdte_equals
          (local_get tree) (local_get fn_decl)
          (const_string_ptr "(fn main (params) (returns i32) (do (return (const_i32 42))))"))
          (const_i32 0)))
        (then (do (return (const_i32 5))))
        (else (do)))

      (let failed i64 (call_i64 wir_decl_fn
        (local_get tree) (const_i64 -1) (local_get fn_params)
        (local_get fn_returns) (local_get fn_body)))
      (if
        (condition (ge_i64 (local_get failed) (const_i64 0)))
        (then (do (return (const_i32 6))))
        (else (do)))

      (call_void wir_tree_free (local_get tree))
      (return (const_i32 0))))
)
