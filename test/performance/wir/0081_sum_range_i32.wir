; Performance: 0081_sum_range_i32
; tags = algorithm, i32, loop, loop-promotion
; Why hard: Sum 1..n (triangular number). Simple but canonical loop-carried
;   accumulator.
; Reveals: while, add_i32 on sum, i32 index.
; Expected: Golden LLVM matches
;   test/performance/expected-llvm/0081_sum_range_i32.ll.
;   llvm-as accepts emitted IR; opt -passes=mem2reg is an optional extra check.
; If LLVM regresses: Broken loop header phis or missing .merge blocks: carried
;   locals reload from
;   stack every iteration, wrong backedge operands, or SSA violations after
;   llvm-as.
(core-module
  (core-version 3)
  (decls
    (fn sum_range
      (params
        (n i32)
      ) ;; params
      (returns i32)
      (do
        (let i i32
          (const_i32 1)
        ) ;; let

        (let total i32
          (const_i32 0)
        ) ;; let

        (while
          (condition
            (le_i32
              (local_get i)
              (param_get n)
            ) ;; le_i32
          ) ;; condition
          (do
            (set total
              (add_i32
                (local_get total)
                (local_get i)
              ) ;; add_i32
            ) ;; set

            (set i
              (add_i32
                (local_get i)
                (const_i32 1)
              ) ;; add_i32
            ) ;; set
          ) ;; do
        ) ;; while

        (return
          (local_get total)
        ) ;; return
      ) ;; do
    ) ;; fn

    (fn main
      (params)
      (returns i32)
      (do
        (return
          (call_i32 sum_range
            (const_i32 15)
          ) ;; call_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
