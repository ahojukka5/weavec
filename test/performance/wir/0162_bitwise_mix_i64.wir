; Performance: 0162_bitwise_mix_i64
; tags = bitwise, i64, stress
; Why hard: i64 xor/and/shl/shr mix in 64-step loop.
; Reveals: bitwise i64 ops chained per iteration.
; Expected: Golden LLVM matches
;   test/performance/expected-llvm/0162_bitwise_mix_i64.ll.
;   llvm-as accepts emitted IR; opt -passes=mem2reg is an optional extra check.
; If LLVM regresses: Shr uses shl; and mask wrong width; xor optimized away
;   incorrectly.
(core-module
  (core-version 2)
  (decls
    (fn mix64
      (params
        (seed i64)
      ) ;; params
      (returns i64)
      (do
        (let x i64
          (param_get seed)
        ) ;; let

        (let i i32
          (const_i32 0)
        ) ;; let

        (while
          (condition
            (lt_i32
              (local_get i)
              (const_i32 64)
            ) ;; lt_i32
          ) ;; condition
          (do
            (set x
              (xor_i64
                (shl_i64
                  (and_i64
                    (local_get x)
                    (const_i64 255)
                  ) ;; and_i64
                  (const_i64 3)
                ) ;; shl_i64
                (shr_i64
                  (local_get x)
                  (const_i64 5)
                ) ;; shr_i64
              ) ;; xor_i64
            ) ;; set

            (set i
              (add_i32
                (local_get i)
                (const_i32 1)
              ) ;; add_i32
            ) ;; set
          ) ;; do
        ) ;; while

        (return
          (local_get x)
        ) ;; return
      ) ;; do
    ) ;; fn

    (fn main
      (params)
      (returns i32)
      (do
        (return
          (cast_i64_to_i32
            (mod_i64
              (call_i64 mix64
                (const_i64 0x123456789ABCDEF0)
              ) ;; call_i64
              (const_i64 1000000007)
            ) ;; mod_i64
          ) ;; cast_i64_to_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
