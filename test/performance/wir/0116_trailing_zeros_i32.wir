; Performance: 0116_trailing_zeros_i32
; tags = algorithm, bitwise, i32
; Why hard: Count trailing zeros. Tight div/mod 2 loop like popcount.
; Reveals: mod 2, div 2, increment count.
; Expected: Golden LLVM matches
;   test/performance/expected-llvm/0116_trailing_zeros_i32.ll. llvm-as accepts
;   emitted IR; opt -passes=mem2reg is an optional extra check.
; If LLVM regresses: Counts leading not trailing; extra urem per step.
(core-module
  (core-version 3)
  (decls
    (fn trailing_zeros
      (params
        (v i32)
      ) ;; params
      (returns i32)
      (do
        (let n i32
          (param_get v)
        ) ;; let

        (let count i32
          (const_i32 0)
        ) ;; let

        (while
          (condition
            (and_bool
              (gt_i32
                (local_get n)
                (const_i32 0)
              ) ;; gt_i32
              (eq_i32
                (mod_i32
                  (local_get n)
                  (const_i32 2)
                ) ;; mod_i32
                (const_i32 0)
              ) ;; eq_i32
            ) ;; and_bool
          ) ;; condition
          (do
            (set count
              (add_i32
                (local_get count)
                (const_i32 1)
              ) ;; add_i32
            ) ;; set

            (set n
              (div_i32
                (local_get n)
                (const_i32 2)
              ) ;; div_i32
            ) ;; set
          ) ;; do
        ) ;; while

        (return
          (local_get count)
        ) ;; return
      ) ;; do
    ) ;; fn

    (fn main
      (params)
      (returns i32)
      (do
        (return
          (call_i32 trailing_zeros
            (const_i32 96)
          ) ;; call_i32
        ) ;; return
      ) ;; do
    ) ;; fn
  ) ;; decls
) ;; core-module
