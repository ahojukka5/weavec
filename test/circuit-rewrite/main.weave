; SPDX-License-Identifier: Apache-2.0
; Circuit IR and generic local rewrite engine (#457).
; Ordinary Weave only: no rewrite syntax, no WIR extension.

(program
  (name "circuit-rewrite")
  (version "0.1")

  ; Gate kinds. Self-inverse: H X Y Z CNOT CZ SWAP CCNOT.
  ; Parameterized: RX RY RZ. Identity: I.
  ; Angle unit is 1/8 of a turn, so 8 ticks = 2pi.

  (struct RewriteMatch
    (field rule i32)
    (field start i32)
    (field span i32)
    (field extra i32))

  (fn seq_get
    (params (seq (type-app Vec i32)) (index i32))
    (returns i32)
    (do
      (return (call option_unwrap_or (type-args i32)
        (call vec_get (type-args i32) seq index)
        99))))

  (fn stride_index
    (params (gate i32))
    (returns i32)
    (do
      (let acc i32 0)
      (let k i32 0)
      (while
        (condition (op less-than k gate))
        (do
          (set acc (op add acc 5))
          (set k (op add k 1))))
      (return acc)))

  (fn circ_n
    (params (data (type-app Vec i32)))
    (returns i32)
    (do
      (let rest i32 (call vec_len (type-args i32) data))
      (let n i32 0)
      (while
        (condition (op greater-or-equal rest 5))
        (do
          (set n (op add n 1))
          (set rest (op sub rest 5))))
      (return n)))

  (fn circ_kind
    (params (data (type-app Vec i32)) (gate i32))
    (returns i32)
    (do
      (return (call seq_get data (call stride_index gate)))))

  (fn circ_q0
    (params (data (type-app Vec i32)) (gate i32))
    (returns i32)
    (do
      (return (call seq_get data (op add (call stride_index gate) 1)))))

  (fn circ_q1
    (params (data (type-app Vec i32)) (gate i32))
    (returns i32)
    (do
      (return (call seq_get data (op add (call stride_index gate) 2)))))

  (fn circ_q2
    (params (data (type-app Vec i32)) (gate i32))
    (returns i32)
    (do
      (return (call seq_get data (op add (call stride_index gate) 3)))))

  (fn circ_param
    (params (data (type-app Vec i32)) (gate i32))
    (returns i32)
    (do
      (return (call seq_get data (op add (call stride_index gate) 4)))))

  (fn circ_push
    (params
      (data (type-app Vec i32))
      (kind i32)
      (q0 i32)
      (q1 i32)
      (q2 i32)
      (param i32))
    (returns (type-app Vec i32))
    (do
      (let acc (call vec_push (type-args i32) data kind))
      (set acc (call vec_push (type-args i32) acc q0))
      (set acc (call vec_push (type-args i32) acc q1))
      (set acc (call vec_push (type-args i32) acc q2))
      (set acc (call vec_push (type-args i32) acc param))
      (return acc)))

  (fn circ_push_gate
    (params (dst (type-app Vec i32)) (src (type-app Vec i32)) (gate i32))
    (returns (type-app Vec i32))
    (do
      (return (call circ_push dst
        (call circ_kind src gate)
        (call circ_q0 src gate)
        (call circ_q1 src gate)
        (call circ_q2 src gate)
        (call circ_param src gate)))))

  (fn circ_equal
    (params (left (type-app Vec i32)) (right (type-app Vec i32)))
    (returns bool)
    (do
      (let ln i32 (call vec_len (type-args i32) left))
      (let rn i32 (call vec_len (type-args i32) right))
      (if
        (condition (op not-equal ln rn))
        (then (do (return false)))
        (else (do)))
      (let i i32 0)
      (while
        (condition (op less-than i ln))
        (do
          (if
            (condition (op not-equal (call seq_get left i) (call seq_get right i)))
            (then (do (return false)))
            (else (do)))
          (set i (op add i 1))))
      (return true)))

  ; Self-inverse table. The matcher calls this; it does not branch on H.
  (fn gate_is_self_inverse
    (params (kind i32))
    (returns bool)
    (do
      (if
        (condition (op less-than kind 1))
        (then (do (return false)))
        (else (do)))
      (return (op less-or-equal kind 8))))

  (fn gate_is_rotation
    (params (kind i32))
    (returns bool)
    (do
      (return (op and
        (op greater-or-equal kind 9)
        (op less-or-equal kind 11)))))

  (fn gate_is_identity
    (params (kind i32) (param i32))
    (returns bool)
    (do
      (if
        (condition (op equal kind 0))
        (then (do (return true)))
        (else (do)))
      (return (op and
        (call gate_is_rotation kind)
        (op equal param 0)))))

  (fn same_qubits
    (params (data (type-app Vec i32)) (a i32) (b i32))
    (returns bool)
    (do
      (return (op and
        (op equal (call circ_q0 data a) (call circ_q0 data b))
        (op and
          (op equal (call circ_q1 data a) (call circ_q1 data b))
          (op equal (call circ_q2 data a) (call circ_q2 data b)))))))

  ; --- generic-arm ---
  (fn match_none
    (params)
    (returns RewriteMatch)
    (do
      (return (new RewriteMatch
        (rule 0)
        (start 0)
        (span 0)
        (extra 0)))))

  (fn match_better_i
    (params
      (br i32) (bs i32) (bp i32) (be i32)
      (cr i32) (cs i32) (cp i32) (ce i32))
    (returns bool)
    (do
      (if
        (condition (op equal cr 0))
        (then (do (return false)))
        (else (do)))
      (if
        (condition (op equal br 0))
        (then (do (return true)))
        (else (do)))
      (if
        (condition (op less-than cs bs))
        (then (do (return true)))
        (else (do)))
      (if
        (condition (op greater-than cs bs))
        (then (do (return false)))
        (else (do)))
      (if
        (condition (op greater-than cp bp))
        (then (do (return true)))
        (else (do)))
      (if
        (condition (op less-than cp bp))
        (then (do (return false)))
        (else (do)))
      (if
        (condition (op less-than cr br))
        (then (do (return true)))
        (else (do)))
      (if
        (condition (op greater-than cr br))
        (then (do (return false)))
        (else (do)))
      (return (op less-than ce be))))

  ; Rule 1: adjacent equal self-inverse gates on the same qubits cancel.
  (fn rule_cancel_pair
    (params (data (type-app Vec i32)) (start i32))
    (returns bool)
    (do
      (let n i32 (call circ_n data))
      (if
        (condition (op greater-or-equal (op add start 1) n))
        (then (do (return false)))
        (else (do)))
      (let kind i32 (call circ_kind data start))
      (if
        (condition (op not (call gate_is_self_inverse kind)))
        (then (do (return false)))
        (else (do)))
      (if
        (condition (op not-equal kind (call circ_kind data (op add start 1))))
        (then (do (return false)))
        (else (do)))
      (return (call same_qubits data start (op add start 1)))))

  ; Rule 2: drop identity, including a rotation whose angle is 0 ticks.
  (fn rule_drop_identity
    (params (data (type-app Vec i32)) (start i32))
    (returns bool)
    (do
      (return (call gate_is_identity
        (call circ_kind data start)
        (call circ_param data start)))))

  ; Rule 3: fuse adjacent same-axis rotations on one qubit.
  (fn rule_fuse_rotation
    (params (data (type-app Vec i32)) (start i32))
    (returns bool)
    (do
      (let n i32 (call circ_n data))
      (if
        (condition (op greater-or-equal (op add start 1) n))
        (then (do (return false)))
        (else (do)))
      (let kind i32 (call circ_kind data start))
      (if
        (condition (op not (call gate_is_rotation kind)))
        (then (do (return false)))
        (else (do)))
      (if
        (condition (op not-equal kind (call circ_kind data (op add start 1))))
        (then (do (return false)))
        (else (do)))
      (return (call same_qubits data start (op add start 1)))))

  (fn circ_find_match
    (params (data (type-app Vec i32)))
    (returns RewriteMatch)
    (do
      (let br i32 0)
      (let bs i32 0)
      (let bp i32 0)
      (let be i32 0)
      (let n i32 (call circ_n data))
      (let i i32 0)
      (while
        (condition (op less-than i n))
        (do
          (if
            (condition (call rule_cancel_pair data i))
            (then (do
              (if
                (condition (call match_better_i br bs bp be 1 i 2 0))
                (then (do
                  (set br 1)
                  (set bs i)
                  (set bp 2)
                  (set be 0)))
                (else (do)))))
            (else (do)))
          (if
            (condition (call rule_drop_identity data i))
            (then (do
              (if
                (condition (call match_better_i br bs bp be 2 i 1 0))
                (then (do
                  (set br 2)
                  (set bs i)
                  (set bp 1)
                  (set be 0)))
                (else (do)))))
            (else (do)))
          (if
            (condition (call rule_fuse_rotation data i))
            (then (do
              (let extra i32 (op add
                (call circ_param data i)
                (call circ_param data (op add i 1))))
              (if
                (condition (call match_better_i br bs bp be 3 i 2 extra))
                (then (do
                  (set br 3)
                  (set bs i)
                  (set bp 2)
                  (set be extra)))
                (else (do)))))
            (else (do)))
          (set i (op add i 1))))
      (if
        (condition (op equal br 0))
        (then (do (return (call match_none))))
        (else (do)))
      (return (new RewriteMatch
        (rule br)
        (start bs)
        (span bp)
        (extra be)))))

  (fn circ_apply
    (params (data (type-app Vec i32)) (m RewriteMatch))
    (returns (type-app Vec i32))
    (do
      (let out (call vec_new (type-args i32)))
      (let n i32 (call circ_n data))
      (let start i32 (field-get m start))
      (let end i32 (op add start (field-get m span)))
      (let i i32 0)
      (while
        (condition (op less-than i n))
        (do
          (if
            (condition (op and
              (op greater-or-equal i start)
              (op less-than i end)))
            (then (do))
            (else (do
              (set out (call circ_push_gate out data i)))))
          (if
            (condition (op and
              (op equal (field-get m rule) 3)
              (op equal i start)))
            (then (do
              (set out (call circ_push out
                (call circ_kind data start)
                (call circ_q0 data start)
                (call circ_q1 data start)
                (call circ_q2 data start)
                (field-get m extra)))))
            (else (do)))
          (set i (op add i 1))))
      (return out)))

  (fn circ_rewrite
    (params (data (type-app Vec i32)) (bound i32))
    (returns (type-app Vec i32))
    (do
      (let cur (type-app Vec i32) data)
      (let owned i32 0)
      (let step i32 0)
      (while
        (condition (op less-than step bound))
        (do
          (let m RewriteMatch (call circ_find_match cur))
          (if
            (condition (op equal (field-get m rule) 0))
            (then (do (return cur)))
            (else (do)))
          (let nxt (call circ_apply cur m))
          (if
            (condition (op equal owned 1))
            (then (do (call vec_release (type-args i32) cur)))
            (else (do)))
          (set cur nxt)
          (set owned 1)
          (set step (op add step 1))))
      (return cur)))

  ; --- special-arm ---
  ; Special-case linear scan for the same three local rules: drop I,
  ; fuse adjacent same-axis rotations, cancel adjacent self-inverses.
  (fn circ_special_scan
    (params (data (type-app Vec i32)))
    (returns (type-app Vec i32))
    (do
      (let out (call vec_new (type-args i32)))
      (let n i32 (call circ_n data))
      (let has i32 0)
      (let pk i32 0)
      (let pq0 i32 0)
      (let pq1 i32 0)
      (let pq2 i32 0)
      (let pp i32 0)
      (let i i32 0)
      (while
        (condition (op less-than i n))
        (do
          (let kind i32 (call circ_kind data i))
          (let q0 i32 (call circ_q0 data i))
          (let q1 i32 (call circ_q1 data i))
          (let q2 i32 (call circ_q2 data i))
          (let param i32 (call circ_param data i))
          (if
            (condition (call gate_is_identity kind param))
            (then (do))
            (else (do
              (let combined i32 0)
              (if
                (condition (op equal has 1))
                (then (do
                  (if
                    (condition (op and
                      (call gate_is_rotation pk)
                      (op and
                        (op equal pk kind)
                        (op and
                          (op equal pq0 q0)
                          (op and
                            (op equal pq1 q1)
                            (op equal pq2 q2))))))
                    (then (do
                      (let fused i32 (op add pp param))
                      (set combined 1)
                      (if
                        (condition (op equal fused 0))
                        (then (do (set has 0)))
                        (else (do (set pp fused))))))
                    (else (do)))
                  (if
                    (condition (op and
                      (op equal combined 0)
                      (op and
                        (call gate_is_self_inverse pk)
                        (op and
                          (op equal pk kind)
                          (op and
                            (op equal pq0 q0)
                            (op and
                              (op equal pq1 q1)
                              (op equal pq2 q2)))))))
                    (then (do
                      (set combined 1)
                      (set has 0)))
                    (else (do)))))
                (else (do)))
              (if
                (condition (op equal combined 0))
                (then (do
                  (if
                    (condition (op equal has 1))
                    (then (do
                      (set out (call circ_push out pk pq0 pq1 pq2 pp))))
                    (else (do)))
                  (set has 1)
                  (set pk kind)
                  (set pq0 q0)
                  (set pq1 q1)
                  (set pq2 q2)
                  (set pp param)))
                (else (do))))))
          (set i (op add i 1))))
      (if
        (condition (op equal has 1))
        (then (do
          (set out (call circ_push out pk pq0 pq1 pq2 pp))))
        (else (do)))
      (return out)))

  (fn circ_special
    (params (data (type-app Vec i32)) (bound i32))
    (returns (type-app Vec i32))
    (do
      (let cur (type-app Vec i32) data)
      (let owned i32 0)
      (let step i32 0)
      (while
        (condition (op less-than step bound))
        (do
          (let nxt (call circ_special_scan cur))
          (if
            (condition (call circ_equal nxt cur))
            (then (do
              (call vec_release (type-args i32) nxt)
              (return cur)))
            (else (do)))
          (if
            (condition (op equal owned 1))
            (then (do (call vec_release (type-args i32) cur)))
            (else (do)))
          (set cur nxt)
          (set owned 1)
          (set step (op add step 1))))
      (return cur)))

  ; --- driver ---
  (fn circ_print
    (params (data (type-app Vec i32)))
    (returns void)
    (do
      (let n i32 (call circ_n data))
      (if
        (condition (op equal n 0))
        (then (do
          (call write_stdout "empty\n")
          (return_void)))
        (else (do)))
      (let i i32 0)
      (while
        (condition (op less-than i n))
        (do
          (if
            (condition (op greater-than i 0))
            (then (do (call write_stdout " ")))
            (else (do)))
          (call write_u32_decimal (call circ_kind data i))
          (set i (op add i 1))))
      (call write_stdout "\n")
      (return_void)))

  (fn circ_append
    (params (dst (type-app Vec i32)) (src (type-app Vec i32)))
    (returns (type-app Vec i32))
    (do
      (let n i32 (call circ_n src))
      (let i i32 0)
      (let acc (type-app Vec i32) dst)
      (while
        (condition (op less-than i n))
        (do
          (set acc (call circ_push_gate acc src i))
          (set i (op add i 1))))
      (return acc)))

  (fn bench_block
    (params)
    (returns (type-app Vec i32))
    (do
      (let b (call vec_new (type-args i32)))
      (set b (call circ_push b 1 0 -1 -1 0))
      (set b (call circ_push b 1 0 -1 -1 0))
      (set b (call circ_push b 0 0 -1 -1 0))
      (set b (call circ_push b 2 0 -1 -1 0))
      (set b (call circ_push b 2 0 -1 -1 0))
      (set b (call circ_push b 11 0 -1 -1 1))
      (set b (call circ_push b 11 0 -1 -1 2))
      (set b (call circ_push b 11 0 -1 -1 -3))
      (set b (call circ_push b 5 0 1 -1 0))
      (set b (call circ_push b 5 0 1 -1 0))
      (return b)))

  (fn bench_circuit
    (params (blocks i32))
    (returns (type-app Vec i32))
    (do
      (let out (call vec_new (type-args i32)))
      (let block (call bench_block))
      (let i i32 0)
      (while
        (condition (op less-than i blocks))
        (do
          (set out (call circ_append out block))
          (set i (op add i 1))))
      (return out)))

  (fn fail_if_unequal
    (params (left (type-app Vec i32)) (right (type-app Vec i32)) (code i32))
    (returns i32)
    (do
      (if
        (condition (op not (call circ_equal left right)))
        (then (do (return code)))
        (else (do (return 0))))))

  (fn run_check
    (params)
    (returns i32)
    (do
      (let c1 (call vec_new (type-args i32)))
      (set c1 (call circ_push c1 1 0 -1 -1 0))
      (set c1 (call circ_push c1 1 0 -1 -1 0))
      (let s1 (call circ_special c1 32))
      (let g1 (call circ_rewrite c1 32))
      (let e i32 (call fail_if_unequal s1 g1 1))
      (if
        (condition (op not-equal e 0))
        (then (do (return e)))
        (else (do)))
      (if
        (condition (op not-equal (call circ_n g1) 0))
        (then (do (return 2)))
        (else (do)))

      (let c2 (call vec_new (type-args i32)))
      (set c2 (call circ_push c2 2 0 -1 -1 0))
      (set c2 (call circ_push c2 2 1 -1 -1 0))
      (let s2 (call circ_special c2 32))
      (let g2 (call circ_rewrite c2 32))
      (set e (call fail_if_unequal s2 g2 3))
      (if
        (condition (op not-equal e 0))
        (then (do (return e)))
        (else (do)))
      (if
        (condition (op not-equal (call circ_n g2) 2))
        (then (do (return 4)))
        (else (do)))

      (let c3 (call vec_new (type-args i32)))
      (set c3 (call circ_push c3 5 0 1 -1 0))
      (set c3 (call circ_push c3 5 0 1 -1 0))
      (let s3 (call circ_special c3 32))
      (let g3 (call circ_rewrite c3 32))
      (set e (call fail_if_unequal s3 g3 5))
      (if
        (condition (op not-equal e 0))
        (then (do (return e)))
        (else (do)))
      (if
        (condition (op not-equal (call circ_n g3) 0))
        (then (do (return 6)))
        (else (do)))

      (let c4 (call vec_new (type-args i32)))
      (set c4 (call circ_push c4 1 0 -1 -1 0))
      (set c4 (call circ_push c4 0 0 -1 -1 0))
      (set c4 (call circ_push c4 1 0 -1 -1 0))
      (let s4 (call circ_special c4 32))
      (let g4 (call circ_rewrite c4 32))
      (set e (call fail_if_unequal s4 g4 7))
      (if
        (condition (op not-equal e 0))
        (then (do (return e)))
        (else (do)))
      (if
        (condition (op not-equal (call circ_n g4) 0))
        (then (do (return 8)))
        (else (do)))

      (let c5 (call vec_new (type-args i32)))
      (set c5 (call circ_push c5 11 0 -1 -1 2))
      (set c5 (call circ_push c5 11 0 -1 -1 3))
      (let s5 (call circ_special c5 32))
      (let g5 (call circ_rewrite c5 32))
      (set e (call fail_if_unequal s5 g5 9))
      (if
        (condition (op not-equal e 0))
        (then (do (return e)))
        (else (do)))
      (if
        (condition (op not-equal (call circ_n g5) 1))
        (then (do (return 10)))
        (else (do)))
      (if
        (condition (op not-equal (call circ_param g5 0) 5))
        (then (do (return 11)))
        (else (do)))

      (let c6 (call vec_new (type-args i32)))
      (set c6 (call circ_push c6 11 0 -1 -1 3))
      (set c6 (call circ_push c6 11 0 -1 -1 -3))
      (let g6a (call circ_rewrite c6 32))
      (let g6b (call circ_rewrite c6 32))
      (let s6 (call circ_special c6 32))
      (set e (call fail_if_unequal g6a g6b 12))
      (if
        (condition (op not-equal e 0))
        (then (do (return e)))
        (else (do)))
      (set e (call fail_if_unequal g6a s6 13))
      (if
        (condition (op not-equal e 0))
        (then (do (return e)))
        (else (do)))
      (if
        (condition (op not-equal (call circ_n g6a) 0))
        (then (do (return 14)))
        (else (do)))

      (let big (call bench_circuit 8))
      (let sb (call circ_special big 4096))
      (let gb (call circ_rewrite big 4096))
      (set e (call fail_if_unequal sb gb 15))
      (if
        (condition (op not-equal e 0))
        (then (do (return e)))
        (else (do)))
      (if
        (condition (op not-equal (call circ_n gb) 0))
        (then (do (return 16)))
        (else (do)))

      (call write_stdout "hh empty\n")
      (call write_stdout "xx-diff 2\n")
      (call write_stdout "cnot empty\n")
      (call write_stdout "h-i-h empty\n")
      (call write_stdout "rz-fuse 1\n")
      (call write_stdout "repeat ok\n")
      (call write_stdout "bench-block empty\n")
      (return 0)))

  (fn run_bench
    (params (arm i32) (blocks i32) (reps i32))
    (returns i32)
    (do
      (let src (call bench_circuit blocks))
      (let r i32 0)
      (let last (call vec_new (type-args i32)))
      (let have i32 0)
      (while
        (condition (op less-than r reps))
        (do
          (if
            (condition (op equal have 1))
            (then (do (call vec_release (type-args i32) last)))
            (else (do)))
          (if
            (condition (op equal arm 1))
            (then (do (set last (call circ_rewrite src 4096))))
            (else (do (set last (call circ_special src 4096)))))
          (set have 1)
          (set r (op add r 1))))
      (if
        (condition (op not-equal (call circ_n last) 0))
        (then (do (return 20)))
        (else (do)))
      (call write_stdout "bench ok\n")
      (return 0)))

  (fn program_main
    (params)
    (returns i32)
    (do
      (if
        (condition (op equal (call args_count) 0))
        (then (do (return (call run_check))))
        (else (do)))
      (if
        (condition (op less-than (call args_count) 3))
        (then (do (return 21)))
        (else (do)))
      (if
        (condition (op not (call parse_f64_valid (call arg 0))))
        (then (do (return 22)))
        (else (do)))
      (if
        (condition (op not (call parse_f64_valid (call arg 1))))
        (then (do (return 23)))
        (else (do)))
      (if
        (condition (op not (call parse_f64_valid (call arg 2))))
        (then (do (return 24)))
        (else (do)))
      (let arm i32 (cast i32 (call parse_f64 (call arg 0))))
      (let blocks i32 (cast i32 (call parse_f64 (call arg 1))))
      (let reps i32 (cast i32 (call parse_f64 (call arg 2))))
      (if
        (condition (op or
          (op less-than arm 1)
          (op greater-than arm 2)))
        (then (do (return 25)))
        (else (do)))
      (if
        (condition (op or
          (op less-than blocks 1)
          (op less-than reps 1)))
        (then (do (return 26)))
        (else (do)))
      (return (call run_bench arm blocks reps)))))
