; Generic Vec over the current standard library. An out-of-range get is None
; and an out-of-range set is refused, so neither aborts the program.
(program
  (name "vec-and-option-bounds")
  (version "0.1")

  (entry main () i32
    (let numbers (type-app Vec i32) (vec_new (type-args i32)))
    (vec_push (type-args i32) numbers 10)
    (vec_push (type-args i32) numbers 20)
    (vec_push (type-args i32) numbers 30)
    (write_stdout "len=")
    (write_u32_decimal (vec_len (type-args i32) numbers))
    (let first (type-app Option i32) (vec_get (type-args i32) numbers 0))
    (write_stdout "\nfirst=")
    (write_u32_decimal (option_unwrap_or (type-args i32) first 0))
    (let missing (type-app Option i32) (vec_get (type-args i32) numbers 99))
    (write_stdout "\nmissing-is-some=")
    (let present bool (option_is_some (type-args i32) missing))
    (when (not present) (write_stdout "false"))
    (let accepted bool (vec_set (type-args i32) numbers 1 21))
    (let refused bool (vec_set (type-args i32) numbers 99 0))
    (write_stdout "\naccepted=")
    (when accepted (write_stdout "true"))
    (write_stdout "\nrefused=")
    (when (not refused) (write_stdout "false"))
    (let updated (type-app Option i32) (vec_get (type-args i32) numbers 1))
    (write_stdout "\nupdated=")
    (write_u32_decimal (option_unwrap_or (type-args i32) updated 0))
    (let slice (type-app Slice i32) (vec_as_slice (type-args i32) numbers))
    (write_stdout "\nslice-len=")
    (write_u32_decimal (slice_len (type-args i32) slice))
    (write_stdout "\n")
    (return 0)))
