; leading comment
(program
  (name "compatibility-forms")
  (version "0.1")

  (fn add-two ((left i32) (right i32)) i32
    (return (+ left right)))

  (fn guard ((value i32)) i32
    (when (< value 0) (return 0))
    (return value))

  (entry main () i32
    (let total i32 (add-two 40 2))
    (return (guard total))))
