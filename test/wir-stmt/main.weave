; SPDX-License-Identifier: Apache-2.0
; Qualification for structural let/set/return WIR builders.

(program
  (name "wir_stmt_test")
  (version "0.1")

  (fn wst_copy
    (params (wstc_dst ptr) (wstc_src ptr) (wstc_len i64))
    (returns void)
    (do
      (let wstc_i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get wstc_i) (param_get wstc_len)))
        (do
          (store_i8
            (ptr_add (param_get wstc_dst) (local_get wstc_i))
            (load_u8 (ptr_add (param_get wstc_src) (local_get wstc_i))))
          (set wstc_i (add_i64 (local_get wstc_i) (const_i64 1)))))
      (store_i8 (ptr_add (param_get wstc_dst) (param_get wstc_len)) (const_i32 0))
      (return_void)))

  (fn wst_equals
    (params (wste_tree ptr) (wste_root i64) (wste_expected ptr))
    (returns i32)
    (do
      (let wste_buffer ptr (call_ptr wir_buffer_new))
      (if
        (condition (eq_ptr (local_get wste_buffer) (const_null)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32
          (call_i32 wir_serialize_into
            (local_get wste_buffer) (param_get wste_tree) (param_get wste_root))
          (const_i32 0)))
        (then (do
          (call_void wir_buffer_free (local_get wste_buffer))
          (return (const_i32 0))))
        (else (do)))
      (let wste_len i64 (call_i64 wir_buffer_length (local_get wste_buffer)))
      (let wste_expected_len i64 (call_i64 strlen (param_get wste_expected)))
      (if
        (condition (ne_i64 (local_get wste_len) (local_get wste_expected_len)))
        (then (do
          (call_void wir_buffer_free (local_get wste_buffer))
          (return (const_i32 0))))
        (else (do)))
      (let wste_data ptr (call_ptr wir_buffer_data (local_get wste_buffer)))
      (let wste_i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get wste_i) (local_get wste_len)))
        (do
          (if
            (condition (ne_i32
              (load_u8 (ptr_add (local_get wste_data) (local_get wste_i)))
              (load_u8 (ptr_add (param_get wste_expected) (local_get wste_i)))))
            (then (do
              (call_void wir_buffer_free (local_get wste_buffer))
              (return (const_i32 0))))
            (else (do)))
          (set wste_i (add_i64 (local_get wste_i) (const_i64 1)))))
      (call_void wir_buffer_free (local_get wste_buffer))
      (return (const_i32 1))))

  (fn main
    (params)
    (returns i32)
    (do
      (let tree ptr (call_ptr wir_tree_new))
      (if
        (condition (eq_ptr (local_get tree) (const_null)))
        (then (do (return (const_i32 1))))
        (else (do)))

      (let name_buf ptr (call_ptr malloc (const_i64 2)))
      (let type_buf ptr (call_ptr malloc (const_i64 4)))
      (if
        (condition (or_bool
          (eq_ptr (local_get name_buf) (const_null))
          (eq_ptr (local_get type_buf) (const_null))))
        (then (do (return (const_i32 2))))
        (else (do)))
      (call_void wst_copy (local_get name_buf) (const_string_ptr "n") (const_i64 1))
      (call_void wst_copy (local_get type_buf) (const_string_ptr "i32") (const_i64 3))
      (let let_name i64 (call_i64 wir_stmt_atom (local_get tree) (local_get name_buf)))
      (let let_type i64 (call_i64 wir_stmt_atom (local_get tree) (local_get type_buf)))
      (let let_expr i64 (call_i64 wir_scalar_const_i32 (local_get tree) (const_i64 1)))
      (let let_node i64 (call_i64 wir_stmt_let
        (local_get tree) (local_get let_name) (local_get let_type)
        (local_get let_expr)))
      (if
        (condition (lt_i64 (local_get let_node) (const_i64 0)))
        (then (do (return (const_i32 3))))
        (else (do)))
      (store_i8 (local_get name_buf) (const_i32 88))
      (store_i8 (local_get type_buf) (const_i32 89))
      (call_void free (local_get name_buf))
      (call_void free (local_get type_buf))
      (if
        (condition (eq_i32 (call_i32 wst_equals
          (local_get tree) (local_get let_node)
          (const_string_ptr "(let n i32 (const_i32 1))")) (const_i32 0)))
        (then (do (return (const_i32 4))))
        (else (do)))

      (let set_name i64 (call_i64 wir_stmt_atom
        (local_get tree) (const_string_ptr "n")))
      (let add_node i64 (call_i64 wir_operator_binary
        (local_get tree) (const_string_ptr "add") (const_string_ptr "i32")
        (call_i64 wir_scalar_const_i32 (local_get tree) (const_i64 40))
        (call_i64 wir_scalar_const_i32 (local_get tree) (const_i64 2))))
      (let set_node i64 (call_i64 wir_stmt_set
        (local_get tree) (local_get set_name) (local_get add_node)))
      (if
        (condition (eq_i32 (call_i32 wst_equals
          (local_get tree) (local_get set_node)
          (const_string_ptr "(set n (add_i32 (const_i32 40) (const_i32 2)))"))
          (const_i32 0)))
        (then (do (return (const_i32 5))))
        (else (do)))

      (let callee i64 (call_i64 wir_call_callee_atom
        (local_get tree) (const_string_ptr "forty")))
      (let call_node i64 (call_i64 wir_call_begin
        (local_get tree) (const_string_ptr "i32") (local_get callee)))
      (let ret_node i64 (call_i64 wir_stmt_return
        (local_get tree) (local_get call_node)))
      (if
        (condition (eq_i32 (call_i32 wst_equals
          (local_get tree) (local_get ret_node)
          (const_string_ptr "(return (call_i32 forty))")) (const_i32 0)))
        (then (do (return (const_i32 6))))
        (else (do)))

      (let void_node i64 (call_i64 wir_stmt_return_void (local_get tree)))
      (if
        (condition (eq_i32 (call_i32 wst_equals
          (local_get tree) (local_get void_node)
          (const_string_ptr "(return_void)")) (const_i32 0)))
        (then (do (return (const_i32 7))))
        (else (do)))

      (let failed i64 (call_i64 wir_stmt_let
        (local_get tree) (const_i64 -1) (local_get let_type)
        (local_get let_expr)))
      (if
        (condition (ge_i64 (local_get failed) (const_i64 0)))
        (then (do (return (const_i32 8))))
        (else (do)))

      (call_void wir_tree_free (local_get tree))
      (return (const_i32 0))))
)
