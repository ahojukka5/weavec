; Quantum teleportation (no classical conditionals — frontend lowers all
; gates statically; the Bob-side X/Z corrections would normally be
; classically controlled on Alice's measurement outcomes).
;
; q0: state to teleport
; q1, q2: shared Bell pair (Alice owns q1, Bob owns q2)
;
; Bell-pair prep:        H q1; CNOT q1 q2
; Alice's circuit:       CNOT q0 q1; H q0
; (Skipped: classical-conditional X q2, Z q2 from measure results.)
(program
  (name "teleport")
  (version "0.1")
  (extern qrt_ry (params (q i64) (theta_nr i64)) (returns void))
  (extern qrt_rz (params (q i64) (phi_nr i64)) (returns void))
  (extern qrt_cnot (params (q0 i64) (q1 i64)) (returns void))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (let q2 Qubit (const_i64 2))
      (qgate H q1)
      (qgate CNOT q1 q2)
      (qgate CNOT q0 q1)
      (qgate H q0)
      (return (const_i32 42)))))
