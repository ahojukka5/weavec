; GHZ-3 state preparation: |000⟩ + |111⟩ (unnormalized).
; Sequence: H q0, CNOT q0 q1, CNOT q1 q2.
; After Rigetti nativization H decomposes to RY + RZ, yielding 4 native gates.
(program
  (name "ghz3")
  (version "0.1")
  (extern qrt_ry (params (q i64) (theta_nr i64)) (returns void))
  (extern qrt_rz (params (q i64) (phi_nr i64)) (returns void))
  (extern qrt_cnot (params (q0 i64) (q1 i64)) (returns void))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (let q2 Qubit (const_i64 2))
      (qgate H q0)
      (qgate CNOT q0 q1)
      (qgate CNOT q1 q2)
      (return (const_i32 42)))))
