; Deutsch-Jozsa (1-bit), balanced oracle f(x) = x (identity).
;
;   init:  q0 = |0>,  q1 = |1>  (X q1)
;   prep:  H q0; H q1
;   oracle U_f: CNOT q0 q1  (y XOR f(x) = y XOR x, which is what CNOT does)
;   final: H q0
;
; Output: measuring q0 always yields 1 for balanced f.
; This program returns marginal P(q0 = 1) in percent; expected 100.
(program
  (name "deutsch-jozsa-balanced")
  (version "0.1")
  (extern qrt_ry (params (q i64) (theta_nr i64)) (returns void))
  (extern qrt_rz (params (q i64) (phi_nr i64)) (returns void))
  (extern qrt_x (params (q i64)) (returns void))
  (extern qrt_cnot (params (q0 i64) (q1 i64)) (returns void))
  (extern qrt_marginal_prob_pct (params (q i64) (value i64)) (returns i32))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (qgate X q1)
      (qgate H q0)
      (qgate H q1)
      (qgate CNOT q0 q1)
      (qgate H q0)
      (return (call_i32 qrt_marginal_prob_pct (const_i64 0) (const_i64 1))))))
