; Three-qubit CCNOT (Toffoli). Self-inverse 3-qubit gate.
(program
  (name "test-ccnot")
  (version "0.1")
  (extern qrt_ccnot (params (q0 i64) (q1 i64) (q2 i64)) (returns void))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (let q2 Qubit (const_i64 2))
      (qgate CCNOT q0 q1 q2)
      (return (const_i32 42)))))
