; Parameterized single-qubit RX. Angle in nanoradians (theta * 1e9).
(program
  (name "test-rx-param")
  (version "0.1")
  (extern qrt_rx (params (q i64) (theta_nr i64)) (returns void))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (qgate RX q0 (const_i64 1570796327))
      (return (const_i32 42)))))
