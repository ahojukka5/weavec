; Single-qubit Z gate. Lowered to qrt_z via the generic path.
(program
  (name "test-z-single")
  (version "0.1")
  (extern qrt_z (params (q i64)) (returns void))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (qgate Z q0)
      (return (const_i32 42)))))
