; Single-qubit S gate (NOT self-inverse: S^2 = Z). Lowered to qrt_s.
(program
  (name "test-s-single")
  (version "0.1")
  (extern qrt_s (params (q i64)) (returns void))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (qgate S q0)
      (return (const_i32 42)))))
