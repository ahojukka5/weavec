; Single-qubit X gate. Lowered to qrt_x via the generic path.
(program
  (name "test-x-single")
  (version "0.1")
  (extern qrt_x (params (q i64)) (returns void))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (qgate X q0)
      (return (const_i32 42)))))
