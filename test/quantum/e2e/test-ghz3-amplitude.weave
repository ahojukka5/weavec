; E2E: GHZ-3 amplitude verification.
; |GHZ> = (|000> + |111>) / sqrt(2). prob(0) = prob(7) = 0.5, others 0.
; Returns prob(|000>) + prob(|111>) in percent; expected 100.
(program
  (name "test-ghz3-amplitude")
  (version "0.1")
  (extern qrt_ry (params (q i64) (theta_nr i64)) (returns void))
  (extern qrt_rz (params (q i64) (phi_nr i64)) (returns void))
  (extern qrt_cnot (params (q0 i64) (q1 i64)) (returns void))
  (extern qrt_basis_prob_pct (params (idx i64)) (returns i32))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (let q2 Qubit (const_i64 2))
      (qgate H q0)
      (qgate CNOT q0 q1)
      (qgate CNOT q1 q2)
      (return (add_i32
        (call_i32 qrt_basis_prob_pct (const_i64 0))
        (call_i32 qrt_basis_prob_pct (const_i64 7)))))))
