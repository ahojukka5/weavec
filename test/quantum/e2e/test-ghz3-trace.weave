; E2E: GHZ-3 preparation gate count via runtime trace.
; Expect 4 native gates (H decomposes to RY+RZ).
(program
  (name "test-ghz3-trace")
  (version "0.1")
  (extern qrt_ry (params (q i64) (theta_nr i64)) (returns void))
  (extern qrt_rz (params (q i64) (phi_nr i64)) (returns void))
  (extern qrt_cnot (params (q0 i64) (q1 i64)) (returns void))
  (extern qrt_get_trace_count (params ()) (returns i32))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (let q2 Qubit (const_i64 2))
      (qgate H q0)
      (qgate CNOT q0 q1)
      (qgate CNOT q1 q2)
      (return (call_i32 qrt_get_trace_count)))))
