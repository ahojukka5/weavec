; X on different qubits does NOT cancel — peephole requires identical operands.
(program
  (name "test-x-different-qubits-no-cancel")
  (version "0.1")
  (extern qrt_x (params (q i64)) (returns void))
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (qgate X q0)
      (qgate X q1)
      (return (const_i32 42)))))
