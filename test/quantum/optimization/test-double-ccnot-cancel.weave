; Consecutive CCNOT (Toffoli) on the same qubits cancel (CCNOT^2 = I).
(program
  (name "test-double-ccnot-cancel")
  (version "0.1")
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (let q2 Qubit (const_i64 2))
      (qgate CCNOT q0 q1 q2)
      (qgate CCNOT q0 q1 q2)
      (return (const_i32 42)))))
