; Consecutive SWAP on the same qubits cancel (SWAP^2 = I).
(program
  (name "test-double-swap-cancel")
  (version "0.1")
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (qgate SWAP q0 q1)
      (qgate SWAP q0 q1)
      (return (const_i32 42)))))
