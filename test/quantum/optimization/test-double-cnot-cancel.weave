; Consecutive CNOT on the same (control, target) pair cancel (CNOT is
; self-inverse on identical operands).
(program
  (name "test-double-cnot-cancel")
  (version "0.1")
  (entry main
    (params)
    (returns i32)
    (do
      (let q0 Qubit (const_i64 0))
      (let q1 Qubit (const_i64 1))
      (qgate CNOT q0 q1)
      (qgate CNOT q0 q1)
      (return (const_i32 42)))))
