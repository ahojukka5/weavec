(program
  (name "float-arithmetic")
  (version "0.1")

  (entry main
    (params)
    (returns i32)
    (do
      (call print_f64 "1.5 + 2.25 = "
        (op add 1.5 2.25))
      (call print_f64 "7.0 / 2.0 = "
        (op div 7.0 2.0))
      (call print_f64 "2.5 * 4.0 - 1.0 = "
        (op sub
          (op mul 2.5 4.0)
          1.0))
      (return 0))))