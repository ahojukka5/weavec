(program
  (name "statistics")
  (version "0.1")

  ; std.process owns the native entry wrapper and calls this high-level function.
  (fn program_main
    (params)
    (returns i32)
    (do
      (let count i32 (call args_count))
      (if
        (condition (op equal count 0))
        (then (do
          (call write_stderr "usage: statistics <value> [value ...]\n")
          (return 2)))
        (else (do)))
      ; The argument count is known before parsing, so the sample block is sized
      ; exactly once and never grows.
      (let samples Samples (call samples_new count))
      (let index i32 0)
      (while
        (condition (op less-than index count))
        (do
          (if
            (condition (op not (call parse_f64_valid (call arg index))))
            (then (do
              ; Name the text that failed rather than only its position.
              (call write_stderr "error: not a number: ")
              (call write_stderr (call arg index))
              (call write_stderr "\n")
              (call samples_release samples)
              (return 2)))
            (else (do)))
          (call samples_add samples (call parse_f64 (call arg index)))
          (set index (op add index 1))))
      (let variance f64 (call samples_population_variance samples))
      (call write_stdout "count = ")
      (call write_u32_decimal (call samples_count samples))
      (call write_stdout "\n")
      (call print_f64 "mean = " (call samples_mean samples))
      (call print_f64 "variance = " variance)
      (call print_f64 "stddev = " (call sqrt_f64 variance))
      (call samples_release samples)
      (return 0))))
