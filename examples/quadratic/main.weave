; SPDX-License-Identifier: Apache-2.0

(program
  (name "quadratic")
  (version "0.1")

  ; std.process owns the native entry wrapper and calls this high-level function.
  (fn program_main
    (params)
    (returns i32)
    (do
      (when (!= (args_count) 3)
        (write_stderr "usage: quadratic <a> <b> <c>\n")
        (return 2))
      (let index i32 0)
      (while (< index 3)
        (when (not (parse_f64_valid (arg index)))
          (write_stderr "error: not a number: ")
          (write_stderr (arg index))
          (write_stderr "\n")
          (return 2))
        (set index (+ index 1)))
      (let a f64 (parse_f64 (arg 0)))
      (let b f64 (parse_f64 (arg 1)))
      (let c f64 (parse_f64 (arg 2)))
      (when (= a 0.0)
        (write_stderr
          "error: the coefficient a must not be zero\n")
        (return 2))
      ; discriminant = b^2 - 4ac
      (let discriminant f64
        (-
          (* b b)
          (* 4.0 (* a c))))
      (when (< discriminant 0.0)
        (write_stdout "no real roots\n")
        (return 0))
      (when (= discriminant 0.0)
        ; A zero discriminant has one root of multiplicity two, -b / 2a.
        (print_f64 "root = " (/ (- 0.0 b) (* 2.0 a)))
        (return 0))
      ; Two distinct real roots, (-b +/- sqrt(discriminant)) / 2a.
      (let root_of_discriminant f64 (sqrt_f64 discriminant))
      (let denominator f64 (* 2.0 a))
      (let first f64
        (/ (+ (- 0.0 b) root_of_discriminant) denominator))
      (let second f64
        (/ (- (- 0.0 b) root_of_discriminant) denominator))
      ; Output is ordered ascending. Which formula yields the smaller root
      ; depends on the sign of a, so the order is chosen rather than assumed.
      (let smaller f64 first)
      (let larger f64 second)
      (when (> first second)
        (set smaller second)
        (set larger first))
      (write_stdout "roots = ")
      (write_f64_trimmed smaller)
      (write_stdout ", ")
      (write_f64_trimmed larger)
      (write_stdout "\n")
      (return 0))))
