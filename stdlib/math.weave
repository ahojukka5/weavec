; SPDX-License-Identifier: Apache-2.0
; Small reusable numerical helpers implemented in Weave.
;
; Square root uses a fixed-count Newton iteration. Trigonometric functions use
; deterministic range reduction and fixed-count Taylor recurrences. Keeping the
; algorithms here avoids a process-wide libm dependency and keeps numerical
; semantics in Weave rather than the C host boundary.

(program
  (name "std.math")
  (version "0.1")

  ; IEEE-754 binary64 has enough precision to retain this spelling faithfully.
  (const PI_F64 f64 3.141592653589793)

  (fn sqrt_f64
    (params (value f64))
    (returns f64)
    (do
      (if
        (condition (le_f64 (param_get value) (const_f64 0.0)))
        (then (do (return (const_f64 0.0))))
        (else (do)))
      (let guess f64 (param_get value))
      (if
        (condition (lt_f64 (local_get guess) (const_f64 1.0)))
        (then (do (set guess (const_f64 1.0))))
        (else (do)))
      (let iteration i32 (const_i32 0))
      (while
        (condition (lt_i32 (local_get iteration) (const_i32 32)))
        (do
          (set guess
            (mul_f64
              (const_f64 0.5)
              (add_f64
                (local_get guess)
                (div_f64 (param_get value) (local_get guess)))))
          (set iteration (add_i32 (local_get iteration) (const_i32 1)))))
      (return (local_get guess))))

  ; Absolute value.
  (fn f64_abs
    (params (value f64))
    (returns f64)
    (do
      (if
        (condition (lt_f64 (param_get value) (const_f64 0.0)))
        (then (do
          (return (sub_f64 (const_f64 0.0) (param_get value)))))
        (else (do)))
      (return (param_get value))))

  ; Convert degrees to radians with the shared PI_F64 constant.
  (fn degrees_to_radians
    (params (degrees f64))
    (returns f64)
    (do
      (return
        (mul_f64
          (param_get degrees)
          (div_f64 (call_f64 PI_F64) (const_f64 180.0))))))

  ; Reduce an angle to [-pi, pi]. Two ordinary top-level loops keep control flow
  ; within the same simple surface model used by the rest of the stdlib.
  (fn normalize_radians
    (params (value f64))
    (returns f64)
    (do
      (let angle f64 (param_get value))
      (let pi f64 (call_f64 PI_F64))
      (let two_pi f64 (mul_f64 (const_f64 2.0) (local_get pi)))
      (while
        (condition (gt_f64 (local_get angle) (local_get pi)))
        (do
          (set angle (sub_f64 (local_get angle) (local_get two_pi)))))
      (while
        (condition (lt_f64 (local_get angle)
          (sub_f64 (const_f64 0.0) (local_get pi))))
        (do
          (set angle (add_f64 (local_get angle) (local_get two_pi)))))
      (return (local_get angle))))

  ; Fold a value already reduced to [-pi, pi] onto [0, pi/2] using the shared
  ; symmetry of sine and cosine about pi/2. Both series below are evaluated only
  ; on that quarter turn, where ten Taylor terms reach binary64 precision. The
  ; sign each caller must reapply differs, so the callers own it.
  (fn fold_quarter_turn
    (params (value f64))
    (returns f64)
    (do
      (let x f64 (param_get value))
      (if
        (condition (lt_f64 (local_get x) (const_f64 0.0)))
        (then (do (set x (sub_f64 (const_f64 0.0) (local_get x)))))
        (else (do)))
      (let half_pi f64 (div_f64 (call_f64 PI_F64) (const_f64 2.0)))
      (if
        (condition (gt_f64 (local_get x) (local_get half_pi)))
        (then (do (set x (sub_f64 (call_f64 PI_F64) (local_get x)))))
        (else (do)))
      (return (local_get x))))

  ; Ten Taylor terms on [0, pi/2] leave a truncation error near 1e-17, so the
  ; series no longer limits six-place output or the inverse below.
  (fn sin_f64
    (params (value f64))
    (returns f64)
    (do
      (let reduced f64 (call_f64 normalize_radians (param_get value)))
      (let sign f64 (const_f64 1.0))
      (if
        (condition (lt_f64 (local_get reduced) (const_f64 0.0)))
        (then (do (set sign (const_f64 -1.0))))
        (else (do)))
      (let x f64 (call_f64 fold_quarter_turn (local_get reduced)))
      (let x2 f64 (mul_f64 (local_get x) (local_get x)))
      (let term f64 (local_get x))
      (let sum f64 (local_get x))
      (let n i32 (const_i32 1))
      (let left i32 (const_i32 0))
      (let right i32 (const_i32 0))
      (let denominator f64 (const_f64 1.0))
      (while
        (condition (lt_i32 (local_get n) (const_i32 11)))
        (do
          (set left (mul_i32 (const_i32 2) (local_get n)))
          (set right (add_i32 (local_get left) (const_i32 1)))
          (set denominator
            (mul_f64
              (cast_i32_to_f64 (local_get left))
              (cast_i32_to_f64 (local_get right))))
          (set term
            (div_f64
              (mul_f64
                (sub_f64 (const_f64 0.0) (local_get term))
                (local_get x2))
              (local_get denominator)))
          (set sum (add_f64 (local_get sum) (local_get term)))
          (set n (add_i32 (local_get n) (const_i32 1)))))
      (return (mul_f64 (local_get sign) (local_get sum)))))

  (fn cos_f64
    (params (value f64))
    (returns f64)
    (do
      (let reduced f64 (call_f64 normalize_radians (param_get value)))
      ; Cosine is even, so only the distance past pi/2 changes the sign.
      (let magnitude f64 (call_f64 f64_abs (local_get reduced)))
      (let sign f64 (const_f64 1.0))
      (if
        (condition (gt_f64
          (local_get magnitude)
          (div_f64 (call_f64 PI_F64) (const_f64 2.0))))
        (then (do (set sign (const_f64 -1.0))))
        (else (do)))
      (let x f64 (call_f64 fold_quarter_turn (local_get reduced)))
      (let x2 f64 (mul_f64 (local_get x) (local_get x)))
      (let term f64 (const_f64 1.0))
      (let sum f64 (const_f64 1.0))
      (let n i32 (const_i32 1))
      (let left i32 (const_i32 0))
      (let right i32 (const_i32 0))
      (let denominator f64 (const_f64 1.0))
      (while
        (condition (lt_i32 (local_get n) (const_i32 11)))
        (do
          (set right (mul_i32 (const_i32 2) (local_get n)))
          (set left (sub_i32 (local_get right) (const_i32 1)))
          (set denominator
            (mul_f64
              (cast_i32_to_f64 (local_get left))
              (cast_i32_to_f64 (local_get right))))
          (set term
            (div_f64
              (mul_f64
                (sub_f64 (const_f64 0.0) (local_get term))
                (local_get x2))
              (local_get denominator)))
          (set sum (add_f64 (local_get sum) (local_get term)))
          (set n (add_i32 (local_get n) (const_i32 1)))))
      (return (mul_f64 (local_get sign) (local_get sum)))))

  ; Callers are responsible for avoiding cosine zeros where tangent is singular.
  (fn tan_f64
    (params (value f64))
    (returns f64)
    (do
      (return
        (div_f64
          (call_f64 sin_f64 (param_get value))
          (call_f64 cos_f64 (param_get value))))))

  ; Convert radians to degrees with the shared PI_F64 constant.
  (fn radians_to_degrees
    (params (radians f64))
    (returns f64)
    (do
      (return
        (mul_f64
          (param_get radians)
          (div_f64 (const_f64 180.0) (call_f64 PI_F64))))))

  ; Inverse cosine on [-1, 1], returning [0, pi].
  ;
  ; Cosine decreases monotonically across [0, pi], so a fixed-count bisection
  ; inverts it without a second numerical implementation and without a division
  ; that could be singular. Sixty halvings exhaust binary64 precision on that
  ; interval. Inputs outside [-1, 1] are clamped, which is the documented
  ; boundary where a caller's own roundoff can leave the valid domain; the exact
  ; endpoints return their exact angles rather than a converged approximation.
  (fn acos_f64
    (params (value f64))
    (returns f64)
    (do
      (let x f64 (param_get value))
      (if
        (condition (ge_f64 (local_get x) (const_f64 1.0)))
        (then (do (return (const_f64 0.0))))
        (else (do)))
      (if
        (condition (le_f64 (local_get x) (const_f64 -1.0)))
        (then (do (return (call_f64 PI_F64))))
        (else (do)))
      (let low f64 (const_f64 0.0))
      (let high f64 (call_f64 PI_F64))
      (let iteration i32 (const_i32 0))
      (let middle f64 (const_f64 0.0))
      (while
        (condition (lt_i32 (local_get iteration) (const_i32 60)))
        (do
          (set middle
            (mul_f64
              (const_f64 0.5)
              (add_f64 (local_get low) (local_get high))))
          (if
            (condition (gt_f64
              (call_f64 cos_f64 (local_get middle))
              (local_get x)))
            (then (do (set low (local_get middle))))
            (else (do (set high (local_get middle)))))
          (set iteration (add_i32 (local_get iteration) (const_i32 1)))))
      (return
        (mul_f64
          (const_f64 0.5)
          (add_f64 (local_get low) (local_get high))))))
)