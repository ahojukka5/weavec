; SPDX-License-Identifier: Apache-2.0
; Process environment lookup for ordinary Weave programs.
;
; Missing names are None, not a null pointer or an empty string. The
; host getenv pointer is copied into an owned String immediately.
; std.memory, std.option, std.bytes, and std.string must be earlier in
; the build.

(program
  (name "std.env")
  (version "0.1")

  (extern getenv
    (params (name ptr))
    (returns ptr))

  (fn env_get
    (params (name ptr))
    (returns (type-app Option String))
    (do
      (if
        (condition (eq_ptr (param_get name) (const_null)))
        (then (do
          (return (variant Option (type-args String) None))))
        (else (do)))
      (let raw ptr (call_ptr getenv (param_get name)))
      (if
        (condition (eq_ptr (local_get raw) (const_null)))
        (then (do
          (return (variant Option (type-args String) None))))
        (else (do)))
      (return
        (variant Option (type-args String) Some
          (call string_from_text (local_get raw)))))))
