# Build outputs (recreated by ./build.sh on every run).
# Includes build/vendor/{weavec0,weavec1,weavec-bootstrap} where the
# dependencies are auto-fetched.
build/

# LLVM intermediates left around outside build/ for any reason.
*.bc
*.o

# Python bytecode cache (from embedded verifier scripts in test/*/test.sh).
__pycache__/
*.pyc

# Editor / OS noise.
.DS_Store
*.swp
*.swo
*~
