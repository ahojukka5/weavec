(fn type_graph_primitive
    (params (graph ptr) (type_name ptr))
    (returns i32)
    (do
      (if
        (condition (or_bool
          (eq_ptr (param_get graph) (const_null))
          (eq_ptr (param_get type_name) (const_null))))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i64 (call_i64 strlen (param_get type_name)) (const_i64 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let identity_buffer ptr (call_ptr type_buffer_new))
      (let display_buffer ptr (call_ptr type_buffer_new))
      (if
        (condition (or_bool
          (eq_ptr (local_get identity_buffer) (const_null))
          (eq_ptr (local_get display_buffer) (const_null))))
        (then (do
          (call_void type_buffer_dispose (local_get identity_buffer))
          (call_void type_buffer_dispose (local_get display_buffer))
          (return (const_i32 0))))
        (else (do)))
      (let ok i32 (const_i32 1))
      (if
        (condition (eq_i32
          (call_i32 type_buffer_append
            (local_get identity_buffer) (const_string_ptr "primitive"))
          (const_i32 0)))
        (then (do (set ok (const_i32 0))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get ok) (const_i32 0))
          (eq_i32
            (call_i32 type_buffer_append_field
              (local_get identity_buffer) (param_get type_name))
            (const_i32 0))))
        (then (do (set ok (const_i32 0))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get ok) (const_i32 0))
          (eq_i32
            (call_i32 type_buffer_append
              (local_get display_buffer) (param_get type_name))
            (const_i32 0))))
        (then (do (set ok (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32 (local_get ok) (const_i32 0)))
        (then (do
          (call_void type_buffer_dispose (local_get identity_buffer))
          (call_void type_buffer_dispose (local_get display_buffer))
          (return (const_i32 0))))
        (else (do)))
      (let reference i32
        (call_i32 type_graph_intern
          (param_get graph)
          (call_i32 type_kind_primitive)
          (call_ptr type_buffer_take (local_get identity_buffer))
          (call_ptr type_buffer_take (local_get display_buffer))
          (const_null)
          (const_i64 0)))
      (if
        (condition (eq_i32 (local_get reference) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32
          (call_i32 type_graph_bind_metadata
            (param_get graph) (local_get reference)
            (const_null) (param_get type_name) (const_i32 0))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (return (local_get reference))))

