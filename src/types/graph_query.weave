    (do
      (let node ptr
        (call_ptr type_graph_node (param_get graph) (param_get reference)))
      (if (condition (eq_ptr (local_get node) (const_null)))
        (then (do (return (const_null)))) (else (do)))
      (return (load_ptr (ptr_add (local_get node) (const_i64 24))))))

(fn type_graph_hash
    (params (graph ptr) (reference i32))
    (returns i64)
    (do
      (let node ptr
        (call_ptr type_graph_node (param_get graph) (param_get reference)))
      (if (condition (eq_ptr (local_get node) (const_null)))
        (then (do (return (const_i64 0)))) (else (do)))
      (return (load_i64 (ptr_add (local_get node) (const_i64 8))))))

