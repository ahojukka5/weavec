; graph_query.weave — read-only graph queries and equality
;
; Part of the self-hosted structured semantic type graph.  This is compiler
; logic, not host runtime logic.

(program
  (name "graph_query")
  (version "0.1")

(fn type_graph_kind
    (params (graph ptr) (reference i32))
    (returns i32)
    (do
      (let node ptr
        (call_ptr type_graph_node (param_get graph) (param_get reference)))
      (if
        (condition (eq_ptr (local_get node) (const_null)))
        (then (do (return (call_i32 type_kind_invalid))))
        (else (do)))
      (return (load_i32 (local_get node)))))

(fn type_graph_identity
    (params (graph ptr) (reference i32))
    (returns ptr)
    (do
      (let node ptr
        (call_ptr type_graph_node (param_get graph) (param_get reference)))
      (if (condition (eq_ptr (local_get node) (const_null)))
        (then (do (return (const_null)))) (else (do)))
      (return (load_ptr (ptr_add (local_get node) (const_i64 16))))))

(fn type_graph_display
    (params (graph ptr) (reference i32))
