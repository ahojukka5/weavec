; SPDX-License-Identifier: Apache-2.0
; main.weave — entry point for weavec
;
; Usage:
;   weavec --version
;   weavec build <input.weave> [input2.weave ...] -o <program>
;   weavec --backend <input.wir> <output.ll>
;   weavec --frontend [--strict-contracts] <output.wir> <input.weave> [input2.weave ...]
;   weavec --dump-quantum-stats <output.metrics> <input.weave>
;   weavec --explain <input.weave>
;   weavec --explain-json <input.weave>
;   weavec --audit <input.weave>
;   weavec --audit-json <input.weave>

(program
  (name "main")
  (version "0.1")

  ; Return non-zero when node is a typed or void function-call form.
  (fn backend_is_call_form
    (params (ctx ptr) (node i64))
    (returns i32)
    (do
      (let tree ptr (call_ptr ctx_get_tree (param_get ctx)))
      (let source ptr (call_ptr ctx_get_source (param_get ctx)))
      (if
        (condition (or_bool
          (or_bool
            (or_bool
              (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (param_get node)
                (const_string_ptr "call_i32") (const_i64 8)) (const_i32 0))
              (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (param_get node)
                (const_string_ptr "call_i64") (const_i64 8)) (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (param_get node)
                (const_string_ptr "call_bool") (const_i64 9)) (const_i32 0))
              (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (param_get node)
                (const_string_ptr "call_ptr") (const_i64 8)) (const_i32 0))))
          (or_bool
            (or_bool
              (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (param_get node)
                (const_string_ptr "call_f32") (const_i64 8)) (const_i32 0))
              (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (param_get node)
                (const_string_ptr "call_f64") (const_i64 8)) (const_i32 0)))
            (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (param_get node)
              (const_string_ptr "call_void") (const_i64 9)) (const_i32 0)))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  ; Return non-zero for runtime functions emitted implicitly by the backend.
  (fn backend_is_implicit_callable
    (params (ctx ptr) (name_node i64))
    (returns i32)
    (do
      (let tree ptr (call_ptr ctx_get_tree (param_get ctx)))
      (let source ptr (call_ptr ctx_get_source (param_get ctx)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 node_text_equals
              (local_get tree) (local_get source) (param_get name_node)
              (const_string_ptr "malloc") (const_i64 6)) (const_i32 0))
            (ne_i32 (call_i32 node_text_equals
              (local_get tree) (local_get source) (param_get name_node)
              (const_string_ptr "free") (const_i64 4)) (const_i32 0)))
          (or_bool
            (ne_i32 (call_i32 node_text_equals
              (local_get tree) (local_get source) (param_get name_node)
              (const_string_ptr "puts") (const_i64 4)) (const_i32 0))
            (ne_i32 (call_i32 node_text_equals
              (local_get tree) (local_get source) (param_get name_node)
              (const_string_ptr "weave_rt_contract_fail") (const_i64 22)) (const_i32 0)))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  ; Return non-zero when name is declared by an extern or function in decls.
  (fn backend_decls_has_callable
    (params (ctx ptr) (decls_node i64) (name_node i64))
    (returns i32)
    (do
      (let tree ptr (call_ptr ctx_get_tree (param_get ctx)))
      (let source ptr (call_ptr ctx_get_source (param_get ctx)))
      (let child i64 (call_i64 node_first_child (local_get tree) (param_get decls_node)))
      (if
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (then (do
          (set child (call_i64 node_next_sibling (local_get tree) (local_get child)))))
        (else (do)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (and_bool
              (eq_i32 (call_i32 node_kind (local_get tree) (local_get child)) (call_i32 node_list))
              (or_bool
                (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (local_get child)
                  (const_string_ptr "extern") (const_i64 6)) (const_i32 0))
                (ne_i32 (call_i32 list_head_ne (local_get tree) (local_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))))
            (then (do
              (let declared_name i64 (call_i64 nth_child
                (local_get tree) (local_get child) (const_i64 1)))
              (if
                (condition (ne_i32 (call_i32 ident_nodes_equal
                  (local_get tree) (local_get source)
                  (local_get declared_name) (param_get name_node)) (const_i32 0)))
                (then (do (return (const_i32 1))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (local_get tree) (local_get child)))))
      (return (const_i32 0))))

  ; Reject calls whose target is absent from the complete declaration set.
  (fn backend_validate_call_targets
    (params (ctx ptr) (decls_node i64) (node i64))
    (returns i32)
    (do
      (let tree ptr (call_ptr ctx_get_tree (param_get ctx)))
      (if
        (condition (ne_i32 (call_i32 node_kind (local_get tree) (param_get node)) (call_i32 node_list)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 backend_is_call_form
          (param_get ctx) (param_get node)) (const_i32 0)))
        (then (do
          (let name_node i64 (call_i64 nth_child
            (local_get tree) (param_get node) (const_i64 1)))
          (if
            (condition (or_bool
              (eq_i64 (local_get name_node) (const_i64 -1))
              (and_bool
                (eq_i32 (call_i32 backend_is_implicit_callable
                  (param_get ctx) (local_get name_node)) (const_i32 0))
                (eq_i32 (call_i32 backend_decls_has_callable
                  (param_get ctx) (param_get decls_node) (local_get name_node)) (const_i32 0)))))
            (then (do
              (call_void diag_unknown_identifier (param_get ctx) (local_get name_node))
              (return (const_i32 1))))
            (else (do)))))
        (else (do)))
      (let child i64 (call_i64 node_first_child (local_get tree) (param_get node)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 backend_validate_call_targets
              (param_get ctx) (param_get decls_node) (local_get child)) (const_i32 0)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (set child (call_i64 node_next_sibling (local_get tree) (local_get child)))))
      (return (const_i32 0))))

  ; Compile a WIR file to LLVM IR.
  (fn compile_file
    (params (input_path ptr) (output_path ptr))
    (returns i32)
    (do
      ; Read entire input file
      (let len_buf ptr (call_ptr malloc (const_i64 8)))
      (if
        (condition (eq_ptr (local_get len_buf) (const_null)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (store_i64 (local_get len_buf) (const_i64 0))
      ; Open input
      (let in_fd i32 (call_i32 open (param_get input_path) (const_i32 0) (const_i32 0)))
      (if
        (condition (lt_i32 (local_get in_fd) (const_i32 0)))
        (then (do
          (call_void free (local_get len_buf))
          (return (const_i32 1))))
        (else (do)))
      ; Seek to end to get file size
      (let file_size i64 (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 2)))
      (if
        (condition (lt_i64 (local_get file_size) (const_i64 0)))
        (then (do
          (call_i32 close (local_get in_fd))
          (call_void free (local_get len_buf))
          (return (const_i32 1))))
        (else (do)))
      ; Seek back to start
      (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 0))
      ; Allocate buffer
      (let source ptr (call_ptr malloc (add_i64 (local_get file_size) (const_i64 1))))
      (if
        (condition (eq_ptr (local_get source) (const_null)))
        (then (do
          (call_i32 close (local_get in_fd))
          (call_void free (local_get len_buf))
          (return (const_i32 1))))
        (else (do)))
      ; Read file
      (let bytes_read i64 (call_i64 read (local_get in_fd) (local_get source) (local_get file_size)))
      (call_i32 close (local_get in_fd))
      (if
        (condition (ne_i64 (local_get bytes_read) (local_get file_size)))
        (then (do
          (call_void free (local_get source))
          (call_void free (local_get len_buf))
          (return (const_i32 1))))
        (else (do)))
      ; Null-terminate
      (store_i8 (ptr_add (local_get source) (local_get file_size)) (const_i32 0))
      (call_void free (local_get len_buf))
      ; Lex and parse
      (let tokens ptr (call_ptr lex (local_get source) (local_get file_size)))
      (if
        (condition (eq_ptr (local_get tokens) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (let tree ptr (call_ptr parse (local_get tokens)))
      (if
        (condition (eq_ptr (local_get tree) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      ; Validate the complete WIR declaration set before creating an output file.
      (let validation_ctx ptr (call_ptr ctx_new (const_i32 -1) (local_get source) (local_get tree)))
      (if
        (condition (eq_ptr (local_get validation_ctx) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 validate_core_module_v2
          (local_get validation_ctx) (const_i64 0)) (const_i32 0)))
        (then (do
          (call_void ctx_free (local_get validation_ctx))
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (let decls_node i64 (call_i64 find_decls_node (local_get validation_ctx) (const_i64 0)))
      (if
        (condition (or_bool
          (eq_i64 (local_get decls_node) (const_i64 -1))
          (ne_i32 (call_i32 backend_validate_call_targets
            (local_get validation_ctx) (local_get decls_node) (local_get decls_node)) (const_i32 0))))
        (then (do
          (call_void ctx_free (local_get validation_ctx))
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (call_void ctx_free (local_get validation_ctx))
      ; Open output file via the portability shim — the flag value for
      ; O_WRONLY|O_CREAT|O_TRUNC differs between macOS (0x601=1537) and
      ; Linux (0x241=577), so we go through C where <fcntl.h> resolves it.
      (let out_fd i32 (call_i32 weave_rt_open_write_trunc (param_get output_path) (const_i32 420)))
      (if
        (condition (lt_i32 (local_get out_fd) (const_i32 0)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (call_i32 fchmod (local_get out_fd) (const_i32 420))
      ; Create emission context
      (let ctx ptr (call_ptr ctx_new (local_get out_fd) (local_get source) (local_get tree)))
      (if
        (condition (eq_ptr (local_get ctx) (const_null)))
        (then (do
          (call_i32 close (local_get out_fd))
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      ; Emit module
      (let status i32 (call_i32 emit_module (local_get ctx) (param_get input_path)))
      (call_void ctx_free (local_get ctx))
      (call_i32 close (local_get out_fd))
      (if
        (condition (ne_i32 (local_get status) (const_i32 0)))
        (then (do (call_i32 unlink (param_get output_path))))
        (else (do)))
      (call_void free (local_get source))
      (return (local_get status))))

  ; Entry point.
  (entry main
    (params (argc i32) (argv ptr))
    (returns i32)
    (do
      (if
        (condition (lt_i32 (param_get argc) (const_i32 2)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (let arg1 ptr (load_ptr (ptr_add (param_get argv) (const_i64 8))))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "--version") (const_i64 9)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (param_get argc) (const_i32 2)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (return (call_i32 weave_rt_print_version))))
        (else (do)))
      (if
        (condition (lt_i32 (param_get argc) (const_i32 3)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "build") (const_i64 5)) (const_i32 0)))
        (then (do
          (return (call_i32 weave_rt_build_main (param_get argc) (param_get argv)))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "--backend") (const_i64 9)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (param_get argc) (const_i32 4)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (let input_path ptr (load_ptr (ptr_add (param_get argv) (const_i64 16))))
          (let output_path ptr (load_ptr (ptr_add (param_get argv) (const_i64 24))))
          (return (call_i32 compile_file (local_get input_path) (local_get output_path)))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "--frontend") (const_i64 10)) (const_i32 0)))
        (then (do
          (if
            (condition (lt_i32 (param_get argc) (const_i32 4)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (let out_idx i64 (const_i64 2))
          (let arg2 ptr (load_ptr (ptr_add (param_get argv) (const_i64 16))))
          (if
            (condition (ne_i32 (call_i32 cstr_equals
              (local_get arg2) (const_string_ptr "--strict-contracts") (const_i64 18)) (const_i32 0)))
            (then (do (set out_idx (const_i64 3))))
            (else (do)))
          (if
            (condition (ge_i64 (local_get out_idx) (cast_i32_to_i64 (param_get argc))))
            (then (do (return (const_i32 1))))
            (else (do)))
          (let output_path2 ptr (load_ptr (ptr_add (param_get argv) (mul_i64 (local_get out_idx) (const_i64 8)))))
          (return (call_i32 lower_sources
            (param_get argc) (param_get argv) (local_get output_path2) (add_i64 (local_get out_idx) (const_i64 1))))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "--dump-quantum-stats") (const_i64 20)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (param_get argc) (const_i32 4)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (let stats_out ptr (load_ptr (ptr_add (param_get argv) (const_i64 16))))
          (let stats_in ptr (load_ptr (ptr_add (param_get argv) (const_i64 24))))
          (return (call_i32 dump_quantum_stats_file (local_get stats_in) (local_get stats_out)))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "--explain-json") (const_i64 14)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (param_get argc) (const_i32 3)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (let explain_json_in ptr (load_ptr (ptr_add (param_get argv) (const_i64 16))))
          (return (call_i32 explain_file_mode (local_get explain_json_in) (const_i32 1)))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "--explain") (const_i64 9)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (param_get argc) (const_i32 3)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (let explain_in ptr (load_ptr (ptr_add (param_get argv) (const_i64 16))))
          (return (call_i32 explain_file (local_get explain_in)))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "--audit") (const_i64 7)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (param_get argc) (const_i32 3)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (let audit_in ptr (load_ptr (ptr_add (param_get argv) (const_i64 16))))
          (return (call_i32 audit_file (local_get audit_in)))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 cstr_equals
          (local_get arg1) (const_string_ptr "--audit-json") (const_i64 12)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (param_get argc) (const_i32 3)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (let audit_json_in ptr (load_ptr (ptr_add (param_get argv) (const_i64 16))))
          (return (call_i32 audit_file_json (local_get audit_json_in)))))
        (else (do)))
      ; Unknown or incomplete command.
      (return (const_i32 1))))
)
