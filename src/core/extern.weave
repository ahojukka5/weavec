; SPDX-License-Identifier: Apache-2.0
; extern.weave — all extern declarations for weavec
;
; Must be listed first in the build so all other files can call these.

(program
  (name "extern")
  (version "0.1")

  ; libc
  (extern malloc (params (size i64)) (returns ptr))
  (extern realloc (params (p ptr) (size i64)) (returns ptr))
  (extern free (params (p ptr)) (returns void))
  (extern strlen (params (s ptr)) (returns i64))

  ; posix I/O
  (extern open (params (path ptr) (flags i32) (mode i32)) (returns i32))
  (extern close (params (fd i32)) (returns i32))
  (extern unlink (params (path ptr)) (returns i32))
  (extern fchmod (params (fd i32) (mode i32)) (returns i32))
  (extern read (params (fd i32) (buf ptr) (count i64)) (returns i64))
  (extern write (params (fd i32) (buf ptr) (count i64)) (returns i64))
  (extern lseek (params (fd i32) (offset i64) (whence i32)) (returns i64))

  ; Native compiler support.
  ; portable.c owns host portability helpers; build_driver.c owns the public
  ; source-to-executable orchestration and private runtime discovery.
  (extern weave_rt_open_write_trunc (params (path ptr) (mode i32)) (returns i32))
  (extern weave_rt_print_version (params) (returns i32))
  (extern weave_rt_print_capabilities (params) (returns i32))
  (extern weave_rt_format_main (params (argc i32) (argv ptr)) (returns i32))
  (extern weave_rt_semantic_index_main
    (params (argc i32) (argv ptr)) (returns i32))
  (extern weave_rt_contract_fail (params (msg ptr)) (returns void))
  (extern weave_rt_build_main (params (argc i32) (argv ptr)) (returns i32))
  (extern weave_rt_set_source_index (params (source_index i64)) (returns void))
  (extern weave_rt_emit_current_source_body (params) (returns i32))
  (extern weave_rt_emit_source_file
    (params (fd i32) (source_index i64) (source_path ptr)) (returns void))
  (extern weave_rt_emit_source_span
    (params (fd i32) (source ptr) (start i64) (len i64)) (returns void))
  (extern weave_rt_record_diagnostic_wir_span
    (params (fd i32) (start i64) (len i64)) (returns void))
  (extern weave_rt_emit_llvm_source_span
    (params (fd i32) (wir_source ptr) (start i64) (len i64) (kind i64))
    (returns void))
  (extern weave_rt_trace_set_source
    (params (source_index i64) (source_path ptr)) (returns void))
  (extern weave_rt_trace_event
    (params
      (kind ptr) (pass_name ptr) (action ptr)
      (source ptr) (start i64) (len i64)
      (detail_start i64) (detail_len i64))
    (returns void))
  (extern weave_rt_diag_record
    (params
      (code ptr) (source ptr) (start i64) (len i64)
      (expected_type ptr) (actual_type ptr)
      (argument_index i32) (expected_count i32) (actual_count i32)
      (operand_role ptr)
      (symbol_source ptr) (symbol_start i64) (symbol_len i64)
      (repair_kind i32))
    (returns void))

  ; Minimal native state/storage boundary for self-hosted semantic code.
  ;
  ; Weave owns the type graph and every language-level type decision. Host C
  ; supplies one opaque mutable pointer cell because surface Weave has no mutable
  ; process globals yet, plus raw symbol/module storage that assigns no type
  ; meaning.
  (extern weave_host_semantic_state_get (params) (returns ptr))
  (extern weave_host_semantic_state_set (params (state ptr)) (returns void))
  (extern weave_surface_symbols_reset_storage_all (params) (returns void))

  ; Generic storage for compiler-owned surface semantic facts. Type values are
  ; opaque structured graph references; host storage never assigns type meaning.
  (extern weave_surface_module_use_legacy (params) (returns i32))
  (extern weave_surface_module_begin
    (params (source ptr) (start i64) (len i64)) (returns i32))
  (extern weave_surface_module_select
    (params (source ptr) (start i64) (len i64)) (returns i32))
  (extern weave_surface_module_add_export
    (params (source ptr) (start i64) (len i64)) (returns i32))
  (extern weave_surface_module_add_import
    (params
      (source ptr)
      (module_start i64) (module_len i64)
      (symbol_start i64) (symbol_len i64))
    (returns i32))
  (extern weave_surface_module_export_status
    (params (source ptr) (start i64) (len i64)) (returns i32))
  (extern weave_surface_module_import_status
    (params
      (source ptr)
      (module_start i64) (module_len i64)
      (symbol_start i64) (symbol_len i64))
    (returns i32))
  (extern weave_surface_module_current_has_cycle (params) (returns i32))
  (extern weave_surface_symbol_begin
    (params (source ptr) (start i64) (len i64) (return_type i32))
    (returns i32))
  (extern weave_surface_symbol_add_parameter (params (type i32)) (returns i32))
  (extern weave_surface_symbol_return_type
    (params (source ptr) (start i64) (len i64)) (returns i32))
  (extern weave_surface_symbol_parameter_count
    (params (source ptr) (start i64) (len i64)) (returns i32))
  (extern weave_surface_symbol_parameter_type
    (params (source ptr) (start i64) (len i64) (parameter_index i32))
    (returns i32))
  (extern weave_surface_locals_reset (params) (returns void))
  (extern weave_surface_local_add
    (params (source ptr) (start i64) (len i64) (type i32)) (returns i32))
  (extern weave_surface_local_type
    (params (source ptr) (start i64) (len i64)) (returns i32))
  (extern weave_surface_local_count_get (params) (returns i32))
  (extern weave_surface_local_push
    (params (source ptr) (start i64) (len i64) (type i32)) (returns i32))
  (extern weave_surface_local_truncate (params (count i32)) (returns void))
  (extern weave_surface_match_temp_next (params) (returns i32))
  (extern weave_surface_match_write_temp
    (params (fd i32) (temp i32)) (returns void))
  (extern weave_surface_match_write_local_get
    (params (fd i32) (temp i32)) (returns void))
  (extern weave_surface_match_write_let_head
    (params (fd i32) (temp i32)) (returns void))
  (extern weave_surface_match_write_cond
    (params (fd i32) (prefix ptr) (temp i32) (tag i32)) (returns void))
  (extern weave_surface_match_write_open_if (params (fd i32)) (returns void))
  (extern weave_surface_match_write_then_do (params (fd i32)) (returns void))
  (extern weave_surface_match_write_else_do (params (fd i32)) (returns void))
  (extern weave_surface_match_write_close2 (params (fd i32)) (returns void))
  (extern weave_surface_match_write_close3 (params (fd i32)) (returns void))
  (extern weave_surface_match_write_dummy
    (params (fd i32) (wir_type ptr)) (returns void))
  (extern weave_surface_try_write_set_ok
    (params
      (fd i32) (dest ptr) (dest_len i64)
      (prefix ptr) (wir_type ptr) (temp i32))
    (returns void))
  (extern weave_surface_try_write_return_err
    (params
      (fd i32) (prefix ptr) (wir_type ptr) (temp i32))
    (returns void))
  (extern weave_surface_set_return_type (params (type i32)) (returns void))
  (extern weave_surface_get_return_type (params) (returns i32))
  (extern weave_surface_set_error (params) (returns void))
  (extern weave_surface_has_error (params) (returns i32))
  (extern weave_surface_module_current_name (params) (returns ptr))
  (extern weave_surface_type_params_reset (params) (returns void))
  (extern weave_surface_type_param_push
    (params
      (source ptr) (start i64) (length i64) (type i32) (ordinal i32))
    (returns i32))
  (extern weave_surface_type_param_lookup
    (params (source ptr) (start i64) (length i64))
    (returns i32))
  (extern weave_surface_type_param_count_current (params) (returns i32))
  (extern weave_surface_symbol_set_type_param_count
    (params (count i32)) (returns i32))
  (extern weave_surface_symbol_type_param_count
    (params (source ptr) (start i64) (length i64)) (returns i32))
  (extern weave_surface_struct_set_type_param_count_storage
    (params (flat_type i32) (count i32)) (returns i32))
  (extern weave_surface_struct_type_param_count_storage
    (params (flat_type i32)) (returns i32))
  (extern weave_surface_set_current_source_path
    (params (path ptr)) (returns void))
  (extern weave_surface_get_current_source_path (params) (returns ptr))
  (extern weave_surface_symbol_type_param_type
    (params (source ptr) (start i64) (length i64) (parameter_index i32))
    (returns i32))
  (extern weave_surface_symbol_source_path
    (params (source ptr) (start i64) (length i64)) (returns ptr))
  (extern weave_surface_spec_count (params) (returns i32))
  (extern weave_surface_spec_intern
    (params
      (source ptr) (start i64) (length i64) (key ptr) (spec_name ptr))
    (returns i32))
  (extern weave_surface_spec_name (params (index i32)) (returns ptr))
  (extern weave_surface_spec_generic_name (params (index i32)) (returns ptr))
  (extern weave_surface_spec_source_path (params (index i32)) (returns ptr))
  (extern weave_surface_spec_emitted (params (index i32)) (returns i32))
  (extern weave_surface_spec_mark_emitted (params (index i32)) (returns void))
  (extern weave_surface_spec_set_args
    (params (index i32) (args ptr) (count i32)) (returns i32))
  (extern weave_surface_spec_arg_count (params (index i32)) (returns i32))
  (extern weave_surface_spec_arg_type
    (params (index i32) (arg_index i32)) (returns i32))
  (extern weave_surface_enum_define
    (params (source ptr) (start i64) (length i64)) (returns i32))
  (extern weave_surface_enum_set_graph_type
    (params (index i32) (graph_type i32)) (returns i32))
  (extern weave_surface_enum_set_type_param_count
    (params (index i32) (count i32)) (returns i32))
  (extern weave_surface_enum_add_variant
    (params
      (index i32) (source ptr) (start i64) (length i64) (payload_type i32))
    (returns i32))
  (extern weave_surface_enum_index
    (params (source ptr) (start i64) (length i64)) (returns i32))
  (extern weave_surface_enum_lookup
    (params (source ptr) (start i64) (length i64)) (returns i32))
  (extern weave_surface_enum_is_type (params (graph_type i32)) (returns i32))
  (extern weave_surface_enum_from_type (params (graph_type i32)) (returns i32))
  (extern weave_surface_enum_name (params (index i32)) (returns ptr))
  (extern weave_surface_enum_source_path (params (index i32)) (returns ptr))
  (extern weave_surface_enum_type_param_count (params (index i32)) (returns i32))
  (extern weave_surface_enum_variant_count (params (index i32)) (returns i32))
  (extern weave_surface_enum_find_variant
    (params (index i32) (source ptr) (start i64) (length i64))
    (returns i32))
  (extern weave_surface_enum_variant_tag
    (params (index i32) (variant i32)) (returns i32))
  (extern weave_surface_enum_variant_payload
    (params (index i32) (variant i32)) (returns i32))
  (extern weave_surface_enum_variant_name
    (params (index i32) (variant i32)) (returns ptr))
  (extern weave_surface_enum_spec_count (params) (returns i32))
  (extern weave_surface_enum_spec_intern
    (params
      (source ptr) (start i64) (length i64) (key ptr) (spec_name ptr))
    (returns i32))
  (extern weave_surface_enum_spec_name (params (index i32)) (returns ptr))
  (extern weave_surface_enum_spec_generic_name
    (params (index i32)) (returns ptr))
  (extern weave_surface_enum_spec_source_path
    (params (index i32)) (returns ptr))
  (extern weave_surface_enum_spec_emitted (params (index i32)) (returns i32))
  (extern weave_surface_enum_spec_mark_emitted
    (params (index i32)) (returns void))
  (extern weave_surface_enum_spec_set_args
    (params (index i32) (args ptr) (count i32)) (returns i32))
  (extern weave_surface_enum_spec_arg_count (params (index i32)) (returns i32))
  (extern weave_surface_enum_spec_arg_type
    (params (index i32) (arg_index i32)) (returns i32))
  (extern weave_surface_enum_write_constructor
    (params
      (fd i32) (prefix ptr) (variant_name ptr) (tag i32) (store_head ptr))
    (returns void))
  (extern weave_surface_enum_write_tag_fn
    (params (fd i32) (prefix ptr)) (returns void))
  (extern weave_surface_enum_write_payload_fn
    (params
      (fd i32) (prefix ptr) (variant_name ptr) (load_head ptr) (wir_type ptr))
    (returns void))
)
