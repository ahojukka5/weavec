; SPDX-License-Identifier: Apache-2.0
; struct_extern.weave — host storage for nominal surface struct facts

(program
  (name "struct_extern")
  (version "0.1")

  (extern weave_surface_struct_type_or_declare
    (params (source ptr) (start i64) (length i64))
    (returns i32))
  (extern weave_surface_struct_define
    (params (source ptr) (start i64) (length i64))
    (returns i32))
  (extern weave_surface_struct_add_field
    (params
      (struct_type i32) (source ptr) (start i64) (length i64)
      (field_type i32))
    (returns i32))
  (extern weave_surface_struct_is_type
    (params (type i32))
    (returns i32))
  (extern weave_surface_struct_is_defined
    (params (type i32))
    (returns i32))
  (extern weave_surface_struct_name
    (params (type i32))
    (returns ptr))
  (extern weave_surface_struct_field_count
    (params (type i32))
    (returns i32))
  (extern weave_surface_struct_field_type
    (params (type i32) (field_index i32))
    (returns i32))
  (extern weave_surface_struct_field_name
    (params (type i32) (field_index i32))
    (returns ptr))
  (extern weave_surface_struct_find_field
    (params
      (type i32) (source ptr) (start i64) (length i64))
    (returns i32))
)
