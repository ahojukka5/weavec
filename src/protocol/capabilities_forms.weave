      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "module") (const_i64 0) (const_string_ptr "one") (const_string_ptr "identifier"))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "symbols") (const_i64 1) (const_string_ptr "one-or-more") (const_string_ptr "identifier-list"))
      (call_void cap_form_finish (param_get cf_writer))

      (call_void cap_form_begin (param_get cf_writer) (const_string_ptr "export")
        (const_string_ptr "experimental") (const_i64 1) (const_i64 -1)
        (const_string_ptr "explicit") (const_string_ptr "modules") (const_null))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "symbols") (const_i64 0) (const_string_ptr "one-or-more") (const_string_ptr "identifier"))
      (call_void cap_form_finish (param_get cf_writer))

      (call_void cap_form_begin (param_get cf_writer) (const_string_ptr "name")
        (const_string_ptr "canonical") (const_i64 1) (const_i64 1)
        (const_string_ptr "none") (const_null) (const_null))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "value") (const_i64 0) (const_string_ptr "one") (const_string_ptr "string"))
      (call_void cap_form_finish (param_get cf_writer))

      (call_void cap_form_begin (param_get cf_writer) (const_string_ptr "version")
        (const_string_ptr "canonical") (const_i64 1) (const_i64 1)
