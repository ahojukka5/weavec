; SPDX-License-Identifier: Apache-2.0
; Canonical surface-form capability registry.

(program
  (name "capabilities-forms")
  (version "0.1")

  (fn cap_form_begin
    (params
      (cf_writer ptr) (cf_head ptr) (cf_status ptr)
      (cf_min i64) (cf_max i64) (cf_type_info ptr)
      (cf_feature ptr) (cf_replacement ptr))
    (returns void)
    (do
      (call_i32 weave_host_json_object_begin (param_get cf_writer))
      (call_void protocol_json_key_string (param_get cf_writer)
        (const_string_ptr "head") (param_get cf_head))
      (call_void protocol_json_key_string (param_get cf_writer)
        (const_string_ptr "status") (param_get cf_status))
      (call_i32 weave_host_json_key (param_get cf_writer) (const_string_ptr "arity"))
      (call_i32 weave_host_json_object_begin (param_get cf_writer))
      (call_void protocol_json_key_i64 (param_get cf_writer)
        (const_string_ptr "min_children") (param_get cf_min))
      (call_i32 weave_host_json_key (param_get cf_writer) (const_string_ptr "max_children"))
      (if
        (condition (lt_i64 (param_get cf_max) (const_i64 0)))
        (then (do (call_void protocol_json_null (param_get cf_writer))))
        (else (do (call_void protocol_json_i64 (param_get cf_writer) (param_get cf_max)))))
      (call_i32 weave_host_json_object_end (param_get cf_writer))
      (call_void protocol_json_key_string (param_get cf_writer)
        (const_string_ptr "type_information") (param_get cf_type_info))
      (call_void protocol_json_key_nullable_string (param_get cf_writer)
        (const_string_ptr "feature") (param_get cf_feature))
      (call_void protocol_json_key_nullable_string (param_get cf_writer)
        (const_string_ptr "canonical_replacement") (param_get cf_replacement))
      (call_i32 weave_host_json_key (param_get cf_writer) (const_string_ptr "roles"))
      (call_i32 weave_host_json_array_begin (param_get cf_writer))
      (return_void)))

  (fn cap_write_role
    (params
      (cf_writer ptr) (cf_name ptr) (cf_position i64)
      (cf_cardinality ptr) (cf_kind ptr))
    (returns void)
    (do
      (call_i32 weave_host_json_object_begin (param_get cf_writer))
      (call_void protocol_json_key_string (param_get cf_writer)
        (const_string_ptr "name") (param_get cf_name))
      (call_void protocol_json_key_i64 (param_get cf_writer)
        (const_string_ptr "position") (param_get cf_position))
      (call_void protocol_json_key_string (param_get cf_writer)
        (const_string_ptr "cardinality") (param_get cf_cardinality))
      (call_void protocol_json_key_string (param_get cf_writer)
        (const_string_ptr "kind") (param_get cf_kind))
      (call_i32 weave_host_json_object_end (param_get cf_writer))
      (return_void)))

  (fn cap_form_finish
    (params (cf_writer ptr))
    (returns void)
    (do
      (call_i32 weave_host_json_array_end (param_get cf_writer))
      (call_i32 weave_host_json_object_end (param_get cf_writer))
      (return_void)))

  (fn capabilities_write_forms
    (params (cf_writer ptr))
    (returns void)
    (do
      (call_i32 weave_host_json_array_begin (param_get cf_writer))

      (call_void cap_form_begin (param_get cf_writer) (const_string_ptr "program")
        (const_string_ptr "canonical") (const_i64 2) (const_i64 -1)
        (const_string_ptr "none") (const_null) (const_null))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "name") (const_i64 0) (const_string_ptr "one") (const_string_ptr "name"))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "version") (const_i64 1) (const_string_ptr "one") (const_string_ptr "version"))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "declarations") (const_i64 2) (const_string_ptr "zero-or-more") (const_string_ptr "declaration"))
      (call_void cap_form_finish (param_get cf_writer))

      (call_void cap_form_begin (param_get cf_writer) (const_string_ptr "module")
        (const_string_ptr "experimental") (const_i64 1) (const_i64 -1)
        (const_string_ptr "explicit") (const_string_ptr "modules") (const_null))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "name") (const_i64 0) (const_string_ptr "one") (const_string_ptr "identifier"))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "items") (const_i64 1) (const_string_ptr "zero-or-more") (const_string_ptr "module-item"))
