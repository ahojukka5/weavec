      (call_void cap_form_finish (param_get cf_writer))

      (call_void cap_form_begin (param_get cf_writer) (const_string_ptr "match")
        (const_string_ptr "experimental") (const_i64 3) (const_i64 -1)
        (const_string_ptr "semantic") (const_string_ptr "exhaustive-match") (const_null))
      (call_void cap_write_role (param_get cf_writer) (const_string_ptr "enum") (const_i64 0) (const_string_ptr "one") (const_string_ptr "identifier"))
