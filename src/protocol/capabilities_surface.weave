; Surface capability facts that do not depend on AST/runtime storage.

(program
  (name "capabilities-surface")
  (version "0.1")

  (fn cap_write_string_primitive_types
    (params (cs_writer ptr))
    (returns void)
    (do
      (call_i32 weave_host_json_array_begin (param_get cs_writer))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "i32"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "i64"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "f32"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "f64"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "bool"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "ptr"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "void"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "Qubit"))
      (call_i32 weave_host_json_array_end (param_get cs_writer))
      (return_void)))

  (fn cap_operator_begin
    (params (cs_writer ptr) (cs_id ptr))
    (returns void)
    (do
      (call_i32 weave_host_json_object_begin (param_get cs_writer))
      (call_void protocol_json_key_string
        (param_get cs_writer) (const_string_ptr "id") (param_get cs_id))
      (return_void)))

  (fn cap_operator_finish
    (params (cs_writer ptr) (cs_arity i64) (cs_result ptr))
    (returns void)
    (do
      (call_void protocol_json_key_i64
        (param_get cs_writer) (const_string_ptr "arity") (param_get cs_arity))
      (call_void protocol_json_key_string
        (param_get cs_writer) (const_string_ptr "result") (param_get cs_result))
      (call_i32 weave_host_json_object_end (param_get cs_writer))
      (return_void)))

