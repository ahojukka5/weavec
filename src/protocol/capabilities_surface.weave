  (fn capabilities_write_families
    (params (cs_writer ptr))
    (returns void)
    (do
      (call_i32 weave_host_json_array_begin (param_get cs_writer))
      (call_void cap_family_begin (param_get cs_writer)
        (const_string_ptr "typed-calls") (const_string_ptr "compatibility")
        (const_string_ptr "call_<return-type>") (const_string_ptr "call") (const_string_ptr "explicit"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "call_i32"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "call_i64"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "call_f32"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "call_f64"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "call_bool"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "call_ptr"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "call_void"))
      (call_void cap_family_finish (param_get cs_writer))

      (call_void cap_family_begin (param_get cs_writer)
        (const_string_ptr "typed-constants") (const_string_ptr "compatibility")
        (const_string_ptr "const_<type>") (const_string_ptr "contextual literal") (const_string_ptr "explicit"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "const_i32"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "const_i64"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "const_f32"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "const_f64"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "const_bool"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "const_null"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "const_string_ptr"))
      (call_void cap_family_finish (param_get cs_writer))

      (call_void cap_family_begin (param_get cs_writer)
        (const_string_ptr "typed-operators") (const_string_ptr "compatibility")
        (const_string_ptr "<operation>_<type>") (const_string_ptr "op") (const_string_ptr "explicit"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "arithmetic:numeric"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "bitwise:integer"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "comparison:numeric-or-pointer-equality"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "boolean:bool"))
      (call_void cap_family_finish (param_get cs_writer))

      (call_void cap_family_begin (param_get cs_writer)
        (const_string_ptr "explicit-casts") (const_string_ptr "compatibility")
        (const_string_ptr "cast_<source>_to_<target>") (const_string_ptr "cast") (const_string_ptr "explicit"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "i64->i32"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "i32->i64"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "i32->f32"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "i32->f64"))
