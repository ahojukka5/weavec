      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "f64->f32"))
      (call_void cap_family_finish (param_get cs_writer))

      (call_void cap_family_begin (param_get cs_writer)
        (const_string_ptr "explicit-binding-access") (const_string_ptr "compatibility")
        (const_string_ptr "{param_get,local_get}") (const_string_ptr "bare identifier") (const_string_ptr "semantic"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "param_get"))
      (call_void protocol_json_string (param_get cs_writer) (const_string_ptr "local_get"))
      (call_void cap_family_finish (param_get cs_writer))

      (call_void cap_family_begin (param_get cs_writer)
        (const_string_ptr "generated-struct-abi") (const_string_ptr "compatibility")
        (const_string_ptr "{TYPE_new,TYPE_get_FIELD,TYPE_set_FIELD}")
        (const_string_ptr "{new,field-get,field-set}") (const_string_ptr "semantic"))
      (call_void cap_family_finish (param_get cs_writer))

      (call_void cap_family_begin (param_get cs_writer)
        (const_string_ptr "wir-shaped-low-level") (const_string_ptr "compatibility")
        (const_string_ptr "WIR-v2 expression or statement head")
        (const_null) (const_string_ptr "explicit"))
      (call_void cap_family_finish (param_get cs_writer))

      (call_i32 weave_host_json_array_end (param_get cs_writer))
      (return_void)))
)
