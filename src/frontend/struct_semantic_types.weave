; SPDX-License-Identifier: Apache-2.0
; struct_semantic_types.weave — semantic struct lowering slice

(program
  (name "struct_semantic_types")
  (version "0.1")

  (fn sst_type_code
      (params (sst_tree ptr) (sst_source ptr) (sst_type_node i64))
      (returns i32)
      (do
        (let sst_builtin i32 (call_i32 surface_type_code
          (param_get sst_tree) (param_get sst_source) (param_get sst_type_node)))
        (if
          (condition (ne_i32 (local_get sst_builtin) (call_i32 surface_type_unknown)))
          (then (do (return (local_get sst_builtin))))
          (else (do)))
        (if
          (condition (eq_i32 (call_i32 surface_node_is_ident
            (param_get sst_tree) (param_get sst_type_node)) (const_i32 0)))
          (then (do (return (call_i32 surface_type_unknown))))
          (else (do)))
        (return (call_i32 weave_surface_struct_type_or_declare
          (param_get sst_source)
          (call_i64 node_text_start (param_get sst_tree) (param_get sst_type_node))
          (call_i64 node_text_len (param_get sst_tree) (param_get sst_type_node))))))

  (fn sst_type_name_ptr
      (params (sst_type i32))
      (returns ptr)
      (do
        (return (call_ptr weave_semantic_type_display (param_get sst_type)))))

  (fn sst_emit_type_name
      (params (sst_fd i32) (sst_type i32))
      (returns void)
      (do
        ; Human diagnostics are written to stderr and keep the source spelling.
        ; Generated WIR helper references use the compiler-owned module name.
        (if
          (condition (and_bool
            (ne_i32 (param_get sst_fd) (const_i32 2))
            (ne_i32 (call_i32 weave_surface_struct_is_type
              (param_get sst_type)) (const_i32 0))))
          (then (do
            (let sst_helper_name ptr (call_ptr weave_surface_struct_wir_name
              (param_get sst_type)))
            (if
              (condition (ne_ptr (local_get sst_helper_name) (const_null)))
              (then (do
                (call_void write_cstr
                  (param_get sst_fd) (local_get sst_helper_name))
                (return_void)))
              (else (do)))))
          (else (do)))
        (let sst_name ptr (call_ptr sst_type_name_ptr (param_get sst_type)))
        (if
          (condition (ne_ptr (local_get sst_name) (const_null)))
          (then (do (call_void write_cstr (param_get sst_fd) (local_get sst_name))))
          (else (do (call_void write_cstr
            (param_get sst_fd) (const_string_ptr "unknown")))))
        (return_void)))

  (fn sst_emit_struct_wir_name
      (params (sst_fd i32) (sst_type i32))
      (returns void)
      (do
        (let sst_wir_name ptr (call_ptr weave_surface_struct_wir_name
          (param_get sst_type)))
        (if
          (condition (ne_ptr (local_get sst_wir_name) (const_null)))
          (then (do
            (call_void write_cstr (param_get sst_fd) (local_get sst_wir_name))))
          (else (do
            (call_void write_cstr
              (param_get sst_fd) (const_string_ptr "unknown")))))
        (return_void)))

  (fn sst_emit_wir_type
      (params (sst_fd i32) (sst_type i32))
      (returns void)
      (do
        (call_void write_cstr
          (param_get sst_fd)
          (call_ptr weave_semantic_type_wir (param_get sst_type)))
        (return_void)))

  (fn sst_emit_declared_wir_type
      (params
        (sst_fd i32) (sst_source ptr) (sst_tree ptr)
        (sst_type_node i64) (sst_type i32))
      (returns void)
      (do
        ; Qubit is semantically the graph's i64 primitive today, but the source
        ; lowering remains observable compiler evidence. Preserve that evidence
        ; while letting the graph-backed type decide the emitted WIR spelling.
        (if
          (condition (ne_i32 (call_i32 ident_equals
            (param_get sst_tree) (param_get sst_source) (param_get sst_type_node)
            (const_string_ptr "Qubit") (const_i64 5)) (const_i32 0)))
          (then (do
            (call_void trace_lower_qubit_to_i64
              (param_get sst_source) (param_get sst_tree)
              (param_get sst_type_node) (const_i64 -1))))
          (else (do)))
        (call_void sst_emit_wir_type (param_get sst_fd) (param_get sst_type))
        (return_void)))

  (fn sst_types_compatible
      (params (sst_expected i32) (sst_actual i32))
      (returns i32)
      (do
        (return (call_i32 weave_semantic_types_compatible
          (param_get sst_expected) (param_get sst_actual)))))
)
