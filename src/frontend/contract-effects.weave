; SPDX-License-Identifier: Apache-2.0
; contract-effects.weave — (pure) / (no_alloc) / (deterministic) effect contract checks

(program
  (name "contract-effects")
  (version "0.1")

  (fn fn_has_marker_clause
    (params (tree ptr) (source ptr) (fn_node i64) (head ptr) (head_len i64))
    (returns i32)
    (do
      (let returns_node i64 (call_i64 nth_child (param_get tree) (param_get fn_node) (const_i64 3)))
      (let child i64 (call_i64 node_next_sibling (param_get tree) (local_get returns_node)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (and_bool
                  (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                    (param_get head) (param_get head_len)) (const_i32 0))
                  (eq_i64 (call_i64 count_children (param_get tree) (local_get child)) (const_i64 1))))
                (then (do (return (const_i32 1))))
                (else (do)))))
            (else (do)))
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "do") (const_i64 2)) (const_i32 0)))
                (then (do (return (const_i32 0))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn fn_has_pure_clause
    (params (tree ptr) (source ptr) (fn_node i64))
    (returns i32)
    (do
      (return (call_i32 fn_has_marker_clause
        (param_get tree) (param_get source) (param_get fn_node)
        (const_string_ptr "pure") (const_i64 4)))))

  (fn fn_has_no_alloc_clause
    (params (tree ptr) (source ptr) (fn_node i64))
    (returns i32)
    (do
      (return (call_i32 fn_has_marker_clause
        (param_get tree) (param_get source) (param_get fn_node)
        (const_string_ptr "no_alloc") (const_i64 8)))))

  (fn fn_has_deterministic_clause
    (params (tree ptr) (source ptr) (fn_node i64))
    (returns i32)
    (do
      (return (call_i32 fn_has_marker_clause
        (param_get tree) (param_get source) (param_get fn_node)
        (const_string_ptr "deterministic") (const_i64 13)))))

  (fn fn_declares_any_effect_clause
    (params (tree ptr) (source ptr) (fn_node i64))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 fn_has_pure_clause (param_get tree) (param_get source) (param_get fn_node)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 fn_has_no_alloc_clause (param_get tree) (param_get source) (param_get fn_node)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 fn_has_deterministic_clause (param_get tree) (param_get source) (param_get fn_node)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn effect_is_effect_marker_head
    (params (tree ptr) (source ptr) (child i64))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 node_kind (param_get tree) (param_get child)) (call_i32 node_list)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get child)
          (const_string_ptr "pure") (const_i64 4)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get child)
          (const_string_ptr "no_alloc") (const_i64 8)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get child)
          (const_string_ptr "deterministic") (const_i64 13)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn emit_malformed_effect_clause_error
    (params (head ptr))
    (returns void)
    (do
      (call_void write_cstr (const_i32 2) (const_string_ptr "weavec: malformed effect clause: "))
      (call_void write_cstr (const_i32 2) (param_get head))
      (call_void write_cstr (const_i32 2) (const_string_ptr " must have no arguments"))
      (call_void write_byte (const_i32 2) (const_i32 10))
      (return_void)))

  (fn fn_validate_effect_clauses
    (params (tree ptr) (source ptr) (fn_node i64))
    (returns i32)
    (do
      (let returns_node i64 (call_i64 nth_child (param_get tree) (param_get fn_node) (const_i64 3)))
      (let child i64 (call_i64 node_next_sibling (param_get tree) (local_get returns_node)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 effect_is_effect_marker_head
              (param_get tree) (param_get source) (local_get child)) (const_i32 0)))
            (then (do
              (if
                (condition (gt_i64 (call_i64 count_children (param_get tree) (local_get child)) (const_i64 1)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                      (const_string_ptr "pure") (const_i64 4)) (const_i32 0)))
                    (then (do
                      (call_void emit_malformed_effect_clause_error (const_string_ptr "pure"))
                      (return (const_i32 1))))
                    (else (do)))
                  (if
                    (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                      (const_string_ptr "no_alloc") (const_i64 8)) (const_i32 0)))
                    (then (do
                      (call_void emit_malformed_effect_clause_error (const_string_ptr "no_alloc"))
                      (return (const_i32 1))))
                    (else (do
                      (call_void emit_malformed_effect_clause_error (const_string_ptr "deterministic"))
                      (return (const_i32 1)))))))
                (else (do)))))
            (else (do)))
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "do") (const_i64 2)) (const_i32 0)))
                (then (do (return (const_i32 0))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn validate_program_effect_clauses
    (params (tree ptr) (source ptr) (first_decl i64))
    (returns i32)
    (do
      (let child i64 (param_get first_decl))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
                (then (do
                  (let st i32 (call_i32 fn_validate_effect_clauses (param_get tree) (param_get source) (local_get child)))
                  (if
                    (condition (ne_i32 (local_get st) (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn effect_is_alloc_name
    (params (tree ptr) (source ptr) (name_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get name_node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "malloc") (const_i64 6)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "realloc") (const_i64 7)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn effect_is_io_name
    (params (tree ptr) (source ptr) (name_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get name_node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "puts") (const_i64 4)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "putchar") (const_i64 7)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "weave_rt_write_file") (const_i64 20)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn effect_is_nondeterministic_name
    (params (tree ptr) (source ptr) (name_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get name_node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "weave_rt_read_file") (const_i64 19)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "read") (const_i64 4)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "open") (const_i64 4)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn effect_is_known_runtime_name
    (params (tree ptr) (source ptr) (name_node i64))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 effect_is_alloc_name (param_get tree) (param_get source) (param_get name_node)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 effect_is_io_name (param_get tree) (param_get source) (param_get name_node)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 effect_is_nondeterministic_name (param_get tree) (param_get source) (param_get name_node)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (eq_i64 (param_get name_node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "free") (const_i64 4)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "weave_rt_fatal") (const_i64 15)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn effect_collect_callees_node
    (params (runtime_ctx ptr) (unknown_ctx ptr)
      (tree ptr) (source ptr) (node i64) (first_decl i64))
    (returns void)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 explain_node_is_call (param_get tree) (param_get source) (param_get node)) (const_i32 0)))
        (then (do
          (let callee i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
          (if
            (condition (eq_i32 (call_i32 explain_is_local_fn_name
              (param_get tree) (param_get source) (param_get first_decl) (local_get callee)) (const_i32 0)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 effect_is_known_runtime_name
                  (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                (then (do
                  (if
                    (condition (eq_i32 (call_i32 explain_ctx_contains
                      (param_get runtime_ctx) (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                    (then (do
                      (call_void explain_ctx_add (param_get runtime_ctx) (local_get callee))))
                    (else (do)))))
                (else (do)))))
            (else (do)))
          (if
            (condition (eq_i32 (call_i32 explain_is_local_fn_name
              (param_get tree) (param_get source) (param_get first_decl) (local_get callee)) (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (call_i32 effect_is_known_runtime_name
                  (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                (then (do
                  (if
                    (condition (eq_i32 (call_i32 explain_ctx_contains
                      (param_get unknown_ctx) (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                    (then (do
                      (call_void explain_ctx_add (param_get unknown_ctx) (local_get callee))))
                    (else (do)))))
                (else (do)))))
            (else (do)))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (call_void effect_collect_callees_node
                (param_get runtime_ctx) (param_get unknown_ctx)
                (param_get tree) (param_get source) (local_get child) (param_get first_decl))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))))
        (else (do)))
      (return_void)))

  (fn effect_collect_local_callees_node
    (params (local_ctx ptr) (tree ptr) (source ptr) (node i64) (first_decl i64))
    (returns void)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 explain_node_is_call (param_get tree) (param_get source) (param_get node)) (const_i32 0)))
        (then (do
          (let callee i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
          (if
            (condition (ne_i32 (call_i32 explain_is_local_fn_name
              (param_get tree) (param_get source) (param_get first_decl) (local_get callee)) (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (call_i32 explain_ctx_contains
                  (param_get local_ctx) (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                (then (do
                  (call_void explain_ctx_add (param_get local_ctx) (local_get callee))))
                (else (do)))))
            (else (do)))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (call_void effect_collect_local_callees_node
                (param_get local_ctx) (param_get tree) (param_get source) (local_get child) (param_get first_decl))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))))
        (else (do)))
      (return_void)))

  ; Tri-state join: 0 verified, 1 failed, 2 unknown (failed dominates unknown).
  (fn effect_max_severity
    (params (a i32) (b i32))
    (returns i32)
    (do
      (if
        (condition (or_bool
          (eq_i32 (param_get a) (const_i32 1))
          (eq_i32 (param_get b) (const_i32 1))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (eq_i32 (param_get a) (const_i32 2))
          (eq_i32 (param_get b) (const_i32 2))))
        (then (do (return (const_i32 2))))
        (else (do)))
      (return (const_i32 0))))

  (fn effect_max_purity
    (params (a i32) (b i32))
    (returns i32)
    (do
      (return (call_i32 effect_max_severity (param_get a) (param_get b)))))

  (fn effect_runtime_ctx_has_nondeterministic
    (params (tree ptr) (source ptr) (runtime_ctx ptr))
    (returns i32)
    (do
      (let n i64 (call_i64 explain_ctx_count (param_get runtime_ctx)))
      (let i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get i) (local_get n)))
        (do
          (let name i64 (call_i64 explain_ctx_name_at (param_get runtime_ctx) (local_get i)))
          (if
            (condition (ne_i32 (call_i32 effect_is_nondeterministic_name
              (param_get tree) (param_get source) (local_get name)) (const_i32 0)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (set i (add_i64 (local_get i) (const_i64 1)))))
      (return (const_i32 0))))

  ; Returns 0 = deterministic, 1 = failed, 2 = unknown
  (fn effect_determinism_class
    (params (tree ptr) (source ptr) (runtime_ctx ptr) (unknown_ctx ptr))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 effect_runtime_ctx_has_nondeterministic
          (param_get tree) (param_get source) (param_get runtime_ctx)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (gt_i64 (call_i64 explain_ctx_count (param_get unknown_ctx)) (const_i64 0)))
        (then (do (return (const_i32 2))))
        (else (do)))
      (return (const_i32 0))))

  ; Returns 0 = no allocation, 1 = allocates, 2 = unknown
  (fn effect_alloc_class
    (params (allocations i64) (unknown_ctx ptr))
    (returns i32)
    (do
      (if
        (condition (gt_i64 (param_get allocations) (const_i64 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (gt_i64 (call_i64 explain_ctx_count (param_get unknown_ctx)) (const_i64 0)))
        (then (do (return (const_i32 2))))
        (else (do)))
      (return (const_i32 0))))

  (fn effect_count_table_decls
    (params (tree ptr) (source ptr) (first_decl i64))
    (returns i64)
    (do
      (let n i64 (const_i64 0))
      (let child i64 (param_get first_decl))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
                (then (do (set n (add_i64 (local_get n) (const_i64 1)))))
                (else (do)))))
            (else (do)))
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (and_bool
                  (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                    (const_string_ptr "entry") (const_i64 5)) (const_i32 0))
                  (gt_i64 (call_i64 count_children (param_get tree) (local_get child)) (const_i64 2))))
                (then (do (set n (add_i64 (local_get n) (const_i64 1)))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (local_get n))))

  (fn effect_table_entry_ptr
    (params (table ptr) (index i64))
    (returns ptr)
    (do
      (return (ptr_add (param_get table) (add_i64 (const_i64 8) (mul_i64 (param_get index) (const_i64 48)))))))

  (fn effect_table_fill_direct
    (params (row ptr) (tree ptr) (source ptr) (decl_node i64) (first_decl i64))
    (returns void)
    (do
      (store_i64 (param_get row) (param_get decl_node))
      (let do_node i64 (call_i64 fn_find_do_child (param_get tree) (param_get source) (param_get decl_node)))
      (let allocations i64 (const_i64 0))
      (let runtime_ctx ptr (call_ptr explain_ctx_new))
      (let unknown_ctx ptr (call_ptr explain_ctx_new))
      (let local_ctx ptr (call_ptr explain_ctx_new))
      (if
        (condition (ne_i64 (local_get do_node) (const_i64 -1)))
        (then (do
          (set allocations (call_i64 count_allocations_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (call_void effect_collect_callees_node
            (local_get runtime_ctx) (local_get unknown_ctx)
            (param_get tree) (param_get source) (local_get do_node) (param_get first_decl))
          (call_void effect_collect_local_callees_node
            (local_get local_ctx) (param_get tree) (param_get source) (local_get do_node) (param_get first_decl))))
        (else (do)))
