      (if
        (condition (eq_i32 (local_get purity) (const_i32 1)))
        (then (do (set label (const_string_ptr "impure"))))
        (else (do)))
      (if
        (condition (eq_i32 (local_get purity) (const_i32 2)))
        (then (do (set label (const_string_ptr "unknown"))))
        (else (do)))
      (call_void write_json_string_cstr (param_get fd) (local_get label))
      (return_void)))

  (fn json_emit_audit_effect_fields
    (params (fd i32) (source ptr) (tree ptr) (fn_node i64) (effect_table ptr))
    (returns void)
    (do
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "effect_contracts"))
      (call_void json_emit_effect_contracts_object
        (param_get fd) (param_get source) (param_get tree) (param_get fn_node) (param_get effect_table))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "effect_reasons"))
      (call_void json_emit_effect_reasons_array
        (param_get fd) (param_get source) (param_get tree) (param_get fn_node) (param_get effect_table))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "purity"))
      (call_void json_emit_purity_field (param_get fd) (param_get effect_table) (param_get fn_node))
      (return_void)))

  (fn explain_program_audit_json
    (params (fd i32) (source ptr) (tree ptr))
    (returns i32)
    (do
      (let first_decl i64 (call_i64 program_first_decl (param_get tree) (param_get source)))
      (let effect_table ptr (call_ptr effect_table_build
        (param_get tree) (param_get source) (local_get first_decl)))
      (let status i32 (const_i32 0))
      (call_void weave_audit_json_set_table (local_get effect_table))
      (set status (call_i32 explain_program_json (param_get fd) (param_get source) (param_get tree)))
      (call_void weave_audit_json_set_table (const_null))
      (call_void effect_table_free (local_get effect_table))
      (return (local_get status)))))
