; interp_text.weave — WIR text emitted by string interpolation lowering
;
; interp.weave assembles interpolation from these writers, and this module
; also emits the __weave_interp_* runtime helpers that the lowered program
; calls. They were C string helpers in runtime/surface_symbols.c until the
; port (issue #432); nothing here touches the host.
;
; ipt_write_helpers emits the helper definitions verbatim. Its text is a WIR
; program, so it is written line by line rather than assembled, and the bytes
; are identical to what the C version produced.

(program
  (name "interp_text")
  (version "0.1")

  ; (const_string_ptr "")
  (fn ipt_write_empty
    (params (fd i32))
    (returns void)
    (do
      (call_void write_cstr
        (param_get fd) (const_string_ptr "(const_string_ptr \"\")"))
      (return_void)))

  (fn ipt_write_concat_open
    (params (fd i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd)
        (const_string_ptr "(call_ptr __weave_interp_concat "))
      (return_void)))

  (fn ipt_write_call_i32
    (params (fd i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd)
        (const_string_ptr "(call_ptr __weave_interp_i32 "))
      (return_void)))

  (fn ipt_write_call_i64
    (params (fd i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd)
        (const_string_ptr "(call_ptr __weave_interp_i64 "))
      (return_void)))

  (fn ipt_write_call_bool
    (params (fd i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd)
        (const_string_ptr "(call_ptr __weave_interp_bool "))
      (return_void)))

  (fn ipt_write_close
    (params (fd i32))
    (returns void)
    (do
      (call_void write_byte (param_get fd) (const_i32 41))
      (return_void)))

  (fn ipt_write_space
    (params (fd i32))
    (returns void)
    (do
      (call_void write_byte (param_get fd) (const_i32 32))
      (return_void)))

  ; The __weave_interp_* helper definitions, emitted only when interpolation
  ; was used. The caller owns that decision.
  (fn ipt_write_helpers
    (params (fd i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd)
        (const_string_ptr "    (fn __weave_interp_concat\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (params (left ptr) (right ptr))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (returns ptr)\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (do\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let li i64 (const_i64 0))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (while\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (ne_i32 (load_u8 (ptr_add (param_get left) (local_get li))) (const_i32 0)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (do (set li (add_i64 (local_get li) (const_i64 1)))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let ri i64 (const_i64 0))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (while\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (ne_i32 (load_u8 (ptr_add (param_get right) (local_get ri))) (const_i32 0)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (do (set ri (add_i64 (local_get ri) (const_i64 1)))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let out ptr (call_ptr malloc (add_i64 (add_i64 (local_get li) (local_get ri)) (const_i64 1))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let ci i64 (const_i64 0))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (while\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (lt_i64 (local_get ci) (local_get li)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (do\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (store_i8 (ptr_add (local_get out) (local_get ci)) (load_u8 (ptr_add (param_get left) (local_get ci))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (set ci (add_i64 (local_get ci) (const_i64 1)))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let cj i64 (const_i64 0))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (while\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (lt_i64 (local_get cj) (local_get ri)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (do\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (store_i8 (ptr_add (local_get out) (add_i64 (local_get li) (local_get cj))) (load_u8 (ptr_add (param_get right) (local_get cj))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (set cj (add_i64 (local_get cj) (const_i64 1)))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (store_i8 (ptr_add (local_get out) (add_i64 (local_get li) (local_get ri))) (const_i32 0))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (return (local_get out))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "    (fn __weave_interp_i64\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (params (value i64))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (returns ptr)\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (do\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (if\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (eq_i64 (param_get value) (const_i64 0)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (then (do (return (const_string_ptr \"0\"))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (else (do)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let n i64 (param_get value))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let neg i32 (const_i32 0))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (if\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (lt_i64 (local_get n) (const_i64 0)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (then (do\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (set neg (const_i32 1))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (set n (sub_i64 (const_i64 0) (local_get n)))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (else (do)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (if\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (lt_i64 (local_get n) (const_i64 0)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (then (do (return (const_string_ptr \"-9223372036854775808\"))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (else (do)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let digits i64 (const_i64 0))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let t i64 (local_get n))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (while\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (ne_i64 (local_get t) (const_i64 0)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (do\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (set digits (add_i64 (local_get digits) (const_i64 1)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (set t (div_i64 (local_get t) (const_i64 10)))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let total i64 (add_i64 (local_get digits) (cast_i32_to_i64 (local_get neg))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let out ptr (call_ptr malloc (add_i64 (local_get total) (const_i64 1))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (store_i8 (ptr_add (local_get out) (local_get total)) (const_i32 0))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (let pos i64 (local_get total))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (set t (local_get n))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (while\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (ne_i64 (local_get t) (const_i64 0)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (do\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (set pos (sub_i64 (local_get pos) (const_i64 1)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (store_i8 (ptr_add (local_get out) (local_get pos)) (add_i32 (const_i32 48) (cast_i64_to_i32 (mod_i64 (local_get t) (const_i64 10)))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "            (set t (div_i64 (local_get t) (const_i64 10)))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (if\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (ne_i32 (local_get neg) (const_i32 0)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (then (do (store_i8 (local_get out) (const_i32 45))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (else (do)))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (return (local_get out))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "    (fn __weave_interp_i32\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (params (value i32))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (returns ptr)\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (do (return (call_ptr __weave_interp_i64 (cast_i32_to_i64 (param_get value))))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "    (fn __weave_interp_bool\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (params (value bool))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (returns ptr)\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "      (do\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "        (if\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (condition (param_get value))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (then (do (return (const_string_ptr \"true\"))))\n"))
      (call_void write_cstr (param_get fd)
        (const_string_ptr "          (else (do (return (const_string_ptr \"false\")))))))\n"))
      (return_void))))
