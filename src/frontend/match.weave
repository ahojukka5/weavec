        (const_string_ptr "frontend.match.invalid")
        (call_i32 surface_type_unknown) (call_i32 surface_type_unknown)
        (const_i32 -1) (const_i32 -1) (const_i32 -1)
        (const_string_ptr "match") (const_i64 -1) (const_i32 0))
      (return (const_i32 1))))

