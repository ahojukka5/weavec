; if_expr.weave — expression-valued if
;
; (if (condition EXPR) (then EXPR) (else EXPR)) is a value only as a let
; initializer or a returned value. Else is required. Branch types must
; agree. Statement if, including optional else, is unchanged.

(program
  (name "if_expr")
  (version "0.1")

  (fn ie_error
    (params (tree ptr) (source ptr) (node i64) (detail ptr))
    (returns i32)
    (do
      (call_void surface_error_prefix (const_string_ptr "if"))
