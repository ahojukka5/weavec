        (param_get tree) (param_get node)))
      (set ie_child (call_i64 node_next_sibling
        (param_get tree) (local_get ie_child)))
      (while
        (condition (ne_i64 (local_get ie_child) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 head_equals
              (param_get tree) (param_get source) (local_get ie_child)
              (param_get ie_cname) (param_get ie_clen)) (const_i32 0)))
            (then (do (return (local_get ie_child))))
            (else (do)))
          (set ie_child (call_i64 node_next_sibling
            (param_get tree) (local_get ie_child)))))
      (return (const_i64 -1))))

  (fn ie_clause_body
    (params (tree ptr) (clause i64))
    (returns i64)
    (do
      (if
        (condition (eq_i64 (param_get clause) (const_i64 -1)))
        (then (do (return (const_i64 -1))))
        (else (do)))
      (if
        (condition (ne_i64 (call_i64 count_children
