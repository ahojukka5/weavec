; SPDX-License-Identifier: Apache-2.0
; surface_op_emit.weave — Canonical operator validation and WIR emission.
;
; This self-hosted frontend module emits only admitted WIR core-version-3 forms.

(program
  (name "surface_op_emit")
  (version "0.1")

  (fn surface_emit_canonical_op
    (params (sop_fd i32) (sop_source ptr) (sop_tree ptr) (sop_node i64))
    (returns void)
    (do
      (let sop_child_count i64 (call_i64 count_children
        (param_get sop_tree) (param_get sop_node)))
      (if
        (condition (lt_i64 (local_get sop_child_count) (const_i64 2)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "missing operator name"))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))
      (let sop_name_node i64 (call_i64 nth_child
        (param_get sop_tree) (param_get sop_node) (const_i64 1)))
      (if
        (condition (eq_i32 (call_i32 surface_node_is_ident
          (param_get sop_tree) (local_get sop_name_node)) (const_i32 0)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "operator name must be an identifier"))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))
      (let sop_is_arithmetic i32 (call_i32 sop_name_is_arithmetic
        (param_get sop_tree) (param_get sop_source) (local_get sop_name_node)))
      (let sop_is_bitwise i32 (call_i32 sop_name_is_bitwise
        (param_get sop_tree) (param_get sop_source) (local_get sop_name_node)))
      (let sop_is_comparison i32 (call_i32 sop_name_is_comparison
        (param_get sop_tree) (param_get sop_source) (local_get sop_name_node)))
      (let sop_is_bool_binary i32 (call_i32 sop_name_is_boolean_binary
        (param_get sop_tree) (param_get sop_source) (local_get sop_name_node)))
      (let sop_is_bool_unary i32 (call_i32 sop_name_is_boolean_unary
        (param_get sop_tree) (param_get sop_source) (local_get sop_name_node)))
      (if
        (condition (and_bool
          (eq_i32 (local_get sop_is_arithmetic) (const_i32 0))
          (and_bool
            (eq_i32 (local_get sop_is_bitwise) (const_i32 0))
            (and_bool
              (eq_i32 (local_get sop_is_comparison) (const_i32 0))
              (and_bool
                (eq_i32 (local_get sop_is_bool_binary) (const_i32 0))
                (eq_i32 (local_get sop_is_bool_unary) (const_i32 0)))))))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "unknown canonical operator "))
          (call_void emit_node_text
            (const_i32 2) (param_get sop_source) (param_get sop_tree)
            (local_get sop_name_node))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (local_get sop_is_bool_unary) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i64 (local_get sop_child_count) (const_i64 3)))
            (then (do
              (call_void surface_error_prefix (const_string_ptr "operator"))
              (call_void write_cstr (const_i32 2) (const_string_ptr "wrong arity for not: expected 1, got "))
              (call_void write_i64_dec (const_i32 2)
                (sub_i64 (local_get sop_child_count) (const_i64 2)))
              (call_void write_byte (const_i32 2) (const_i32 10))
              (call_void sop_emit_failure_expr (param_get sop_fd))
              (return_void)))
            (else (do)))
          (let sop_unary_node i64 (call_i64 nth_child
            (param_get sop_tree) (param_get sop_node) (const_i64 2)))
          (let sop_unary_type i32 (call_i32 sop_expr_type
            (param_get sop_tree) (param_get sop_source) (local_get sop_unary_node)
            (call_i32 surface_type_bool)))
          (if
            (condition (ne_i32 (local_get sop_unary_type) (call_i32 surface_type_bool)))
            (then (do
              (call_void surface_error_prefix (const_string_ptr "operator"))
              (call_void write_cstr (const_i32 2) (const_string_ptr "not expects bool, got "))
              (call_void surface_emit_type_name (const_i32 2) (local_get sop_unary_type))
              (call_void write_byte (const_i32 2) (const_i32 10))
              (call_void sop_emit_failure_expr (param_get sop_fd))
              (return_void)))
            (else (do)))
          (call_void write_cstr (param_get sop_fd) (const_string_ptr "(not_bool "))
          (call_void surface_emit_expr_expected
            (param_get sop_fd) (param_get sop_source) (param_get sop_tree)
            (local_get sop_unary_node) (call_i32 surface_type_bool))
          (call_void write_byte (param_get sop_fd) (const_i32 41))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i64 (local_get sop_child_count) (const_i64 4)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "wrong arity for "))
          (call_void emit_node_text
            (const_i32 2) (param_get sop_source) (param_get sop_tree)
            (local_get sop_name_node))
          (call_void write_cstr (const_i32 2) (const_string_ptr ": expected 2, got "))
          (call_void write_i64_dec (const_i32 2)
            (sub_i64 (local_get sop_child_count) (const_i64 2)))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))
      (let sop_left_node i64 (call_i64 nth_child
        (param_get sop_tree) (param_get sop_node) (const_i64 2)))
      (let sop_right_node i64 (call_i64 nth_child
        (param_get sop_tree) (param_get sop_node) (const_i64 3)))
      (if
        (condition (ne_i32 (local_get sop_is_bool_binary) (const_i32 0)))
        (then (do
          (let sop_bool_left_type i32 (call_i32 sop_expr_type
            (param_get sop_tree) (param_get sop_source) (local_get sop_left_node)
            (call_i32 surface_type_bool)))
          (let sop_bool_right_type i32 (call_i32 sop_expr_type
            (param_get sop_tree) (param_get sop_source) (local_get sop_right_node)
            (call_i32 surface_type_bool)))
          (if
            (condition (or_bool
              (ne_i32 (local_get sop_bool_left_type) (call_i32 surface_type_bool))
              (ne_i32 (local_get sop_bool_right_type) (call_i32 surface_type_bool))))
            (then (do
              (call_void surface_error_prefix (const_string_ptr "operator"))
              (call_void write_cstr (const_i32 2) (const_string_ptr "boolean operator expects bool operands"))
              (call_void write_byte (const_i32 2) (const_i32 10))
              (call_void sop_emit_failure_expr (param_get sop_fd))
              (return_void)))
            (else (do)))
          (call_void sop_emit_boolean_binary
            (param_get sop_fd) (param_get sop_source) (param_get sop_tree)
            (local_get sop_name_node) (local_get sop_left_node) (local_get sop_right_node))
          (return_void)))
        (else (do)))
      (let sop_operand_type i32 (call_i32 sop_infer_binary_type
        (param_get sop_tree) (param_get sop_source)
        (local_get sop_left_node) (local_get sop_right_node)))
      (if
        (condition (eq_i32 (local_get sop_operand_type) (call_i32 surface_type_unknown)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "operand type mismatch for "))
          (call_void emit_node_text
            (const_i32 2) (param_get sop_source) (param_get sop_tree)
            (local_get sop_name_node))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get sop_is_arithmetic) (const_i32 0))
          (eq_i32 (call_i32 sop_type_is_numeric
            (local_get sop_operand_type)) (const_i32 0))))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "arithmetic operator does not support "))
          (call_void surface_emit_type_name (const_i32 2) (local_get sop_operand_type))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get sop_is_bitwise) (const_i32 0))
          (eq_i32 (call_i32 sop_type_is_integer
            (local_get sop_operand_type)) (const_i32 0))))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "bitwise operator does not support "))
          (call_void surface_emit_type_name (const_i32 2) (local_get sop_operand_type))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get sop_is_comparison) (const_i32 0))
          (eq_i32 (call_i32 sop_comparison_supports_type
            (param_get sop_tree) (param_get sop_source) (local_get sop_name_node)
            (local_get sop_operand_type)) (const_i32 0))))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "comparison does not support "))
          (call_void surface_emit_type_name (const_i32 2) (local_get sop_operand_type))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))
      (call_void sop_emit_binary
        (param_get sop_fd) (param_get sop_source) (param_get sop_tree)
        (local_get sop_name_node) (local_get sop_left_node) (local_get sop_right_node)
        (local_get sop_operand_type))
      (return_void)))

)
