            (param_get stl_value_name))
          (call_void write_byte (param_get stl_fd) (const_i32 41)))))
      (call_void write_cstr
        (param_get stl_fd) (const_string_ptr ") (then (do (store_i8 "))
      (call_void stl_emit_address
        (param_get stl_fd) (param_get stl_offset) (param_get stl_is_local))
      (call_void write_cstr
        (param_get stl_fd)
        (const_string_ptr " (const_i32 1)))) (else (do (store_i8 "))
      (call_void stl_emit_address
