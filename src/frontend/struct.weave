  (fn stl_emit_bool_store
    (params
      (stl_fd i32) (stl_offset i64) (stl_is_local i32)
      (stl_value_name i64) (stl_source ptr) (stl_tree ptr)
      (stl_value_is_local i32))
    (returns void)
    (do
      (call_void write_cstr (param_get stl_fd) (const_string_ptr "(if (condition "))
      (if
        (condition (eq_i64 (param_get stl_value_name) (const_i64 -1)))
        (then (do
          (call_void write_cstr (param_get stl_fd) (const_string_ptr "(param_get v)"))))
