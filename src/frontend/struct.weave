; SPDX-License-Identifier: Apache-2.0
; struct.weave — validated, naturally aligned struct lowering
;
; Legacy struct declarations retain their generated compatibility ABI:
;   NAME_new, NAME_get_FIELD, and NAME_set_FIELD.
; Explicit modules use deterministic compiler-owned helper base names.
; Canonical semantic new/field-get/field-set forms will be implemented separately.
;
; Field representation:
;   bool       size 1, alignment 1, load_u8/store_i8
;   i32/f32    size 4, alignment 4
;   i64/f64    size 8, alignment 8
;   ptr/Qubit  size 8, alignment 8 (Qubit lowers to WIR i64)
;
; Every field starts at its natural alignment. The allocation size is rounded to
; the maximum field alignment. Unsupported and malformed fields are rejected
; before any generated declaration is emitted.

(program
  (name "struct")
  (version "0.1")

  (fn stl_type_supported
    (params (stl_type i32))
    (returns i32)
    (do
      (if
        (condition (or_bool
          (or_bool
            (eq_i32 (param_get stl_type) (call_i32 surface_type_i32))
            (eq_i32 (param_get stl_type) (call_i32 surface_type_i64)))
          (or_bool
            (or_bool
              (eq_i32 (param_get stl_type) (call_i32 surface_type_f32))
              (eq_i32 (param_get stl_type) (call_i32 surface_type_f64)))
            (or_bool
              (eq_i32 (param_get stl_type) (call_i32 surface_type_bool))
              (eq_i32 (param_get stl_type) (call_i32 surface_type_ptr))))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn stl_nodes_equal
    (params (stl_source ptr) (stl_tree ptr) (stl_left i64) (stl_right i64))
    (returns i32)
    (do
      (return (call_i32 slices_equal
        (param_get stl_source)
        (call_i64 node_text_start (param_get stl_tree) (param_get stl_left))
        (call_i64 node_text_len (param_get stl_tree) (param_get stl_left))
        (call_i64 node_text_start (param_get stl_tree) (param_get stl_right))
        (call_i64 node_text_len (param_get stl_tree) (param_get stl_right))))))

  (fn stl_record_error
    (params
      (stl_tree ptr) (stl_source ptr) (stl_node i64) (stl_code ptr)
      (stl_role ptr) (stl_symbol i64))
    (returns void)
    (do
      (call_void sdiag_record
        (param_get stl_tree) (param_get stl_source) (param_get stl_node)
        (param_get stl_code)
        (call_i32 surface_type_unknown) (call_i32 surface_type_unknown)
        (const_i32 -1) (const_i32 -1) (const_i32 -1)
        (param_get stl_role) (param_get stl_symbol) (const_i32 0))
      (return_void)))

  (fn stl_error_malformed
    (params (stl_tree ptr) (stl_source ptr) (stl_node i64) (stl_detail ptr))
    (returns void)
    (do
      (call_void surface_error_prefix (const_string_ptr "struct"))
      (call_void write_cstr (const_i32 2) (param_get stl_detail))
      (call_void write_byte (const_i32 2) (const_i32 10))
      (call_void stl_record_error
        (param_get stl_tree) (param_get stl_source) (param_get stl_node)
        (const_string_ptr "frontend.struct.malformed")
        (const_string_ptr "declaration") (const_i64 -1))
      (return_void)))

  (fn stl_error_unsupported_type
    (params
      (stl_tree ptr) (stl_source ptr) (stl_type_node i64)
      (stl_field_name i64))
    (returns void)
    (do
      (call_void surface_error_prefix (const_string_ptr "struct"))
      (call_void write_cstr (const_i32 2) (const_string_ptr "unsupported field type "))
      (call_void emit_node_text
        (const_i32 2) (param_get stl_source) (param_get stl_tree)
        (param_get stl_type_node))
      (call_void write_cstr (const_i32 2) (const_string_ptr " for field "))
      (call_void emit_node_text
        (const_i32 2) (param_get stl_source) (param_get stl_tree)
        (param_get stl_field_name))
      (call_void write_byte (const_i32 2) (const_i32 10))
      (call_void stl_record_error
        (param_get stl_tree) (param_get stl_source) (param_get stl_type_node)
        (const_string_ptr "frontend.struct.unsupported-field-type")
        (const_string_ptr "field-type") (param_get stl_field_name))
      (return_void)))

  (fn stl_error_duplicate_field
    (params (stl_tree ptr) (stl_source ptr) (stl_field_name i64))
    (returns void)
    (do
      (call_void surface_error_prefix (const_string_ptr "struct"))
      (call_void write_cstr (const_i32 2) (const_string_ptr "duplicate field "))
      (call_void emit_node_text
        (const_i32 2) (param_get stl_source) (param_get stl_tree)
        (param_get stl_field_name))
      (call_void write_byte (const_i32 2) (const_i32 10))
      (call_void stl_record_error
        (param_get stl_tree) (param_get stl_source) (param_get stl_field_name)
        (const_string_ptr "frontend.struct.duplicate-field")
        (const_string_ptr "field") (param_get stl_field_name))
      (return_void)))

  (fn stl_validate
    (params (stl_tree ptr) (stl_source ptr) (stl_node i64))
    (returns i32)
    (do
      (if
        (condition (lt_i64
          (call_i64 count_children (param_get stl_tree) (param_get stl_node))
          (const_i64 3)))
        (then (do
          (call_void stl_error_malformed
            (param_get stl_tree) (param_get stl_source) (param_get stl_node)
            (const_string_ptr "struct requires a name and at least one field"))
          (return (const_i32 1))))
        (else (do)))
      (let stl_name i64 (call_i64 nth_child
        (param_get stl_tree) (param_get stl_node) (const_i64 1)))
      (if
        (condition (eq_i32
          (call_i32 surface_node_is_ident (param_get stl_tree) (local_get stl_name))
          (const_i32 0)))
        (then (do
          (call_void stl_error_malformed
            (param_get stl_tree) (param_get stl_source) (param_get stl_node)
            (const_string_ptr "struct name must be an identifier"))
          (return (const_i32 1))))
        (else (do)))
      (if
        (condition (gt_i64 (call_i64 count_named_clauses
          (param_get stl_tree) (param_get stl_source) (param_get stl_node)
          (const_string_ptr "type-params") (const_i64 11)) (const_i64 1)))
        (then (do
          (call_void stl_error_malformed
            (param_get stl_tree) (param_get stl_source) (param_get stl_node)
            (const_string_ptr "only one (type-params ...) clause is allowed"))
          (return (const_i32 1))))
        (else (do)))
      (let stl_generic i32 (call_i32 surface_decl_is_generic
        (param_get stl_tree) (param_get stl_source) (param_get stl_node)))
      (let stl_field i64 (call_i64 node_next_sibling
        (param_get stl_tree) (local_get stl_name)))
      (while
        (condition (ne_i64 (local_get stl_field) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 head_equals
              (param_get stl_tree) (param_get stl_source) (local_get stl_field)
              (const_string_ptr "type-params") (const_i64 11)) (const_i32 0)))
            (then (do
              (if
                (condition (or_bool
                  (ne_i32
                    (call_i32 node_kind (param_get stl_tree) (local_get stl_field))
                    (call_i32 node_list))
                  (or_bool
                    (eq_i32
                      (call_i32 head_equals
                        (param_get stl_tree) (param_get stl_source)
                        (local_get stl_field)
                        (const_string_ptr "field") (const_i64 5))
                      (const_i32 0))
                    (ne_i64
                      (call_i64 count_children
                        (param_get stl_tree) (local_get stl_field))
                      (const_i64 3)))))
                (then (do
                  (call_void stl_error_malformed
                    (param_get stl_tree) (param_get stl_source)
                    (local_get stl_field)
                    (const_string_ptr "fields must use (field NAME TYPE)"))
                  (return (const_i32 1))))
                (else (do)))
              (let stl_field_name i64 (call_i64 nth_child
                (param_get stl_tree) (local_get stl_field) (const_i64 1)))
              (let stl_type_node i64 (call_i64 nth_child
                (param_get stl_tree) (local_get stl_field) (const_i64 2)))
              (if
                (condition (or_bool
                  (eq_i32
                    (call_i32 surface_node_is_ident
                      (param_get stl_tree) (local_get stl_field_name))
                    (const_i32 0))
                  (eq_i32
                    (call_i32 surface_type_form_valid
                      (param_get stl_tree) (param_get stl_source)
                      (local_get stl_type_node))
                    (const_i32 0))))
                (then (do
                  (call_void stl_error_malformed
                    (param_get stl_tree) (param_get stl_source)
                    (local_get stl_field)
                    (const_string_ptr "field name must be an identifier and type must be a name or type-app"))
                  (return (const_i32 1))))
                (else (do)))
              (let stl_type_code i32 (call_i32 surface_type_code
                (param_get stl_tree) (param_get stl_source)
                (local_get stl_type_node)))
              (if
                (condition (and_bool
                  (eq_i32 (local_get stl_generic) (const_i32 0))
                  (eq_i32
                    (call_i32 stl_type_supported (local_get stl_type_code))
                    (const_i32 0))))
                (then (do
                  (call_void stl_error_unsupported_type
                    (param_get stl_tree) (param_get stl_source)
                    (local_get stl_type_node) (local_get stl_field_name))
                  (return (const_i32 1))))
                (else (do)))
              (let stl_prior i64 (call_i64 node_next_sibling
                (param_get stl_tree) (local_get stl_name)))
              (while
                (condition (ne_i64 (local_get stl_prior) (local_get stl_field)))
                (do
                  (if
                    (condition (ne_i32 (call_i32 head_equals
                      (param_get stl_tree) (param_get stl_source)
                      (local_get stl_prior)
                      (const_string_ptr "field") (const_i64 5)) (const_i32 0)))
                    (then (do
                      (let stl_prior_name i64 (call_i64 nth_child
                        (param_get stl_tree) (local_get stl_prior) (const_i64 1)))
                      (if
                        (condition (ne_i32
                          (call_i32 stl_nodes_equal
                            (param_get stl_source) (param_get stl_tree)
                            (local_get stl_prior_name) (local_get stl_field_name))
                          (const_i32 0)))
                        (then (do
                          (call_void stl_error_duplicate_field
                            (param_get stl_tree) (param_get stl_source)
                            (local_get stl_field_name))
                          (return (const_i32 1))))
                        (else (do)))))
                    (else (do)))
                  (set stl_prior (call_i64 node_next_sibling
                    (param_get stl_tree) (local_get stl_prior)))))))
            (else (do)))
          (set stl_field (call_i64 node_next_sibling
            (param_get stl_tree) (local_get stl_field)))))
      (return (const_i32 0))))

  (fn stl_field_type
    (params (stl_tree ptr) (stl_source ptr) (stl_field i64))
    (returns i32)
    (do
      (return (call_i32 surface_type_code
        (param_get stl_tree) (param_get stl_source)
        (call_i64 nth_child
          (param_get stl_tree) (param_get stl_field) (const_i64 2))))))

  (fn stl_emit_field_suffix
    (params (stl_fd i32) (stl_type i32))
    (returns void)
    (do
      (if
        (condition (eq_i32 (param_get stl_type) (call_i32 surface_type_i32)))
        (then (do
          (call_void write_cstr (param_get stl_fd) (const_string_ptr "i32"))
          (return_void)))
        (else (do)))
      (if
        (condition (eq_i32 (param_get stl_type) (call_i32 surface_type_f32)))
        (then (do
          (call_void write_cstr (param_get stl_fd) (const_string_ptr "f32"))
          (return_void)))
        (else (do)))
      (if
        (condition (eq_i32 (param_get stl_type) (call_i32 surface_type_f64)))
        (then (do
          (call_void write_cstr (param_get stl_fd) (const_string_ptr "f64"))
          (return_void)))
        (else (do)))
      (if
        (condition (eq_i32 (param_get stl_type) (call_i32 surface_type_bool)))
        (then (do
          (call_void write_cstr (param_get stl_fd) (const_string_ptr "bool"))
          (return_void)))
        (else (do)))
      (if
        (condition (eq_i32 (param_get stl_type) (call_i32 surface_type_ptr)))
        (then (do
          (call_void write_cstr (param_get stl_fd) (const_string_ptr "ptr"))
          (return_void)))
        (else (do)))
      (call_void write_cstr (param_get stl_fd) (const_string_ptr "i64"))
      (return_void)))

  ; Write the STRUCT and FIELD operands shared by every field operation.
  (fn stl_emit_field_target
    (params
      (stl_fd i32) (stl_source ptr) (stl_tree ptr)
      (stl_struct_type i32) (stl_field_name i64))
    (returns void)
    (do
      (call_void sst_emit_struct_wir_name
        (param_get stl_fd) (param_get stl_struct_type))
      (call_void write_byte (param_get stl_fd) (const_i32 32))
      (call_void emit_node_text
        (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
        (param_get stl_field_name))
      (return_void)))

  (fn stl_emit_declaration
    (params (stl_fd i32) (stl_source ptr) (stl_tree ptr) (stl_node i64))
    (returns void)
    (do
      (let stl_decl_name i64 (call_i64 nth_child
        (param_get stl_tree) (param_get stl_node) (const_i64 1)))
      (let stl_decl_type i32 (call_i32 sst_type_code
        (param_get stl_tree) (param_get stl_source) (local_get stl_decl_name)))
      (call_void emit_source_span_for_node
        (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
        (param_get stl_node))
      (call_void write_cstr (param_get stl_fd) (const_string_ptr "    (struct "))
      (call_void sst_emit_struct_wir_name
        (param_get stl_fd) (local_get stl_decl_type))
      (let stl_decl_field i64 (call_i64 node_next_sibling
        (param_get stl_tree) (local_get stl_decl_name)))
      (while
        (condition (ne_i64 (local_get stl_decl_field) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 head_equals
              (param_get stl_tree) (param_get stl_source)
              (local_get stl_decl_field)
              (const_string_ptr "field") (const_i64 5)) (const_i32 0)))
            (then (do
              (call_void write_cstr
                (param_get stl_fd) (const_string_ptr " (field "))
              (call_void emit_node_text
                (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
                (call_i64 nth_child
                  (param_get stl_tree) (local_get stl_decl_field) (const_i64 1)))
              (call_void write_byte (param_get stl_fd) (const_i32 32))
              (call_void emit_wir_type
                (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
                (call_i64 nth_child
                  (param_get stl_tree) (local_get stl_decl_field) (const_i64 2)))
              (call_void write_byte (param_get stl_fd) (const_i32 41))))
            (else (do)))
          (set stl_decl_field (call_i64 node_next_sibling
            (param_get stl_tree) (local_get stl_decl_field)))))
      (call_void write_byte (param_get stl_fd) (const_i32 41))
      (call_void write_byte (param_get stl_fd) (const_i32 10))
      (return_void)))

  (fn stl_emit_constructor
    (params (stl_fd i32) (stl_source ptr) (stl_tree ptr) (stl_node i64))
    (returns void)
    (do
      (let stl_constructor_name i64 (call_i64 nth_child
        (param_get stl_tree) (param_get stl_node) (const_i64 1)))
      (let stl_constructor_type i32 (call_i32 sst_type_code
        (param_get stl_tree) (param_get stl_source)
        (local_get stl_constructor_name)))
      (call_void emit_source_span_for_node
        (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
        (param_get stl_node))
      (call_void write_cstr (param_get stl_fd) (const_string_ptr "    (fn "))
      (call_void sst_emit_struct_wir_name
        (param_get stl_fd) (local_get stl_constructor_type))
      (call_void write_cstr
        (param_get stl_fd) (const_string_ptr "_new (params"))
      (let stl_constructor_field i64 (call_i64 node_next_sibling
        (param_get stl_tree) (local_get stl_constructor_name)))
      (while
        (condition (ne_i64 (local_get stl_constructor_field) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 head_equals
              (param_get stl_tree) (param_get stl_source)
              (local_get stl_constructor_field)
              (const_string_ptr "field") (const_i64 5)) (const_i32 0)))
            (then (do
              (let stl_constructor_field_name i64 (call_i64 nth_child
                (param_get stl_tree) (local_get stl_constructor_field) (const_i64 1)))
              (let stl_constructor_type_node i64 (call_i64 nth_child
                (param_get stl_tree) (local_get stl_constructor_field) (const_i64 2)))
              (call_void write_cstr (param_get stl_fd) (const_string_ptr " ("))
              (call_void emit_node_text
                (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
                (local_get stl_constructor_field_name))
              (call_void write_byte (param_get stl_fd) (const_i32 32))
              (call_void emit_wir_type
                (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
                (local_get stl_constructor_type_node))
              (call_void write_byte (param_get stl_fd) (const_i32 41))))
            (else (do)))
          (set stl_constructor_field (call_i64 node_next_sibling
            (param_get stl_tree) (local_get stl_constructor_field)))))
      (call_void write_cstr
        (param_get stl_fd) (const_string_ptr ") (returns ptr)"))
      (call_void write_byte (param_get stl_fd) (const_i32 10))
      (call_void write_cstr (param_get stl_fd) (const_string_ptr "      (do"))
      (call_void write_byte (param_get stl_fd) (const_i32 10))
      (call_void write_cstr
        (param_get stl_fd)
        (const_string_ptr "        (let self ptr (call_ptr malloc (struct_size "))
      (call_void sst_emit_struct_wir_name
        (param_get stl_fd) (local_get stl_constructor_type))
      (call_void write_cstr (param_get stl_fd) (const_string_ptr ")))"))
      (call_void write_byte (param_get stl_fd) (const_i32 10))
      (call_void write_cstr
        (param_get stl_fd)
        (const_string_ptr
          "        (if (condition (eq_ptr (local_get self) (const_null)))"))
      (call_void write_byte (param_get stl_fd) (const_i32 10))
      (call_void write_cstr
        (param_get stl_fd)
        (const_string_ptr "          (then (do (return (const_null))))"))
      (call_void write_byte (param_get stl_fd) (const_i32 10))
      (call_void write_cstr
        (param_get stl_fd) (const_string_ptr "          (else (do)))"))
      (call_void write_byte (param_get stl_fd) (const_i32 10))
      (set stl_constructor_field (call_i64 node_next_sibling
        (param_get stl_tree) (local_get stl_constructor_name)))
      (while
        (condition (ne_i64 (local_get stl_constructor_field) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 head_equals
              (param_get stl_tree) (param_get stl_source)
              (local_get stl_constructor_field)
              (const_string_ptr "field") (const_i64 5)) (const_i32 0)))
            (then (do
              (let stl_store_name i64 (call_i64 nth_child
                (param_get stl_tree) (local_get stl_constructor_field) (const_i64 1)))
              (let stl_store_type i32 (call_i32 stl_field_type
                (param_get stl_tree) (param_get stl_source)
                (local_get stl_constructor_field)))
              (call_void write_cstr
                (param_get stl_fd) (const_string_ptr "        (field_set_"))
              (call_void stl_emit_field_suffix
                (param_get stl_fd) (local_get stl_store_type))
              (call_void write_byte (param_get stl_fd) (const_i32 32))
              (call_void stl_emit_field_target
                (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
                (local_get stl_constructor_type) (local_get stl_store_name))
              (call_void write_cstr
                (param_get stl_fd) (const_string_ptr " (local_get self) (param_get "))
              (call_void emit_node_text
                (param_get stl_fd) (param_get stl_source) (param_get stl_tree)
                (local_get stl_store_name))
              (call_void write_cstr (param_get stl_fd) (const_string_ptr "))"))
              (call_void write_byte (param_get stl_fd) (const_i32 10))))
            (else (do)))
          (set stl_constructor_field (call_i64 node_next_sibling
            (param_get stl_tree) (local_get stl_constructor_field)))))
      (call_void write_cstr
        (param_get stl_fd)
        (const_string_ptr "        (return (local_get self))))"))
      (call_void write_byte (param_get stl_fd) (const_i32 10))
      (return_void)))

  (fn stl_emit_accessors
    (params
      (stl_fd i32) (stl_source ptr) (stl_tree ptr)
      (stl_struct_name i64) (stl_field i64))
    (returns void)
    (do
      (let stl_accessor_name i64 (call_i64 nth_child
        (param_get stl_tree) (param_get stl_field) (const_i64 1)))
      (let stl_accessor_type_node i64 (call_i64 nth_child
        (param_get stl_tree) (param_get stl_field) (const_i64 2)))
      (let stl_accessor_type i32 (call_i32 stl_field_type
        (param_get stl_tree) (param_get stl_source) (param_get stl_field)))
      (let stl_accessor_struct_type i32 (call_i32 sst_type_code
        (param_get stl_tree) (param_get stl_source)
        (param_get stl_struct_name)))
      (call_void emit_source_span_for_node
