  (fn explain_fn_json
    (params (fd i32) (source ptr) (tree ptr) (fn_node i64) (first_decl i64) (need_comma i32))
    (returns void)
    (do
      (let do_node i64 (call_i64 fn_find_do_child (param_get tree) (param_get source) (param_get fn_node)))
      (let returns_sites i64 (const_i64 0))
      (let loop_sites i64 (const_i64 0))
      (let call_sites i64 (const_i64 0))
      (let external_calls i64 (const_i64 0))
      (let allocations i64 (const_i64 0))
      (let ctx ptr (const_null))
      (if
        (condition (ne_i64 (local_get do_node) (const_i64 -1)))
        (then (do
          (set returns_sites (call_i64 count_return_sites_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (set loop_sites (call_i64 count_while_loops_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (set call_sites (call_i64 count_calls_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (set external_calls (call_i64 count_external_calls_in_node
            (param_get tree) (param_get source) (local_get do_node) (param_get first_decl)))
          (set allocations (call_i64 count_allocations_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (if
            (condition (gt_i64 (local_get external_calls) (const_i64 0)))
            (then (do
              (set ctx (call_ptr explain_ctx_new))
              (call_void explain_collect_external_callees_node
                (local_get ctx) (param_get tree) (param_get source) (local_get do_node) (param_get first_decl))))
            (else (do)))))
        (else (do)))
      (let n_req i64 (call_i64 count_contract_clauses
        (param_get tree) (param_get source) (param_get fn_node)
        (const_string_ptr "requires") (const_i64 8)))
      (let n_ens i64 (call_i64 count_contract_clauses
        (param_get tree) (param_get source) (param_get fn_node)
        (const_string_ptr "ensures") (const_i64 7)))
      (let checks i64 (add_i64 (local_get n_req) (mul_i64 (local_get n_ens) (local_get returns_sites))))
      (if
        (condition (ne_i32 (param_get need_comma) (const_i32 0)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr ",\n"))))
        (else (do)))
      (call_void write_cstr (param_get fd) (const_string_ptr "    {"))
      (call_void write_json_key_colon (param_get fd) (const_string_ptr "name"))
      (call_void write_json_string_from_node (param_get fd) (param_get source) (param_get tree)
        (call_i64 nth_child (param_get tree) (param_get fn_node) (const_i64 1)))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "requires"))
      (call_void explain_emit_contract_json_array
        (param_get fd) (param_get source) (param_get tree) (param_get fn_node)
        (const_string_ptr "requires") (const_i64 8))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "ensures"))
      (call_void explain_emit_contract_json_array
        (param_get fd) (param_get source) (param_get tree) (param_get fn_node)
        (const_string_ptr "ensures") (const_i64 7))
      (if
        (condition (eq_ptr (call_ptr weave_audit_json_get_table) (const_null)))
        (then (do
          (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "pure"))
          (if
            (condition (ne_i32 (call_i32 fn_has_pure_clause (param_get tree) (param_get source) (param_get fn_node)) (const_i32 0)))
            (then (do (call_void write_cstr (param_get fd) (const_string_ptr "true"))))
            (else (do (call_void write_cstr (param_get fd) (const_string_ptr "false")))))
          (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "no_alloc"))
          (if
            (condition (ne_i32 (call_i32 fn_has_no_alloc_clause (param_get tree) (param_get source) (param_get fn_node)) (const_i32 0)))
            (then (do (call_void write_cstr (param_get fd) (const_string_ptr "true"))))
            (else (do (call_void write_cstr (param_get fd) (const_string_ptr "false")))))
          (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "deterministic"))
          (if
            (condition (ne_i32 (call_i32 fn_has_deterministic_clause (param_get tree) (param_get source) (param_get fn_node)) (const_i32 0)))
            (then (do (call_void write_cstr (param_get fd) (const_string_ptr "true"))))
            (else (do (call_void write_cstr (param_get fd) (const_string_ptr "false")))))))
        (else (do
          (call_void json_emit_audit_effect_fields (param_get fd) (param_get source) (param_get tree)
            (param_get fn_node) (call_ptr weave_audit_json_get_table)))))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "returns"))
      (call_void write_json_string_from_node (param_get fd) (param_get source) (param_get tree)
        (call_i64 fn_return_type_node (param_get tree) (param_get fn_node)))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "parameters"))
      (call_void explain_emit_params_json (param_get fd) (param_get source) (param_get tree) (param_get fn_node))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "return_sites"))
      (call_void write_i64_dec (param_get fd) (local_get returns_sites))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "contract_checks_inserted"))
      (call_void write_i64_dec (param_get fd) (local_get checks))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "loop_sites"))
      (call_void write_i64_dec (param_get fd) (local_get loop_sites))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "call_sites"))
      (call_void write_i64_dec (param_get fd) (local_get call_sites))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "external_calls"))
      (call_void write_i64_dec (param_get fd) (local_get external_calls))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "external_callees"))
      (if
        (condition (gt_i64 (local_get external_calls) (const_i64 0)))
        (then (do
          (call_void explain_emit_external_callees_json (param_get fd) (param_get source) (param_get tree) (local_get ctx))))
        (else (do
          (call_void write_cstr (param_get fd) (const_string_ptr "[]")))))
      (call_void write_json_comma_key_colon (param_get fd) (const_string_ptr "allocations"))
      (call_void write_i64_dec (param_get fd) (local_get allocations))
      (call_void write_cstr (param_get fd) (const_string_ptr "}"))
      (if
        (condition (ne_ptr (local_get ctx) (const_null)))
        (then (do (call_void explain_ctx_free (local_get ctx))))
        (else (do)))
      (return_void)))

  (fn explain_program_json
    (params (fd i32) (source ptr) (tree ptr))
    (returns i32)
    (do
      (let first_decl i64 (call_i64 program_first_decl (param_get tree) (param_get source)))
      (let child i64 (local_get first_decl))
      (let need_comma i32 (const_i32 0))
      (call_void write_cstr (param_get fd) (const_string_ptr "{\n  "))
      (call_void write_json_key_colon (param_get fd) (const_string_ptr "functions"))
      (call_void write_cstr (param_get fd) (const_string_ptr "[\n"))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
                (then (do
                  (call_void explain_fn_json (param_get fd) (param_get source) (param_get tree) (local_get child)
                    (local_get first_decl) (local_get need_comma))
                  (set need_comma (const_i32 1))))
                (else (do
                  (if
                    (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                      (const_string_ptr "entry") (const_i64 5)) (const_i32 0)))
                    (then (do
                      (if
                        (condition (eq_i32 (call_i32 explain_entry_has_fn_def
                          (param_get tree) (param_get source) (local_get first_decl) (local_get child)) (const_i32 0)))
                        (then (do
                          (if
                            (condition (eq_i32 (call_i32 explain_entry_is_stub
                              (param_get tree) (local_get child)) (const_i32 0)))
                            (then (do
                              (call_void explain_fn_json (param_get fd) (param_get source) (param_get tree) (local_get child)
                                (local_get first_decl) (local_get need_comma))
                              (set need_comma (const_i32 1))))
                            (else (do
                              (call_void explain_entry_stub_json (param_get fd) (param_get source) (param_get tree) (local_get child)
                                (local_get need_comma))
                              (set need_comma (const_i32 1)))))))
                        (else (do)))))
                    (else (do))))))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (call_void write_cstr (param_get fd) (const_string_ptr "\n  ]\n}\n"))
      (return (const_i32 0))))

  (fn explain_file_mode
    (params (input_path ptr) (json_mode i32))
    (returns i32)
    (do
      (let in_fd i32 (call_i32 open (param_get input_path) (const_i32 0) (const_i32 0)))
      (if
        (condition (lt_i32 (local_get in_fd) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (let file_size i64 (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 2)))
      (if
        (condition (lt_i64 (local_get file_size) (const_i64 0)))
        (then (do
          (call_i32 close (local_get in_fd))
          (return (const_i32 1))))
        (else (do)))
      (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 0))
      (let source ptr (call_ptr malloc (add_i64 (local_get file_size) (const_i64 1))))
      (if
        (condition (eq_ptr (local_get source) (const_null)))
        (then (do
          (call_i32 close (local_get in_fd))
          (return (const_i32 1))))
        (else (do)))
      (let bytes_read i64 (call_i64 read (local_get in_fd) (local_get source) (local_get file_size)))
      (call_i32 close (local_get in_fd))
      (if
        (condition (ne_i64 (local_get bytes_read) (local_get file_size)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (store_i8 (ptr_add (local_get source) (local_get file_size)) (const_i32 0))
      (let tokens ptr (call_ptr lex (local_get source) (local_get file_size)))
      (if
        (condition (eq_ptr (local_get tokens) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (let tree ptr (call_ptr parse (local_get tokens)))
      (if
        (condition (eq_ptr (local_get tree) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (let status i32 (const_i32 0))
      (if
        (condition (eq_i32 (param_get json_mode) (const_i32 2)))
        (then (do
          (set status (call_i32 audit_program (const_i32 1) (local_get source) (local_get tree)))))
        (else (do
          (if
            (condition (eq_i32 (param_get json_mode) (const_i32 3)))
            (then (do
              (set status (call_i32 audit_program_json (const_i32 1) (local_get source) (local_get tree)))))
            (else (do
              (if
                (condition (eq_i32 (param_get json_mode) (const_i32 1)))
                (then (do
                  (set status (call_i32 explain_program_json (const_i32 1) (local_get source) (local_get tree)))))
                (else (do
                  (set status (call_i32 explain_program (const_i32 1) (local_get source) (local_get tree))))))))))))
      (call_void free (local_get source))
      (return (local_get status))))
)
