; explain-audit.weave — explain mode extensions (callee lists, entry, JSON, audit report)

(program
  (name "explain-audit")
  (version "0.1")

  (fn fn_find_do_child
    (params (tree ptr) (source ptr) (fn_node i64))
    (returns i64)
    (do
      (let returns_node i64 (call_i64 nth_child (param_get tree) (param_get fn_node) (const_i64 3)))
      (let child i64 (call_i64 node_next_sibling (param_get tree) (local_get returns_node)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "do") (const_i64 2)) (const_i32 0)))
                (then (do (return (local_get child))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i64 -1))))

  (fn fn_return_type_node
    (params (tree ptr) (fn_node i64))
    (returns i64)
    (do
      (let returns_node i64 (call_i64 nth_child (param_get tree) (param_get fn_node) (const_i64 3)))
      (return (call_i64 nth_child (param_get tree) (local_get returns_node) (const_i64 1)))))

  (fn explain_ctx_new
    (params ())
    (returns ptr)
    (do
      (let ctx ptr (call_ptr malloc (const_i64 520)))
      (if
        (condition (eq_ptr (local_get ctx) (const_null)))
        (then (do (return (const_null))))
        (else (do)))
      (store_i64 (local_get ctx) (const_i64 0))
      (return (local_get ctx))))

  (fn explain_ctx_free
    (params (ctx ptr))
    (returns void)
    (do
      (if
        (condition (ne_ptr (param_get ctx) (const_null)))
        (then (do (call_void free (param_get ctx))))
        (else (do)))
      (return_void)))

  (fn explain_ctx_count
    (params (ctx ptr))
    (returns i64)
    (do
      (return (load_i64 (param_get ctx)))))

  (fn explain_ctx_name_at
    (params (ctx ptr) (index i64))
    (returns i64)
    (do
      (return (load_i64 (ptr_add (param_get ctx) (add_i64 (const_i64 8) (mul_i64 (param_get index) (const_i64 8))))))))

  (fn explain_ctx_contains
    (params (ctx ptr) (tree ptr) (source ptr) (name_node i64))
    (returns i32)
    (do
      (let n i64 (load_i64 (param_get ctx)))
      (let i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get i) (local_get n)))
        (do
          (if
            (condition (ne_i32 (call_i32 ident_nodes_equal (param_get tree) (param_get source)
              (call_i64 explain_ctx_name_at (param_get ctx) (local_get i)) (param_get name_node)) (const_i32 0)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (set i (add_i64 (local_get i) (const_i64 1)))))
      (return (const_i32 0))))

  (fn explain_ctx_add
    (params (ctx ptr) (name_node i64))
    (returns void)
    (do
      (let n i64 (load_i64 (param_get ctx)))
      (if
        (condition (ge_i64 (local_get n) (const_i64 64)))
        (then (do (return_void)))
        (else (do)))
      (store_i64 (ptr_add (param_get ctx) (add_i64 (const_i64 8) (mul_i64 (local_get n) (const_i64 8))))
        (param_get name_node))
      (store_i64 (param_get ctx) (add_i64 (local_get n) (const_i64 1)))
      (return_void)))

  (fn explain_node_is_call
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 surface_is_call_node
          (param_get tree) (param_get source) (param_get node))
          (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (call_i32 surface_is_wir_call_node
        (param_get tree) (param_get source) (param_get node)))))

  (fn explain_collect_external_callees_node
    (params (ctx ptr) (tree ptr) (source ptr) (node i64) (first_decl i64))
    (returns void)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 explain_node_is_call (param_get tree) (param_get source) (param_get node)) (const_i32 0)))
        (then (do
          (let callee i64 (call_i64 surface_call_name_node
            (param_get tree) (param_get source) (param_get node)))
          (if
            (condition (eq_i32 (call_i32 explain_is_local_fn_name
              (param_get tree) (param_get source) (param_get first_decl) (local_get callee)) (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (call_i32 explain_ctx_contains
                  (param_get ctx) (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                (then (do
                  (call_void explain_ctx_add (param_get ctx) (local_get callee))))
                (else (do)))))
            (else (do)))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (call_void explain_collect_external_callees_node
                (param_get ctx) (param_get tree) (param_get source) (local_get child) (param_get first_decl))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))))
        (else (do)))
      (return_void)))

  (fn explain_emit_external_callee_lines
    (params (fd i32) (source ptr) (tree ptr) (ctx ptr))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "External callees:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (let n i64 (call_i64 explain_ctx_count (param_get ctx)))
      (if
        (condition (eq_i64 (local_get n) (const_i64 0)))
        (then (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  (none)"))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do
          (let i i64 (const_i64 0))
          (while
            (condition (lt_i64 (local_get i) (local_get n)))
            (do
              (call_void write_cstr (param_get fd) (const_string_ptr "  "))
              (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
                (call_i64 explain_ctx_name_at (param_get ctx) (local_get i)))
              (call_void write_byte (param_get fd) (const_i32 10))
              (set i (add_i64 (local_get i) (const_i64 1))))))))
      (return_void)))

  (fn explain_entry_has_fn_def
    (params (tree ptr) (source ptr) (first_decl i64) (entry_node i64))
    (returns i32)
    (do
      (let ename i64 (call_i64 nth_child (param_get tree) (param_get entry_node) (const_i64 1)))
      (let child i64 (param_get first_decl))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
                (then (do
                  (let fname i64 (call_i64 nth_child (param_get tree) (local_get child) (const_i64 1)))
                  (if
                    (condition (ne_i32 (call_i32 ident_nodes_equal
                      (param_get tree) (param_get source) (local_get fname) (local_get ename)) (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn explain_entry_is_stub
