; SPDX-License-Identifier: Apache-2.0
; lower_program_validate.weave — quantum validation and function lowering

(program
  (name "lower_program_validate")
  (version "0.1")

  (fn type_kind_qubit (params ()) (returns i32) (do (return (const_i32 1))))
  (fn type_kind_unknown (params ()) (returns i32) (do (return (const_i32 0))))

  (fn parse_surface_type
      (params (tree ptr) (source ptr) (type_node i64))
      (returns i32)
      (do
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
            (const_string_ptr "Qubit") (const_i64 5)) (const_i32 0)))
          (then (do (return (call_i32 type_kind_qubit))))
          (else (do)))
        (return (call_i32 type_kind_unknown))))

  (fn qgate_expected_arity
      (params (tree ptr) (source ptr) (gate_node i64))
      (returns i32)
      (do
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "H") (const_i64 1)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "X") (const_i64 1)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "Y") (const_i64 1)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "Z") (const_i64 1)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "CNOT") (const_i64 4)) (const_i32 0)))
          (then (do (return (const_i32 2))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "RY") (const_i64 2)) (const_i32 0)))
          (then (do (return (const_i32 2))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "RZ") (const_i64 2)) (const_i32 0)))
          (then (do (return (const_i32 2))))
          (else (do)))
        (return (const_i32 127))))

  (fn validate_qgate
      (params (tree ptr) (source ptr) (node i64) (last_type i32))
      (returns i32)
      (do
        (let gate_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
        (let arity i32 (call_i32 qgate_expected_arity (param_get tree) (param_get source) (local_get gate_node)))
        (if
          (condition (eq_i32 (local_get arity) (const_i32 127)))
          (then (do (return (const_i32 0))))
          (else (do)))
        (let actual i64 (sub_i64 (call_i64 count_children (param_get tree) (param_get node)) (const_i64 2)))
        (if
          (condition (ne_i64 (local_get actual) (cast_i32_to_i64 (local_get arity))))
          (then (do (return (const_i32 1))))
          (else (do)))
        (let q0 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
        (if
          (condition (ne_i32 (call_i32 node_kind (param_get tree) (local_get q0)) (call_i32 node_ident)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (eq_i32 (local_get arity) (const_i32 1)))
          (then (do
            (if
              (condition (ne_i32 (param_get last_type) (call_i32 type_kind_qubit)))
              (then (do (return (const_i32 1))))
              (else (do)))
            (return (const_i32 0))))
          (else (do)))
        (let q1 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
            (const_string_ptr "CNOT") (const_i64 4)) (const_i32 0)))
          (then (do
            (if
              (condition (ne_i32 (call_i32 node_kind (param_get tree) (local_get q1)) (call_i32 node_ident)))
              (then (do (return (const_i32 1))))
              (else (do)))
            (if
              (condition (ne_i32 (param_get last_type) (call_i32 type_kind_qubit)))
              (then (do (return (const_i32 1))))
              (else (do)))
            (return (const_i32 0))))
          (else (do)))
        (if
          (condition (ne_i32 (param_get last_type) (call_i32 type_kind_qubit)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (return (const_i32 0))))

  (fn let_binding_surface_type
    (params (tree ptr) (source ptr) (node i64) (cur_type i32))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (param_get cur_type))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do (return (param_get cur_type))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
          (const_string_ptr "let") (const_i64 3)) (const_i32 0)))
        (then (do (return (param_get cur_type))))
        (else (do)))
      (if
        (condition (ne_i64 (call_i64 count_children (param_get tree) (param_get node)) (const_i64 4)))
        (then (do (return (param_get cur_type))))
        (else (do)))
      (let type_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
      (return (call_i32 parse_surface_type
        (param_get tree) (param_get source) (local_get type_node)))))

  ; Last child of a list, or -1 when it has none.
  (fn last_child
    (params (tree ptr) (node i64))
    (returns i64)
    (do
      (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
      (let previous i64 (const_i64 -1))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (set previous (local_get child))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (local_get previous))))

  ; Whether a statement transfers control out of the enclosing function on every
  ; path through it. A `do` block terminates when its last statement does, and an
  ; `if` terminates only when both branches do, so a body ending in a fully
  ; returning `if` is accepted while one with a fall-through branch is not.
  ; Loops never count: a `while` may run zero times.
  (fn stmt_terminates
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind (param_get tree) (param_get node))
          (call_i32 node_list)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source)
          (param_get node) (const_string_ptr "return") (const_i64 6)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source)
          (param_get node) (const_string_ptr "return_void") (const_i64 11)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source)
          (param_get node) (const_string_ptr "do") (const_i64 2)) (const_i32 0)))
        (then (do
          (return (call_i32 stmt_terminates (param_get tree) (param_get source)
            (call_i64 last_child (param_get tree) (param_get node))))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source)
          (param_get node) (const_string_ptr "when") (const_i64 4)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source)
          (param_get node) (const_string_ptr "if") (const_i64 2)) (const_i32 0)))
        (then (do
          (let then_node i64 (call_i64 ie_then_body
            (param_get tree) (param_get source) (param_get node)))
          (let else_node i64 (call_i64 ie_else_body
            (param_get tree) (param_get source) (param_get node)))
          (if
            (condition (or_bool
              (eq_i64 (local_get then_node) (const_i64 -1))
              (eq_i64 (local_get else_node) (const_i64 -1))))
            (then (do (return (const_i32 0))))
            (else (do)))
          (if
            (condition (eq_i32 (call_i32 stmt_terminates (param_get tree) (param_get source)
              (local_get then_node))
              (const_i32 0)))
            (then (do (return (const_i32 0))))
            (else (do)))
          (return (call_i32 stmt_terminates (param_get tree) (param_get source)
            (local_get else_node)))))
        (else (do)))
      (return (const_i32 0))))

  ; A function body must transfer control out on every path. Without this the
  ; backend emits a basic block with no terminator and the failure surfaces as an
  ; LLVM parse error against generated text rather than against this source.
  (fn validate_fn_terminates
    (params (tree ptr) (source ptr) (node i64) (label ptr))
    (returns i32)
    (do
      (let body i64 (call_i64 surface_fn_last_body_stmt
        (param_get tree) (param_get source) (param_get node)))
      (if
        (condition (eq_i64 (local_get body) (const_i64 -1)))
        (then (do
          ; `(entry NAME)` remains a body-less reference; a signed function
          ; without a body still has to fail the returning rule.
          (if
            (condition (lt_i64 (call_i64 count_children
              (param_get tree) (param_get node)) (const_i64 4)))
            (then (do (return (const_i32 0))))
            (else (do)))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i64 (local_get body) (const_i64 -1))
          (ne_i32 (call_i32 stmt_terminates
            (param_get tree) (param_get source) (local_get body)) (const_i32 0))))
        (then (do (return (const_i32 0))))
        (else (do)))
      (call_void surface_error_prefix (param_get label))
      (let name_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
      (call_void emit_node_text (const_i32 2) (param_get source) (param_get tree) (local_get name_node))
      (call_void write_cstr (const_i32 2)
        (const_string_ptr " can reach the end of its body without returning; every path must end in (return VALUE) or (return)"))
      (call_void write_byte (const_i32 2) (const_i32 10))
      (let vt_span i64 (param_get node))
      (if
        (condition (ne_i64 (local_get body) (const_i64 -1)))
        (then (do (set vt_span (local_get body))))
        (else (do)))
      (call_void sdiag_record
        (param_get tree) (param_get source) (local_get vt_span)
        (const_string_ptr "frontend.function.missing-return")
        (call_i32 surface_type_unknown) (call_i32 surface_type_unknown)
        (const_i32 -1) (const_i32 -1) (const_i32 -1)
        (param_get label) (local_get name_node) (const_i32 0))
      (return (const_i32 1))))

  ; A type annotation must be a name or a type-app. Other compound spellings
  ; such as `(owned T)` are rejected so they cannot be written before they mean
  ; something.
  (fn validate_type_annotation
    (params (tree ptr) (source ptr) (type_node i64) (role ptr))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get type_node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 surface_type_form_valid
          (param_get tree) (param_get source) (param_get type_node))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (call_void surface_error_prefix (param_get role))
      (call_void write_cstr (const_i32 2)
        (const_string_ptr "type must be a name, not a compound expression"))
      (call_void write_byte (const_i32 2) (const_i32 10))
      (return (const_i32 1))))

  ; Check the annotations on one (params (name TYPE) ...) list.
  (fn validate_param_types
    (params (tree ptr) (source ptr) (params_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get params_node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let child i64 (call_i64 node_first_child
        (param_get tree) (param_get params_node)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind
              (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 validate_type_annotation
                  (param_get tree) (param_get source)
                  (call_i64 nth_child (param_get tree) (local_get child) (const_i64 1))
                  (const_string_ptr "parameter")) (const_i32 0)))
                (then (do (return (const_i32 1))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling
            (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  ; Check the parameter and return annotations of one fn or entry declaration.
  (fn validate_signature_types
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (let params_node i64 (call_i64 surface_fn_params_node
        (param_get tree) (param_get source) (param_get node)))
      (if
        (condition (ne_i32 (call_i32 validate_param_types
          (param_get tree) (param_get source) (local_get params_node)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (call_i32 validate_type_annotation
        (param_get tree) (param_get source)
        (call_i64 surface_fn_return_type_node
          (param_get tree) (param_get source) (param_get node))
        (const_string_ptr "return")))))

  (fn validate_children
    (params (tree ptr) (source ptr) (node i64) (last_type i32))
    (returns i32)
    (do
      (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
      (let cur_type i32 (param_get last_type))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 validate_node
              (param_get tree) (param_get source) (local_get child) (local_get cur_type)) (const_i32 0)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (set cur_type (call_i32 let_binding_surface_type
            (param_get tree) (param_get source) (local_get child) (local_get cur_type)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn validate_node
      (params (tree ptr) (source ptr) (node i64) (last_type i32))
      (returns i32)
      (do
        (if
          (condition (eq_i64 (param_get node) (const_i64 -1)))
          (then (do (return (const_i32 0))))
          (else (do)))
        (let kind i32 (call_i32 node_kind (param_get tree) (param_get node)))
        (if
          (condition (eq_i32 (local_get kind) (call_i32 node_list)))
          (then (do
            (if
              (condition (and_bool
                (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                  (const_string_ptr "let") (const_i64 3)) (const_i32 0))
                (eq_i64 (call_i64 count_children (param_get tree) (param_get node)) (const_i64 4))))
              (then (do
                (let type_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
                (if
                  (condition (ne_i32 (call_i32 validate_type_annotation
                    (param_get tree) (param_get source) (local_get type_node)
                    (const_string_ptr "binding")) (const_i32 0)))
                  (then (do (return (const_i32 1))))
                  (else (do)))
                (return (call_i32 validate_children
                  (param_get tree) (param_get source) (param_get node)
                  (call_i32 parse_surface_type (param_get tree) (param_get source) (local_get type_node))))))
              (else (do)))
            (if
              (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
              (then (do
                (if
                  (condition (ne_i32 (call_i32 validate_signature_types
                    (param_get tree) (param_get source) (param_get node)) (const_i32 0)))
                  (then (do (return (const_i32 1))))
                  (else (do)))
                (if
                  (condition (ne_i32 (call_i32 validate_fn_terminates
                    (param_get tree) (param_get source) (param_get node)
                    (const_string_ptr "function")) (const_i32 0)))
                  (then (do (return (const_i32 1))))
                  (else (do)))))
              (else (do)))
            (if
              (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                (const_string_ptr "entry") (const_i64 5)) (const_i32 0)))
              (then (do
                (if
                  (condition (ne_i32 (call_i32 validate_signature_types
                    (param_get tree) (param_get source) (param_get node)) (const_i32 0)))
                  (then (do (return (const_i32 1))))
                  (else (do)))
                (if
                  (condition (ne_i32 (call_i32 validate_fn_terminates
                    (param_get tree) (param_get source) (param_get node)
                    (const_string_ptr "entry")) (const_i32 0)))
                  (then (do (return (const_i32 1))))
                  (else (do)))))
              (else (do)))
            (if
              (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                (const_string_ptr "qgate") (const_i64 5)) (const_i32 0)))
              (then (do
                (if
                  (condition (ne_i32 (call_i32 validate_qgate
                    (param_get tree) (param_get source) (param_get node) (param_get last_type)) (const_i32 0)))
                  (then (do (return (const_i32 1))))
                  (else (do)))))
              (else (do)))
            (return (call_i32 validate_children
              (param_get tree) (param_get source) (param_get node) (param_get last_type)))))
          (else (do)))
        (return (const_i32 0))))

  (fn validate_quantum_program
      (params (tree ptr) (source ptr))
      (returns i32)
      (do
        (if
          (condition (ne_i32 (call_i32 surface_prepare_module
            (param_get tree) (param_get source)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 surface_validate_module_import_collisions
            (param_get tree) (param_get source)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 sst_register_program_decls
            (param_get tree) (param_get source)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (return (call_i32 validate_node
          (param_get tree) (param_get source) (const_i64 0) (call_i32 type_kind_unknown)))))

  (fn lower_fn
    (params (fd i32) (source ptr) (tree ptr) (fn_node i64) (effect_table ptr))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 fn_has_contract_clauses
          (param_get tree) (param_get source) (param_get fn_node)) (const_i32 0)))
        (then (do
          (return (call_i32 emit_fn_with_contracts
            (param_get fd) (param_get source) (param_get tree) (param_get fn_node) (param_get effect_table)))))
        (else (do)))
      (call_void emit_decl (param_get fd) (param_get source) (param_get tree) (param_get fn_node))
      (return (const_i32 0))))
)
