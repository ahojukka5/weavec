; SPDX-License-Identifier: Apache-2.0
; surface_control_tree.weave — structural success-path lowering for control flow
;
; Semantic validation stays in if_expr.weave, loop.weave, and emit.weave. This
; module builds owned WIR control nodes that compose #410–#413 children and
; nested control forms. Unmigrated children return failure so the caller can
; keep the text renderer. A failed judgment never publishes a partial subtree.

(program
  (name "surface_control_tree")
  (version "0.1")

  (fn sctl_fail
    (params (sctl_wir ptr))
    (returns i32)
    (do
      (call_i32 wir_tree_mark_failed (param_get sctl_wir))
      (return (const_i32 0))))

  (fn sctl_append
    (params (sctl_wir ptr) (sctl_parent i64) (sctl_child i64))
    (returns i32)
    (do
      (if
        (condition (or_bool
          (lt_i64 (param_get sctl_parent) (const_i64 0))
          (lt_i64 (param_get sctl_child) (const_i64 0))))
        (then (do (return (call_i32 sctl_fail (param_get sctl_wir)))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 wir_append_child
          (param_get sctl_wir) (param_get sctl_parent) (param_get sctl_child))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (return (const_i32 1))))

  (fn sctl_head_is
    (params
      (sctl_tree ptr) (sctl_source ptr) (sctl_node i64)
      (sctl_text ptr) (sctl_len i64))
    (returns i32)
    (do
      (return (call_i32 head_equals
        (param_get sctl_tree) (param_get sctl_source) (param_get sctl_node)
        (param_get sctl_text) (param_get sctl_len)))))

  (fn sctl_types_ok
    (params (sctl_expected i32) (sctl_actual i32))
    (returns i32)
    (do
      (if
        (condition (or_bool
          (eq_i32 (param_get sctl_expected) (call_i32 surface_type_unknown))
          (eq_i32 (param_get sctl_actual) (call_i32 surface_type_unknown))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (call_i32 weave_semantic_types_compatible
        (param_get sctl_expected) (param_get sctl_actual)))))

  (fn sctl_register_let
    (params
      (sctl_source ptr) (sctl_tree ptr) (sctl_name i64) (sctl_ty i32))
    (returns void)
    (do
      (call_i32 weave_surface_local_add
        (param_get sctl_source)
        (call_i64 node_text_start (param_get sctl_tree) (param_get sctl_name))
        (call_i64 node_text_len (param_get sctl_tree) (param_get sctl_name))
        (param_get sctl_ty))
      (return_void)))

  (fn sctl_ident
    (params
      (sctl_wir ptr) (sctl_source ptr) (sctl_tree ptr) (sctl_name i64))
    (returns i64)
    (do
      (return (call_i64 wir_scalar_source_ident
        (param_get sctl_wir) (param_get sctl_source)
        (param_get sctl_tree) (param_get sctl_name)))))

  ; Recurse children after the list head. Returns 1 when every descendant is
  ; a migrated form this module can compose.
  (fn sctl_treeable_children
    (params (sctl_source ptr) (sctl_tree ptr) (sctl_node i64))
    (returns i32)
    (do
      (let sctl_ch i64 (call_i64 node_first_child
        (param_get sctl_tree) (param_get sctl_node)))
      (if
        (condition (eq_i64 (local_get sctl_ch) (const_i64 -1)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (set sctl_ch (call_i64 node_next_sibling
        (param_get sctl_tree) (local_get sctl_ch)))
      (while
        (condition (ne_i64 (local_get sctl_ch) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 sctl_treeable
              (param_get sctl_source) (param_get sctl_tree) (local_get sctl_ch))
              (const_i32 0)))
            (then (do (return (const_i32 0))))
            (else (do)))
          (set sctl_ch (call_i64 node_next_sibling
            (param_get sctl_tree) (local_get sctl_ch)))))
      (return (const_i32 1))))

  (fn sctl_treeable
    (params (sctl_source ptr) (sctl_tree ptr) (sctl_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get sctl_node) (const_i64 -1)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 comment_is_node
          (param_get sctl_tree) (param_get sctl_source) (param_get sctl_node))
          (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind
          (param_get sctl_tree) (param_get sctl_node)) (call_i32 node_list)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (ne_i32 (call_i32 surface_is_operator_node
            (param_get sctl_tree) (param_get sctl_source) (param_get sctl_node))
            (const_i32 0))
          (ne_i32 (call_i32 surface_is_call_node
            (param_get sctl_tree) (param_get sctl_source) (param_get sctl_node))
            (const_i32 0))))
        (then (do (return (call_i32 sctl_treeable_children
          (param_get sctl_source) (param_get sctl_tree) (param_get sctl_node)))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "let") (const_i64 3))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "set") (const_i64 3))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "return") (const_i64 6))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node)
                (const_string_ptr "return_void") (const_i64 11))
                (const_i32 0))))
          (or_bool
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "if") (const_i64 2))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "when") (const_i64 4))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "while") (const_i64 5))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "for") (const_i64 3))
                (const_i32 0))))))
        (then (do (return (call_i32 sctl_treeable_children
          (param_get sctl_source) (param_get sctl_tree) (param_get sctl_node)))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "break") (const_i64 5))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node)
                (const_string_ptr "continue") (const_i64 8))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "do") (const_i64 2))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node)
                (const_string_ptr "condition") (const_i64 9))
                (const_i32 0))))
          (or_bool
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "then") (const_i64 4))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "else") (const_i64 4))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "range") (const_i64 5))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node) (const_string_ptr "cast") (const_i64 4))
                (const_i32 0))))))
        (then (do (return (call_i32 sctl_treeable_children
          (param_get sctl_source) (param_get sctl_tree) (param_get sctl_node)))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 sctl_head_is
              (param_get sctl_tree) (param_get sctl_source)
              (param_get sctl_node) (const_string_ptr "local_get") (const_i64 9))
              (const_i32 0))
            (ne_i32 (call_i32 sctl_head_is
              (param_get sctl_tree) (param_get sctl_source)
              (param_get sctl_node) (const_string_ptr "param_get") (const_i64 9))
              (const_i32 0)))
          (or_bool
            (or_bool
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node)
                (const_string_ptr "const_i32") (const_i64 9))
                (const_i32 0))
              (ne_i32 (call_i32 sctl_head_is
                (param_get sctl_tree) (param_get sctl_source)
                (param_get sctl_node)
                (const_string_ptr "const_i64") (const_i64 9))
                (const_i32 0)))
            (or_bool
              (or_bool
                (ne_i32 (call_i32 sctl_head_is
                  (param_get sctl_tree) (param_get sctl_source)
                  (param_get sctl_node)
                  (const_string_ptr "const_f32") (const_i64 9))
                  (const_i32 0))
                (ne_i32 (call_i32 sctl_head_is
                  (param_get sctl_tree) (param_get sctl_source)
                  (param_get sctl_node)
                  (const_string_ptr "const_f64") (const_i64 9))
                  (const_i32 0)))
              (or_bool
                (ne_i32 (call_i32 sctl_head_is
                  (param_get sctl_tree) (param_get sctl_source)
                  (param_get sctl_node)
                  (const_string_ptr "const_bool") (const_i64 10))
                  (const_i32 0))
                (ne_i32 (call_i32 sctl_head_is
                  (param_get sctl_tree) (param_get sctl_source)
                  (param_get sctl_node)
                  (const_string_ptr "const_null") (const_i64 10))
                  (const_i32 0)))))))
        (then (do (return (const_i32 1))))
        (else (do (return (const_i32 0)))))))

  (fn sctl_build_do
    (params
      (sctl_wir ptr) (sctl_source ptr) (sctl_tree ptr) (sctl_node i64))
    (returns i64)
    (do
      (let sctl_do i64 (call_i64 wir_control_do (param_get sctl_wir)))
      (if
        (condition (lt_i64 (local_get sctl_do) (const_i64 0)))
        (then (do (return (const_i64 -1))))
        (else (do)))
      (if
        (condition (eq_i64 (param_get sctl_node) (const_i64 -1)))
        (then (do (return (local_get sctl_do))))
        (else (do)))
      (let sctl_stmt i64 (call_i64 node_first_child
        (param_get sctl_tree) (param_get sctl_node)))
      (if
        (condition (eq_i64 (local_get sctl_stmt) (const_i64 -1)))
        (then (do (return (local_get sctl_do))))
        (else (do)))
      (set sctl_stmt (call_i64 node_next_sibling
        (param_get sctl_tree) (local_get sctl_stmt)))
      (while
        (condition (ne_i64 (local_get sctl_stmt) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 comment_is_node
              (param_get sctl_tree) (param_get sctl_source) (local_get sctl_stmt))
              (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (call_i32 sctl_append_stmt
                  (param_get sctl_wir) (param_get sctl_source)
                  (param_get sctl_tree) (local_get sctl_stmt)
                  (local_get sctl_do)) (const_i32 0)))
                (then (do (return (const_i64 -1))))
                (else (do)))))
            (else (do)))
          (set sctl_stmt (call_i64 node_next_sibling
            (param_get sctl_tree) (local_get sctl_stmt)))))
      (return (local_get sctl_do))))

  (fn sctl_build_branch
    (params
      (sctl_wir ptr) (sctl_source ptr) (sctl_tree ptr) (sctl_body i64))
    (returns i64)
    (do
      (if
        (condition (eq_i64 (param_get sctl_body) (const_i64 -1)))
        (then (do (return (call_i64 wir_control_do (param_get sctl_wir)))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ie_body_is_do
          (param_get sctl_tree) (param_get sctl_source) (param_get sctl_body))
          (const_i32 0)))
        (then (do (return (call_i64 sctl_build_do
          (param_get sctl_wir) (param_get sctl_source)
          (param_get sctl_tree) (param_get sctl_body)))))
        (else (do)))
      (let sctl_wrap i64 (call_i64 wir_control_do (param_get sctl_wir)))
      (if
        (condition (or_bool
          (lt_i64 (local_get sctl_wrap) (const_i64 0))
          (eq_i32 (call_i32 sctl_append_stmt
            (param_get sctl_wir) (param_get sctl_source)
            (param_get sctl_tree) (param_get sctl_body)
            (local_get sctl_wrap)) (const_i32 0))))
        (then (do (return (const_i64 -1))))
        (else (do)))
      (return (local_get sctl_wrap))))

  (fn sctl_append_if_expr_let
    (params
      (sctl_wir ptr) (sctl_source ptr) (sctl_tree ptr)
      (sctl_name i64) (sctl_ty i32) (sctl_if i64) (sctl_parent i64))
    (returns i32)
    (do
      (let sctl_cond i64 (call_i64 ie_cond_expr
        (param_get sctl_tree) (param_get sctl_source) (param_get sctl_if)))
      (let sctl_then i64 (call_i64 ie_then_body
        (param_get sctl_tree) (param_get sctl_source) (param_get sctl_if)))
      (let sctl_else i64 (call_i64 ie_else_body
        (param_get sctl_tree) (param_get sctl_source) (param_get sctl_if)))
      (if
        (condition (or_bool
          (eq_i64 (local_get sctl_cond) (const_i64 -1))
          (or_bool
            (eq_i64 (local_get sctl_then) (const_i64 -1))
            (or_bool
              (eq_i64 (local_get sctl_else) (const_i64 -1))
              (ne_i32 (call_i32 ie_body_is_do
                (param_get sctl_tree) (param_get sctl_source)
                (local_get sctl_else)) (const_i32 0))))))
        (then (do (return (call_i32 sctl_fail (param_get sctl_wir)))))
        (else (do)))
      (if
        (condition (or_bool
          (eq_i32 (call_i32 sctl_types_ok
            (call_i32 surface_type_bool)
            (call_i32 sst_expr_type
              (param_get sctl_tree) (param_get sctl_source)
              (local_get sctl_cond) (call_i32 surface_type_bool)))
            (const_i32 0))
          (or_bool
            (eq_i32 (call_i32 sctl_types_ok
              (param_get sctl_ty)
              (call_i32 sst_expr_type
                (param_get sctl_tree) (param_get sctl_source)
                (local_get sctl_then) (param_get sctl_ty)))
              (const_i32 0))
            (eq_i32 (call_i32 sctl_types_ok
              (param_get sctl_ty)
              (call_i32 sst_expr_type
                (param_get sctl_tree) (param_get sctl_source)
                (local_get sctl_else) (param_get sctl_ty)))
              (const_i32 0)))))
        (then (do (return (call_i32 sctl_fail (param_get sctl_wir)))))
        (else (do)))
      (let sctl_type_name ptr (call_ptr weave_semantic_type_wir
        (param_get sctl_ty)))
      (let sctl_let_name i64 (call_i64 sctl_ident
        (param_get sctl_wir) (param_get sctl_source)
        (param_get sctl_tree) (param_get sctl_name)))
      (let sctl_type_atom i64 (call_i64 sstt_wir_type_atom
        (param_get sctl_wir) (param_get sctl_ty)))
      (let sctl_dummy i64 (call_i64 wir_control_dummy_value
        (param_get sctl_wir) (local_get sctl_type_name)))
      (let sctl_dummy_let i64 (call_i64 wir_stmt_let
        (param_get sctl_wir) (local_get sctl_let_name)
        (local_get sctl_type_atom) (local_get sctl_dummy)))
      (if
        (condition (eq_i32 (call_i32 sctl_append
          (param_get sctl_wir) (param_get sctl_parent)
          (local_get sctl_dummy_let)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (call_void sctl_register_let
        (param_get sctl_source) (param_get sctl_tree)
        (param_get sctl_name) (param_get sctl_ty))
      (let sctl_cond_wir i64 (call_i64 sot_build_operand
        (param_get sctl_wir) (param_get sctl_source) (param_get sctl_tree)
        (local_get sctl_cond) (call_i32 surface_type_bool)))
      (let sctl_then_expr i64 (call_i64 sot_build_operand
        (param_get sctl_wir) (param_get sctl_source) (param_get sctl_tree)
        (local_get sctl_then) (param_get sctl_ty)))
      (let sctl_else_expr i64 (call_i64 sot_build_operand
        (param_get sctl_wir) (param_get sctl_source) (param_get sctl_tree)
        (local_get sctl_else) (param_get sctl_ty)))
      (let sctl_then_name i64 (call_i64 sctl_ident
        (param_get sctl_wir) (param_get sctl_source)
        (param_get sctl_tree) (param_get sctl_name)))
      (let sctl_else_name i64 (call_i64 sctl_ident
        (param_get sctl_wir) (param_get sctl_source)
        (param_get sctl_tree) (param_get sctl_name)))
      (let sctl_then_set i64 (call_i64 wir_stmt_set
        (param_get sctl_wir) (local_get sctl_then_name)
        (local_get sctl_then_expr)))
      (let sctl_else_set i64 (call_i64 wir_stmt_set
        (param_get sctl_wir) (local_get sctl_else_name)
        (local_get sctl_else_expr)))
      (let sctl_then_do i64 (call_i64 wir_control_do (param_get sctl_wir)))
      (let sctl_else_do i64 (call_i64 wir_control_do (param_get sctl_wir)))
      (if
        (condition (or_bool
          (eq_i32 (call_i32 sctl_append
            (param_get sctl_wir) (local_get sctl_then_do)
            (local_get sctl_then_set)) (const_i32 0))
          (eq_i32 (call_i32 sctl_append
            (param_get sctl_wir) (local_get sctl_else_do)
            (local_get sctl_else_set)) (const_i32 0))))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let sctl_if_node i64 (call_i64 wir_control_if
        (param_get sctl_wir) (local_get sctl_cond_wir)
        (local_get sctl_then_do) (local_get sctl_else_do)))
      (return (call_i32 sctl_append
        (param_get sctl_wir) (param_get sctl_parent) (local_get sctl_if_node)))))

  (fn sctl_append_if_expr_return
    (params
      (sctl_wir ptr) (sctl_source ptr) (sctl_tree ptr)
      (sctl_if i64) (sctl_expected i32) (sctl_parent i64))
    (returns i32)
    (do
      (let sctl_cond i64 (call_i64 ie_cond_expr
        (param_get sctl_tree) (param_get sctl_source) (param_get sctl_if)))
      (let sctl_then i64 (call_i64 ie_then_body
        (param_get sctl_tree) (param_get sctl_source) (param_get sctl_if)))
      (let sctl_else i64 (call_i64 ie_else_body
        (param_get sctl_tree) (param_get sctl_source) (param_get sctl_if)))
      (if
        (condition (or_bool
          (eq_i64 (local_get sctl_cond) (const_i64 -1))
          (or_bool
            (eq_i64 (local_get sctl_then) (const_i64 -1))
            (or_bool
              (eq_i64 (local_get sctl_else) (const_i64 -1))
              (ne_i32 (call_i32 ie_body_is_do
                (param_get sctl_tree) (param_get sctl_source)
                (local_get sctl_else)) (const_i32 0))))))
        (then (do (return (call_i32 sctl_fail (param_get sctl_wir)))))
        (else (do)))
      (if
        (condition (or_bool
          (eq_i32 (call_i32 sctl_types_ok
            (call_i32 surface_type_bool)
            (call_i32 sst_expr_type
              (param_get sctl_tree) (param_get sctl_source)
              (local_get sctl_cond) (call_i32 surface_type_bool)))
            (const_i32 0))
          (or_bool
            (eq_i32 (call_i32 sctl_types_ok
              (param_get sctl_expected)
              (call_i32 sst_expr_type
                (param_get sctl_tree) (param_get sctl_source)
                (local_get sctl_then) (param_get sctl_expected)))
              (const_i32 0))
            (eq_i32 (call_i32 sctl_types_ok
              (param_get sctl_expected)
              (call_i32 sst_expr_type
                (param_get sctl_tree) (param_get sctl_source)
                (local_get sctl_else) (param_get sctl_expected)))
              (const_i32 0)))))
        (then (do (return (call_i32 sctl_fail (param_get sctl_wir)))))
