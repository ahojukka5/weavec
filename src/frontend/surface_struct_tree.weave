        (param_get sstr_type)))
      (if
        (condition (or_bool
          (eq_ptr (local_get sstr_wir_name) (const_null))
          (eq_i32 (call_i32 wir_scalar_expr_cstr_equal
            (local_get sstr_wir_name) (const_string_ptr "unknown"))
            (const_i32 1))))
        (then (do (return (const_null))))
        (else (do (return (local_get sstr_wir_name)))))))

