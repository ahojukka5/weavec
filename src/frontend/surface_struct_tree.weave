; SPDX-License-Identifier: Apache-2.0
; surface_struct_tree.weave — success-path lowering for struct helpers and
; field operations
;
; Semantic validation stays in struct.weave and struct_semantic_*.weave. This
; module builds owned WIR subtrees for generated helpers, new, field-get, and
; field-set, then publishes complete roots through wir_subtree_publish.
; Unmigrated children return failure so the caller can keep the text renderer.
; A failed judgment never publishes a partial subtree.

(program
  (name "surface_struct_tree")
  (version "0.1")

  (fn sstr_struct_name_atom
    (params (sstr_wir ptr) (sstr_type i32))
    (returns i64)
    (do
      (let sstr_owned_name ptr (call_ptr weave_surface_struct_wir_name
        (param_get sstr_type)))
      (if
        (condition (eq_ptr (local_get sstr_owned_name) (const_null)))
        (then (do
          (call_i32 wir_tree_mark_failed (param_get sstr_wir))
          (return (const_i64 -1))))
        (else (do)))
      (return (call_i64 wir_atom
        (param_get sstr_wir) (local_get sstr_owned_name)))))

  (fn sstr_call_type_name
    (params (sstr_type i32))
    (returns ptr)
    (do
