        (condition (ne_i64 (local_get sstr_fill_field) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 sstr_forest_append
              (param_get sstr_wir) (param_get sstr_fill_forest)
              (call_i64 sstr_build_getter
                (param_get sstr_wir) (param_get sstr_source)
                (param_get sstr_tree) (local_get sstr_fill_type)
                (local_get sstr_fill_field))
              (local_get sstr_fill_field)) (const_i32 0)))
            (then (do (return (const_i32 0))))
            (else (do)))
          (if
            (condition (eq_i32 (call_i32 sstr_forest_append
              (param_get sstr_wir) (param_get sstr_fill_forest)
              (call_i64 sstr_build_setter
                (param_get sstr_wir) (param_get sstr_source)
                (param_get sstr_tree) (local_get sstr_fill_type)
                (local_get sstr_fill_field))
              (local_get sstr_fill_field)) (const_i32 0)))
            (then (do (return (const_i32 0))))
            (else (do)))
          (set sstr_fill_field (call_i64 sstr_next_field
            (param_get sstr_tree) (param_get sstr_source)
            (local_get sstr_fill_field)))))
      (if
        (condition (ne_i32 (call_i32 wir_tree_failed (param_get sstr_wir))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (return (const_i32 1))))

  (fn sstr_try_publish_helpers
    (params
      (sstr_fd i32) (sstr_source ptr) (sstr_tree ptr) (sstr_node i64))
    (returns i32)
    (do
      (let sstr_decl_wir ptr (call_ptr wir_tree_new))
      (if
        (condition (eq_ptr (local_get sstr_decl_wir) (const_null)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let sstr_decl_root i64 (call_i64 sstr_build_helpers
        (local_get sstr_decl_wir) (param_get sstr_source) (param_get sstr_tree)
        (param_get sstr_node)))
      (let sstr_decl_ok i32 (call_i32 sstr_publish_forest
        (param_get sstr_fd) (param_get sstr_source) (param_get sstr_tree)
        (local_get sstr_decl_wir) (local_get sstr_decl_root)))
      (call_void wir_tree_free (local_get sstr_decl_wir))
      (return (local_get sstr_decl_ok))))
)
