; SPDX-License-Identifier: Apache-2.0
; lower.weave — surface Weave → WIR text lowering
;
; Transforms a parsed surface Weave program node into WIR text on fd.
;
; The strategy is direct text emission: we walk the input AST and emit
; WIR s-expressions without building an intermediate tree. This avoids
; the complex tree-building API used by the original weavec-bootstrap.
;
; Transformation rules:
;   program wrapper    → core-module / core-version 2 / decls wrapper
;   extern decl        → emitted verbatim in the decls list
;   fn decl            → emitted verbatim in the decls list
;   entry NAME ...     → fn NAME ... (head renamed from entry to fn)
;   const NAME TYPE V  → zero-arg fn returning the constant
;   struct NAME fields → generated getter/setter functions (struct.weave)
;   name, version      → skipped (metadata only)
;
; Two-pass ordering:
;   Pass 1: emit all (extern ...) nodes first (LLVM IR: declare before define)
;   Pass 2: emit all fn/entry/const/struct nodes

(program
  (name "lower")
  (version "0.1")

  (fn emit_wir_header
    (params (fd i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "(core-module"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  (core-version 2)"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  (decls"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (return_void)))

  (fn emit_wir_footer
    (params (fd i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "  )"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr ")"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (return_void)))

  ; Emit an (extern ...) or (fn ...) node indented under (decls ...).
  (fn emit_decl
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "    "))
      (call_void emit_node (param_get fd) (param_get source) (param_get tree) (param_get node))
      (call_void write_byte (param_get fd) (const_i32 10))
      (return_void)))

  ; Emit an (entry NAME ...) node as (fn NAME ...) by replacing the head.
  (fn lower_entry
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (call_void emit_source_span_for_node
        (param_get fd) (param_get source) (param_get tree) (param_get node))
      (call_void write_cstr (param_get fd) (const_string_ptr "    (fn"))
      ; skip the "entry" head, emit the rest of the children verbatim
      (let head i64 (call_i64 node_first_child (param_get tree) (param_get node)))
      (let child i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_node (param_get fd) (param_get source) (param_get tree) (local_get child))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (call_void write_byte (param_get fd) (const_i32 41))
      (call_void write_byte (param_get fd) (const_i32 10))
      (return_void)))

  ; Emit a (const NAME TYPE VALUE) as a zero-arg WIR function:
  ;   (fn NAME (params) (returns TYPE) (do (return (const_TYPE VALUE))))
  ; For ptr type the value is always (const_null) regardless of the source value.
  (fn lower_const
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (let name_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
      (let type_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
      (let val_node  i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
      (let is_ptr i32 (call_i32 ident_equals
        (param_get tree) (param_get source) (local_get type_node)
        (const_string_ptr "ptr") (const_i64 3)))
      (call_void emit_source_span_for_node
        (param_get fd) (param_get source) (param_get tree) (param_get node))
      (call_void write_cstr (param_get fd) (const_string_ptr "    (fn "))
      (call_void emit_node (param_get fd) (param_get source) (param_get tree) (local_get name_node))
      (call_void write_cstr (param_get fd) (const_string_ptr " (params) (returns "))
      (call_void emit_node (param_get fd) (param_get source) (param_get tree) (local_get type_node))
      (call_void write_cstr (param_get fd) (const_string_ptr ") (do (return "))
      (if
        (condition (ne_i32 (local_get is_ptr) (const_i32 0)))
        (then (do
          (call_void write_cstr (param_get fd) (const_string_ptr "(const_null)"))))
        (else (do
          (call_void write_cstr (param_get fd) (const_string_ptr "(const_"))
          (call_void write_node_text (param_get fd) (param_get source) (param_get tree) (local_get type_node))
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_node (param_get fd) (param_get source) (param_get tree) (local_get val_node))
          (call_void write_byte (param_get fd) (const_i32 41)))))
      (call_void write_cstr (param_get fd) (const_string_ptr ")))"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (return_void)))

  ; Return the first child of the program node that is a decl (skips name/version).
  (fn program_first_decl
    (params (tree ptr) (source ptr))
    (returns i64)
    (do
      ; root is node 0; first child is the "program" keyword
      (let head i64 (call_i64 node_first_child (param_get tree) (const_i64 0)))
      ; start after "program"
      (let child i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (and_bool
                  (eq_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                    (const_string_ptr "name") (const_i64 4)) (const_i32 0))
                  (eq_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                    (const_string_ptr "version") (const_i64 7)) (const_i32 0))))
                (then (do (return (local_get child))))
                (else (do
                  (set child (call_i64 node_next_sibling (param_get tree) (local_get child))))))))
            (else (do
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child))))))))
      (return (const_i64 -1))))

  ; Emit only the top-level extern declarations from a parsed program.
  (fn lower_program_externs
    (params (fd i32) (source ptr) (tree ptr))
    (returns i32)
    (do
      (let first_decl i64 (call_i64 program_first_decl (param_get tree) (param_get source)))
      (let child i64 (local_get first_decl))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "extern") (const_i64 6)) (const_i32 0)))
                (then (do
                  (call_void emit_decl (param_get fd) (param_get source) (param_get tree) (local_get child))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  ; Emit non-extern declarations from a parsed program.
  (fn lower_program_decls
    (params (fd i32) (source ptr) (tree ptr))
    (returns i32)
    (do
      (let first_decl i64 (call_i64 program_first_decl (param_get tree) (param_get source)))
      (if
        (condition (ne_i32 (call_i32 validate_program_effect_clauses
          (param_get tree) (param_get source) (local_get first_decl)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (let effect_table ptr (call_ptr effect_table_build
        (param_get tree) (param_get source) (local_get first_decl)))
      (let child i64 (local_get first_decl))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 lower_fn
                      (param_get fd) (param_get source) (param_get tree) (local_get child) (local_get effect_table)) (const_i32 0)))
                    (then (do
                      (call_void effect_table_free (local_get effect_table))
                      (return (const_i32 1))))
                    (else (do)))))
                (else (do)))
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "entry") (const_i64 5)) (const_i32 0)))
                (then (do
                  (if
                    (condition (gt_i64 (call_i64 count_children (param_get tree) (local_get child)) (const_i64 2)))
                    (then (do
                      (call_void lower_entry (param_get fd) (param_get source) (param_get tree) (local_get child))))
                    (else (do)))))
                (else (do)))
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "const") (const_i64 5)) (const_i32 0)))
                (then (do
                  (call_void lower_const (param_get fd) (param_get source) (param_get tree) (local_get child))))
                (else (do)))
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "struct") (const_i64 6)) (const_i32 0)))
                (then (do
                  (call_void lower_struct (param_get fd) (param_get source) (param_get tree) (local_get child))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (call_void effect_table_free (local_get effect_table))
      (return (const_i32 0))))

  ; Lower the top-level (program ...) to WIR text.
  ; Returns 0 on success, 1 on error.
  (fn lower_program
    (params (fd i32) (source ptr) (tree ptr))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 validate_quantum_program
          (param_get tree) (param_get source)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (call_void emit_wir_header (param_get fd))
      (let extern_status i32 (call_i32 lower_program_externs
        (param_get fd) (param_get source) (param_get tree)))
      (if
        (condition (ne_i32 (local_get extern_status) (const_i32 0)))
        (then (do (return (local_get extern_status))))
        (else (do)))
      (let decl_status i32 (call_i32 lower_program_decls
        (param_get fd) (param_get source) (param_get tree)))
      (if
        (condition (ne_i32 (local_get decl_status) (const_i32 0)))
        (then (do (return (local_get decl_status))))
        (else (do)))
      (call_void emit_wir_footer (param_get fd))
      (return (const_i32 0))))

  (fn type_kind_qubit (params ()) (returns i32) (do (return (const_i32 1))))
  (fn type_kind_unknown (params ()) (returns i32) (do (return (const_i32 0))))

  (fn parse_surface_type
      (params (tree ptr) (source ptr) (type_node i64))
      (returns i32)
      (do
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
            (const_string_ptr "Qubit") (const_i64 5)) (const_i32 0)))
          (then (do (return (call_i32 type_kind_qubit))))
          (else (do)))
        (return (call_i32 type_kind_unknown))))

  (fn qgate_expected_arity
      (params (tree ptr) (source ptr) (gate_node i64))
      (returns i32)
      (do
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "H") (const_i64 1)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "X") (const_i64 1)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "Y") (const_i64 1)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "Z") (const_i64 1)) (const_i32 0)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "CNOT") (const_i64 4)) (const_i32 0)))
          (then (do (return (const_i32 2))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "RY") (const_i64 2)) (const_i32 0)))
          (then (do (return (const_i32 2))))
          (else (do)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get gate_node)
            (const_string_ptr "RZ") (const_i64 2)) (const_i32 0)))
          (then (do (return (const_i32 2))))
          (else (do)))
        (return (const_i32 127))))

  (fn validate_qgate
      (params (tree ptr) (source ptr) (node i64) (last_type i32))
      (returns i32)
      (do
        (let gate_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
        (let arity i32 (call_i32 qgate_expected_arity (param_get tree) (param_get source) (local_get gate_node)))
        (if
          (condition (eq_i32 (local_get arity) (const_i32 127)))
          (then (do (return (const_i32 0))))
          (else (do)))
        (let actual i64 (sub_i64 (call_i64 count_children (param_get tree) (param_get node)) (const_i64 2)))
        (if
          (condition (ne_i64 (local_get actual) (cast_i32_to_i64 (local_get arity))))
          (then (do (return (const_i32 1))))
          (else (do)))
        (let q0 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
        (if
          (condition (ne_i32 (call_i32 node_kind (param_get tree) (local_get q0)) (call_i32 node_ident)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (if
          (condition (eq_i32 (local_get arity) (const_i32 1)))
          (then (do
            (if
              (condition (ne_i32 (param_get last_type) (call_i32 type_kind_qubit)))
              (then (do (return (const_i32 1))))
              (else (do)))
            (return (const_i32 0))))
          (else (do)))
        (let q1 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
        (if
          (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
            (const_string_ptr "CNOT") (const_i64 4)) (const_i32 0)))
          (then (do
            (if
              (condition (ne_i32 (call_i32 node_kind (param_get tree) (local_get q1)) (call_i32 node_ident)))
              (then (do (return (const_i32 1))))
              (else (do)))
            (if
              (condition (ne_i32 (param_get last_type) (call_i32 type_kind_qubit)))
              (then (do (return (const_i32 1))))
              (else (do)))
            (return (const_i32 0))))
          (else (do)))
        (if
          (condition (ne_i32 (param_get last_type) (call_i32 type_kind_qubit)))
          (then (do (return (const_i32 1))))
          (else (do)))
        (return (const_i32 0))))

  (fn let_binding_surface_type
    (params (tree ptr) (source ptr) (node i64) (cur_type i32))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (param_get cur_type))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do (return (param_get cur_type))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
          (const_string_ptr "let") (const_i64 3)) (const_i32 0)))
        (then (do (return (param_get cur_type))))
        (else (do)))
      (if
        (condition (ne_i64 (call_i64 count_children (param_get tree) (param_get node)) (const_i64 4)))
        (then (do (return (param_get cur_type))))
        (else (do)))
      (let type_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
      (return (call_i32 parse_surface_type
        (param_get tree) (param_get source) (local_get type_node)))))

  (fn validate_children
    (params (tree ptr) (source ptr) (node i64) (last_type i32))
    (returns i32)
    (do
      (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
      (let cur_type i32 (param_get last_type))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 validate_node
              (param_get tree) (param_get source) (local_get child) (local_get cur_type)) (const_i32 0)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (set cur_type (call_i32 let_binding_surface_type
            (param_get tree) (param_get source) (local_get child) (local_get cur_type)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn validate_node
      (params (tree ptr) (source ptr) (node i64) (last_type i32))
      (returns i32)
      (do
        (if
          (condition (eq_i64 (param_get node) (const_i64 -1)))
          (then (do (return (const_i32 0))))
          (else (do)))
        (let kind i32 (call_i32 node_kind (param_get tree) (param_get node)))
        (if
          (condition (eq_i32 (local_get kind) (call_i32 node_list)))
          (then (do
            (if
              (condition (and_bool
                (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                  (const_string_ptr "let") (const_i64 3)) (const_i32 0))
                (eq_i64 (call_i64 count_children (param_get tree) (param_get node)) (const_i64 4))))
              (then (do
                (let type_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
                (return (call_i32 validate_children
                  (param_get tree) (param_get source) (param_get node)
                  (call_i32 parse_surface_type (param_get tree) (param_get source) (local_get type_node))))))
              (else (do)))
            (if
              (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                (const_string_ptr "qgate") (const_i64 5)) (const_i32 0)))
              (then (do
                (if
                  (condition (ne_i32 (call_i32 validate_qgate
                    (param_get tree) (param_get source) (param_get node) (param_get last_type)) (const_i32 0)))
                  (then (do (return (const_i32 1))))
                  (else (do)))))
              (else (do)))
            (return (call_i32 validate_children
              (param_get tree) (param_get source) (param_get node) (param_get last_type)))))
          (else (do)))
        (return (const_i32 0))))

  (fn validate_quantum_program
      (params (tree ptr) (source ptr))
      (returns i32)
      (do
        (return (call_i32 validate_node
          (param_get tree) (param_get source) (const_i64 0) (call_i32 type_kind_unknown)))))

  (fn lower_fn
    (params (fd i32) (source ptr) (tree ptr) (fn_node i64) (effect_table ptr))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 fn_has_contract_clauses
          (param_get tree) (param_get source) (param_get fn_node)) (const_i32 0)))
        (then (do
          (return (call_i32 emit_fn_with_contracts
            (param_get fd) (param_get source) (param_get tree) (param_get fn_node) (param_get effect_table)))))
        (else (do)))
      (call_void emit_decl (param_get fd) (param_get source) (param_get tree) (param_get fn_node))
      (return (const_i32 0))))
)