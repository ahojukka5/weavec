; SPDX-License-Identifier: Apache-2.0
; surface_op_render.weave — Canonical operator WIR rendering helpers.
;
; Surface synonym -> WIR base-name mapping is owned by
; surface_op_canonical.weave. This renderer only serializes already-admitted
; semantic decisions during the tree-migration window.

(program
  (name "surface_op_render")
  (version "0.1")

  (fn sop_emit_failure_expr
    (params (sop_fd i32))
    (returns void)
    (do
      (call_void write_cstr (param_get sop_fd) (const_string_ptr "(const_i32 0)"))
      (return_void)))

  (fn sop_emit_operator_name
    (params (sop_fd i32) (sop_tree ptr) (sop_source ptr)
      (sop_name_node i64))
    (returns void)
    (do
      (let sop_base ptr (call_ptr sop_canonical_base_ptr
        (param_get sop_tree) (param_get sop_source) (param_get sop_name_node)))
      ; The semantic operator validator rejects unknown names before successful
      ; rendering. Keep the historical `ge` fallback for defensive compatibility
      ; with any internal direct caller during migration.
      (if
        (condition (eq_ptr (local_get sop_base) (const_null)))
        (then (do
          (call_void write_cstr (param_get sop_fd) (const_string_ptr "ge"))
          (return_void)))
        (else (do)))
      (call_void write_cstr (param_get sop_fd) (local_get sop_base))
      (return_void)))

  (fn sop_emit_binary
    (params (sop_fd i32) (sop_source ptr) (sop_tree ptr) (sop_name_node i64)
      (sop_left_node i64) (sop_right_node i64) (sop_operand_type i32))
    (returns void)
    (do
      (call_void write_byte (param_get sop_fd) (const_i32 40))
      (call_void sop_emit_operator_name
        (param_get sop_fd) (param_get sop_tree) (param_get sop_source)
        (param_get sop_name_node))
      (call_void write_byte (param_get sop_fd) (const_i32 95))
      (call_void surface_emit_type_name (param_get sop_fd) (param_get sop_operand_type))
      (call_void write_byte (param_get sop_fd) (const_i32 32))
      (call_void surface_emit_expr_expected
        (param_get sop_fd) (param_get sop_source) (param_get sop_tree)
        (param_get sop_left_node) (param_get sop_operand_type))
      (call_void write_byte (param_get sop_fd) (const_i32 32))
      (call_void surface_emit_expr_expected
        (param_get sop_fd) (param_get sop_source) (param_get sop_tree)
        (param_get sop_right_node) (param_get sop_operand_type))
      (call_void write_byte (param_get sop_fd) (const_i32 41))
      (return_void)))

  (fn sop_emit_boolean_binary
    (params (sop_fd i32) (sop_source ptr) (sop_tree ptr) (sop_name_node i64)
      (sop_left_node i64) (sop_right_node i64))
    (returns void)
    (do
      ; Semantic name/arity/type validation has already completed in
      ; surface_emit_canonical_op. Try the structural leaf-only migration path.
      (let sop_tree_status i32 (call_i32 sop_tree_try_boolean_binary
        (param_get sop_fd) (param_get sop_source) (param_get sop_tree)
        (param_get sop_name_node) (param_get sop_left_node) (param_get sop_right_node)))
      (if
        (condition (eq_i32 (local_get sop_tree_status) (const_i32 1)))
        (then (do (return_void)))
        (else (do)))
      (if
        (condition (lt_i32 (local_get sop_tree_status) (const_i32 0)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "operator"))
          (call_void write_cstr (const_i32 2)
            (const_string_ptr "failed to build canonical boolean operator WIR"))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void sop_emit_failure_expr (param_get sop_fd))
          (return_void)))
        (else (do)))

      ; Unsupported nested operands have not allocated a WIR tree. Preserve the
      ; legacy renderer until recursive expression migration reaches them.
      (call_void write_byte (param_get sop_fd) (const_i32 40))
      (call_void sop_emit_operator_name
        (param_get sop_fd) (param_get sop_tree) (param_get sop_source)
        (param_get sop_name_node))
      (call_void write_cstr (param_get sop_fd) (const_string_ptr "_bool"))
      (call_void write_byte (param_get sop_fd) (const_i32 32))
      (call_void surface_emit_expr_expected
        (param_get sop_fd) (param_get sop_source) (param_get sop_tree)
        (param_get sop_left_node) (call_i32 surface_type_bool))
      (call_void write_byte (param_get sop_fd) (const_i32 32))
      (call_void surface_emit_expr_expected
        (param_get sop_fd) (param_get sop_source) (param_get sop_tree)
        (param_get sop_right_node) (call_i32 surface_type_bool))
      (call_void write_byte (param_get sop_fd) (const_i32 41))
      (return_void)))

)
