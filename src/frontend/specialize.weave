          (call_void tokens_free (local_get spec_tok))
          (call_void free (local_get spec_src))
          (return (call_i32 spec_fail
            (const_string_ptr "cannot bind concrete type arguments")))))
        (else (do)))
      (call_void weave_surface_spec_mark_emitted (param_get spec_index))
      (call_void write_cstr (param_get fd) (const_string_ptr "    "))
      (call_void spec_emit_fn
        (param_get fd) (local_get spec_src) (local_get spec_tree)
        (local_get spec_decl)
        (call_ptr weave_surface_spec_name (param_get spec_index)))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void weave_surface_type_params_reset)
      (call_void tree_free (local_get spec_tree))
      (call_void tokens_free (local_get spec_tok))
      (call_void free (local_get spec_src))
      (return (const_i32 0))))

  (fn surface_emit_pending_specs
    (params (fd i32))
    (returns i32)
    (do
      (let spec_guard i32 (const_i32 0))
      (let spec_again i32 (const_i32 1))
      (while
        (condition (ne_i32 (local_get spec_again) (const_i32 0)))
        (do
          (set spec_again (const_i32 0))
          (let spec_i i32 (const_i32 0))
          (let spec_n i32 (call_i32 weave_surface_spec_count))
          (if
            (condition (gt_i32 (local_get spec_n) (call_i32 spec_max_count)))
            (then (do
              (call_void surface_error_prefix (const_string_ptr "specialize"))
              (call_void write_cstr
                (const_i32 2)
                (const_string_ptr "too many generic specializations"))
              (call_void write_byte (const_i32 2) (const_i32 10))
              (return (const_i32 1))))
            (else (do)))
          (while
            (condition (lt_i32 (local_get spec_i) (local_get spec_n)))
            (do
              (if
                (condition (eq_i32 (call_i32 weave_surface_spec_emitted
                  (local_get spec_i)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 spec_emit_one
                      (param_get fd) (local_get spec_i)) (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))
                  (set spec_again (const_i32 1))))
                (else (do)))
              (set spec_i (add_i32 (local_get spec_i) (const_i32 1)))))
          (set spec_guard (add_i32 (local_get spec_guard) (const_i32 1)))
          (if
            (condition (gt_i32 (local_get spec_guard) (call_i32 spec_max_count)))
            (then (do
              (call_void surface_error_prefix (const_string_ptr "specialize"))
              (call_void write_cstr
                (const_i32 2)
                (const_string_ptr "specialization did not reach a fixed point"))
              (call_void write_byte (const_i32 2) (const_i32 10))
              (return (const_i32 1))))
            (else (do)))))
      (return (const_i32 0))))
)