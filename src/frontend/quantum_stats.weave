; SPDX-License-Identifier: Apache-2.0
; quantum_stats.weave — lowered-quantum metrics for --dump-quantum-stats
;
; Counts mirror emit.weave (H→RY+RZ nativization, H·H peephole, CNOT→qrt_cnot).

(program
  (name "quantum_stats")
  (version "0.1")

  (fn stats_ctx_new
    (params ())
    (returns ptr)
    (do
      (let ctx ptr (call_ptr malloc (const_i64 24)))
      (if
        (condition (eq_ptr (local_get ctx) (const_null)))
        (then (do (return (const_null))))
        (else (do)))
      (store_i64 (local_get ctx) (const_i64 0))
      (store_i64 (ptr_add (local_get ctx) (const_i64 8)) (const_i64 0))
      (store_i64 (ptr_add (local_get ctx) (const_i64 16)) (const_i64 0))
      (return (local_get ctx))))

  (fn stats_ctx_free
    (params (ctx ptr))
    (returns void)
    (do
      (if
        (condition (ne_ptr (param_get ctx) (const_null)))
        (then (do (call_void free (param_get ctx))))
        (else (do)))
      (return_void)))

  (fn stats_add_native
    (params (ctx ptr) (n i64))
    (returns void)
    (do
      (let cur i64 (load_i64 (param_get ctx)))
      (store_i64 (param_get ctx) (add_i64 (local_get cur) (param_get n)))
      (let d i64 (load_i64 (ptr_add (param_get ctx) (const_i64 16))))
      (store_i64 (ptr_add (param_get ctx) (const_i64 16)) (add_i64 (local_get d) (param_get n)))
      (return_void)))

  (fn stats_add_two_qubit
    (params (ctx ptr) (n i64))
    (returns void)
    (do
      (let cur i64 (load_i64 (ptr_add (param_get ctx) (const_i64 8))))
      (store_i64 (ptr_add (param_get ctx) (const_i64 8)) (add_i64 (local_get cur) (param_get n)))
      (return_void)))

  (fn stats_count_qgate_direct
    (params (ctx ptr) (tree ptr) (source ptr) (node i64))
    (returns void)
    (do
      (let gate_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "H") (const_i64 1)) (const_i32 0)))
        (then (do
          (call_void stats_add_native (param_get ctx) (const_i64 2))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "CNOT") (const_i64 4)) (const_i32 0)))
        (then (do
          (call_void stats_add_native (param_get ctx) (const_i64 1))
          (call_void stats_add_two_qubit (param_get ctx) (const_i64 1))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "CZ") (const_i64 2)) (const_i32 0)))
        (then (do
          (call_void stats_add_native (param_get ctx) (const_i64 1))
          (call_void stats_add_two_qubit (param_get ctx) (const_i64 1))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "SWAP") (const_i64 4)) (const_i32 0)))
        (then (do
          (call_void stats_add_native (param_get ctx) (const_i64 1))
          (call_void stats_add_two_qubit (param_get ctx) (const_i64 1))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "CCNOT") (const_i64 5)) (const_i32 0)))
        (then (do
          (call_void stats_add_native (param_get ctx) (const_i64 1))
          (call_void stats_add_two_qubit (param_get ctx) (const_i64 1))
          (return_void)))
        (else (do)))
      (call_void stats_add_native (param_get ctx) (const_i64 1))
      (return_void)))

  ; Mirror of emit_do_step (see emit.weave) for stats counting: returns the
  ; new pending qgate node id (or -1) and counts the previous pending / current
  ; child as needed. Lifted out so the loop body has a single top-level
  ; (set pending ...) — see notes in emit.weave.
  (fn stats_do_step
    (params (ctx ptr) (tree ptr) (source ptr) (pending i64) (child i64))
    (returns i64)
    (do
      (if
        (condition (ne_i32 (call_i32 qgate_is_self_inverse_candidate
          (param_get tree) (param_get source) (param_get child)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (call_i32 qgate_self_inverse_match
              (param_get tree) (param_get source) (param_get pending) (param_get child)) (const_i32 0)))
            (then (do (return (const_i64 -1))))
            (else (do)))
          (if
            (condition (ne_i64 (param_get pending) (const_i64 -1)))
            (then (do
              (call_void stats_count_qgate_direct
                (param_get ctx) (param_get tree) (param_get source) (param_get pending))))
            (else (do)))
          (return (param_get child))))
        (else (do)))
      (if
        (condition (ne_i64 (param_get pending) (const_i64 -1)))
        (then (do
          (call_void stats_count_qgate_direct
            (param_get ctx) (param_get tree) (param_get source) (param_get pending))))
        (else (do)))
      (call_void stats_count_node (param_get ctx) (param_get tree) (param_get source) (param_get child))
      (return (const_i64 -1))))

  (fn stats_count_do_body
    (params (ctx ptr) (tree ptr) (source ptr) (do_node i64))
    (returns void)
    (do
      (let pending i64 (const_i64 -1))
      (let head i64 (call_i64 node_first_child (param_get tree) (param_get do_node)))
      (let child i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (set pending (call_i64 stats_do_step
            (param_get ctx) (param_get tree) (param_get source)
            (local_get pending) (local_get child)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (if
        (condition (ne_i64 (local_get pending) (const_i64 -1)))
        (then (do
          (call_void stats_count_qgate_direct
            (param_get ctx) (param_get tree) (param_get source) (local_get pending))))
        (else (do)))
      (return_void)))

  (fn stats_count_node
    (params (ctx ptr) (tree ptr) (source ptr) (node i64))
    (returns void)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
          (const_string_ptr "do") (const_i64 2)) (const_i32 0)))
        (then (do
          (call_void stats_count_do_body
            (param_get ctx) (param_get tree) (param_get source) (param_get node))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
          (const_string_ptr "qgate") (const_i64 5)) (const_i32 0)))
        (then (do
          (call_void stats_count_qgate_direct
            (param_get ctx) (param_get tree) (param_get source) (param_get node))
          (return_void)))
        (else (do)))
      (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (call_void stats_count_node (param_get ctx) (param_get tree) (param_get source) (local_get child))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return_void)))

  (fn stats_count_program
    (params (ctx ptr) (tree ptr) (source ptr))
    (returns void)
    (do
      (call_void stats_count_node (param_get ctx) (param_get tree) (param_get source) (const_i64 0))
      (return_void)))

  (fn write_stats_file
    (params (fd i32) (ctx ptr))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "native_gates="))
      (call_void write_i64_dec (param_get fd) (load_i64 (param_get ctx)))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "two_qubit_gates="))
      (call_void write_i64_dec (param_get fd) (load_i64 (ptr_add (param_get ctx) (const_i64 8))))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "depth="))
      (call_void write_i64_dec (param_get fd) (load_i64 (ptr_add (param_get ctx) (const_i64 16))))
      (call_void write_byte (param_get fd) (const_i32 10))
      (return_void)))

  ; Parse surface file and write metrics. Returns 0 on success.
  (fn dump_quantum_stats_file
    (params (input_path ptr) (output_path ptr))
    (returns i32)
    (do
      (let in_fd i32 (call_i32 open (param_get input_path) (const_i32 0) (const_i32 0)))
      (if
        (condition (lt_i32 (local_get in_fd) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (let file_size i64 (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 2)))
      (if
        (condition (lt_i64 (local_get file_size) (const_i64 0)))
        (then (do
          (call_i32 close (local_get in_fd))
          (return (const_i32 1))))
        (else (do)))
      (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 0))
      (let source ptr (call_ptr malloc (add_i64 (local_get file_size) (const_i64 1))))
      (if
        (condition (eq_ptr (local_get source) (const_null)))
        (then (do
          (call_i32 close (local_get in_fd))
          (return (const_i32 1))))
        (else (do)))
      (let bytes_read i64 (call_i64 read (local_get in_fd) (local_get source) (local_get file_size)))
      (call_i32 close (local_get in_fd))
      (if
        (condition (ne_i64 (local_get bytes_read) (local_get file_size)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (store_i8 (ptr_add (local_get source) (local_get file_size)) (const_i32 0))
      (let tokens ptr (call_ptr lex (local_get source) (local_get file_size)))
      (if
        (condition (eq_ptr (local_get tokens) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (let tree ptr (call_ptr parse (local_get tokens)))
      (if
        (condition (eq_ptr (local_get tree) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 validate_quantum_program
          (local_get tree) (local_get source)) (const_i32 0)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (let ctx ptr (call_ptr stats_ctx_new))
      (if
        (condition (eq_ptr (local_get ctx) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (call_void stats_count_program (local_get ctx) (local_get tree) (local_get source))
      (let out_fd i32 (call_i32 weave_rt_open_write_trunc (param_get output_path) (const_i32 420)))
      (if
        (condition (lt_i32 (local_get out_fd) (const_i32 0)))
        (then (do
          (call_void stats_ctx_free (local_get ctx))
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (call_void write_stats_file (local_get out_fd) (local_get ctx))
      (call_i32 close (local_get out_fd))
      (call_void stats_ctx_free (local_get ctx))
      (call_void free (local_get source))
      (return (const_i32 0))))
)
