; SPDX-License-Identifier: Apache-2.0
; struct_semantic_calls.weave — semantic struct lowering slice

(program
  (name "struct_semantic_calls")
  (version "0.1")

  (fn sst_emit_call_prefix
      (params (sst_fd i32) (sst_return_type i32))
      (returns void)
      (do
        (call_void write_cstr (param_get sst_fd) (const_string_ptr "(call_"))
        (call_void sst_emit_wir_type (param_get sst_fd) (param_get sst_return_type))
        (return_void)))

  (fn sst_emit_call
      (params (sst_fd i32) (sst_source ptr) (sst_tree ptr) (sst_node i64))
      (returns void)
      (do
        (if
          (condition (lt_i64 (call_i64 count_children
            (param_get sst_tree) (param_get sst_node)) (const_i64 2)))
          (then (do
            (call_void sdiag_emit_call
              (param_get sst_fd) (param_get sst_source) (param_get sst_tree)
              (param_get sst_node))
            (return_void)))
          (else (do)))
        (let sst_name_node i64 (call_i64 nth_child
          (param_get sst_tree) (param_get sst_node) (const_i64 1)))
        (if
          (condition (eq_i32 (call_i32 surface_node_is_ident
            (param_get sst_tree) (local_get sst_name_node)) (const_i32 0)))
          (then (do
            (call_void sdiag_emit_call
              (param_get sst_fd) (param_get sst_source) (param_get sst_tree)
              (param_get sst_node))
            (return_void)))
          (else (do)))
        (let sst_name_start i64 (call_i64 node_text_start
          (param_get sst_tree) (local_get sst_name_node)))
        (let sst_name_length i64 (call_i64 node_text_len
          (param_get sst_tree) (local_get sst_name_node)))
        (let sst_return_type i32 (call_i32 weave_surface_symbol_return_type
          (param_get sst_source) (local_get sst_name_start)
          (local_get sst_name_length)))
        (let sst_generic_arity i32 (call_i32 weave_surface_symbol_type_param_count
          (param_get sst_source) (local_get sst_name_start)
          (local_get sst_name_length)))
        (if
          (condition (gt_i32 (local_get sst_generic_arity) (const_i32 0)))
          (then (do
            (call_void surface_error_prefix (const_string_ptr "call"))
            (call_void write_cstr
              (const_i32 2)
              (const_string_ptr "generic function "))
            (call_void emit_node_text
              (const_i32 2) (param_get sst_source) (param_get sst_tree)
              (local_get sst_name_node))
            (call_void write_cstr
              (const_i32 2)
              (const_string_ptr " cannot be called until it is specialized"))
            (call_void write_byte (const_i32 2) (const_i32 10))
            (call_void sdiag_record
              (param_get sst_tree) (param_get sst_source) (param_get sst_node)
              (const_string_ptr "frontend.type.unspecialized-call")
              (call_i32 surface_type_unknown) (call_i32 surface_type_unknown)
              (const_i32 -1) (const_i32 -1) (const_i32 -1)
              (const_string_ptr "call") (local_get sst_name_node) (const_i32 0))
            (return_void)))
          (else (do)))
        (let sst_expected_count i32 (call_i32 weave_surface_symbol_parameter_count
          (param_get sst_source) (local_get sst_name_start)
          (local_get sst_name_length)))
        (let sst_actual_count i64 (sub_i64
          (call_i64 count_children (param_get sst_tree) (param_get sst_node))
          (const_i64 2)))
        (if
          (condition (or_bool
            (eq_i32 (local_get sst_return_type) (call_i32 surface_type_unknown))
            (and_bool
              (ge_i32 (local_get sst_expected_count) (const_i32 0))
              (ne_i64 (local_get sst_actual_count)
                (cast_i32_to_i64 (local_get sst_expected_count))))))
          (then (do
            (call_void sdiag_emit_call
              (param_get sst_fd) (param_get sst_source) (param_get sst_tree)
              (param_get sst_node))
            (return_void)))
          (else (do)))
        (call_void sst_emit_call_prefix
          (param_get sst_fd) (local_get sst_return_type))
        (call_void write_byte (param_get sst_fd) (const_i32 32))
        (call_void surface_emit_symbol_name
          (param_get sst_fd) (param_get sst_source) (param_get sst_tree)
          (local_get sst_name_node))
        (let sst_argument i64 (call_i64 node_next_sibling
          (param_get sst_tree) (local_get sst_name_node)))
        (let sst_argument_index i32 (const_i32 0))
        (while
          (condition (ne_i64 (local_get sst_argument) (const_i64 -1)))
          (do
            (let sst_expected_type i32 (call_i32 weave_surface_symbol_parameter_type
              (param_get sst_source) (local_get sst_name_start)
              (local_get sst_name_length) (local_get sst_argument_index)))
            (let sst_actual_type i32 (call_i32 sop_expr_type
              (param_get sst_tree) (param_get sst_source) (local_get sst_argument)
              (local_get sst_expected_type)))
            (if
              (condition (and_bool
                (ne_i32 (local_get sst_expected_type) (call_i32 surface_type_unknown))
                (and_bool
                  (ne_i32 (local_get sst_actual_type) (call_i32 surface_type_unknown))
                  (eq_i32 (call_i32 sst_types_compatible
                    (local_get sst_expected_type) (local_get sst_actual_type))
                  (const_i32 0)))))
              (then (do
                (call_void sst_human_prefix (const_string_ptr "call"))
                (call_void write_cstr
                  (const_i32 2) (const_string_ptr "argument type mismatch for "))
                (call_void emit_node_text
                  (const_i32 2) (param_get sst_source) (param_get sst_tree)
                  (local_get sst_name_node))
                (call_void write_cstr (const_i32 2) (const_string_ptr ": expected "))
                (call_void sst_emit_type_name
                  (const_i32 2) (local_get sst_expected_type))
                (call_void write_cstr (const_i32 2) (const_string_ptr ", got "))
                (call_void sst_emit_type_name
                  (const_i32 2) (local_get sst_actual_type))
                (call_void write_byte (const_i32 2) (const_i32 10))
                (call_void sst_record
                  (param_get sst_tree) (param_get sst_source) (local_get sst_argument)
                  (const_string_ptr "frontend.call.argument-type-mismatch")
                  (local_get sst_expected_type) (local_get sst_actual_type)
                  (local_get sst_argument_index) (const_i32 -1) (const_i32 -1)
                  (const_string_ptr "argument") (local_get sst_name_node))))
              (else (do)))
            (call_void write_byte (param_get sst_fd) (const_i32 32))
            (call_void surface_emit_expr_expected
              (param_get sst_fd) (param_get sst_source) (param_get sst_tree)
              (local_get sst_argument) (local_get sst_expected_type))
            (set sst_argument_index
              (add_i32 (local_get sst_argument_index) (const_i32 1)))
            (set sst_argument (call_i64 node_next_sibling
              (param_get sst_tree) (local_get sst_argument)))))
        (call_void write_byte (param_get sst_fd) (const_i32 41))
        (return_void)))

  (fn sst_emit_return
      (params (sst_fd i32) (sst_source ptr) (sst_tree ptr) (sst_node i64))
      (returns void)
      (do
        (let sst_value i64 (call_i64 nth_child
          (param_get sst_tree) (param_get sst_node) (const_i64 1)))
        (let sst_expected i32 (call_i32 weave_surface_get_return_type))
        (call_void sst_check_expr_expected
          (param_get sst_tree) (param_get sst_source) (local_get sst_value)
          (local_get sst_expected) (const_string_ptr "return"))
        (call_void write_cstr (param_get sst_fd) (const_string_ptr "(return "))
        (call_void surface_emit_expr_expected
          (param_get sst_fd) (param_get sst_source) (param_get sst_tree)
          (local_get sst_value) (local_get sst_expected))
        (call_void write_byte (param_get sst_fd) (const_i32 41))
        (return_void)))

  (fn sst_emit_set
      (params (sst_fd i32) (sst_source ptr) (sst_tree ptr) (sst_node i64))
      (returns void)
      (do
        (let sst_name_node i64 (call_i64 nth_child
          (param_get sst_tree) (param_get sst_node) (const_i64 1)))
        (let sst_value_node i64 (call_i64 nth_child
          (param_get sst_tree) (param_get sst_node) (const_i64 2)))
        (let sst_expected i32 (call_i32 surface_ident_type
          (param_get sst_tree) (param_get sst_source) (local_get sst_name_node)))
        (call_void sst_check_expr_expected
          (param_get sst_tree) (param_get sst_source) (local_get sst_value_node)
          (local_get sst_expected) (const_string_ptr "assignment"))
        (call_void write_cstr (param_get sst_fd) (const_string_ptr "(set "))
        (call_void emit_node_text
          (param_get sst_fd) (param_get sst_source) (param_get sst_tree)
          (local_get sst_name_node))
        (call_void write_byte (param_get sst_fd) (const_i32 32))
        (call_void surface_emit_expr_expected
          (param_get sst_fd) (param_get sst_source) (param_get sst_tree)
          (local_get sst_value_node) (local_get sst_expected))
        (call_void write_byte (param_get sst_fd) (const_i32 41))
        (return_void)))
)
