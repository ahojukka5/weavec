; SPDX-License-Identifier: Apache-2.0
; driver.weave — frontend entry point
;
; lower_source_file(input_path, output_path) -> i32
;   Reads a surface Weave source file, runs the lowering pass, and writes
;   WIR text to the output file.  Returns 0 on success, 1 on error.
;
; lower_sources(argc, argv, output_path, first_input_index) -> i32
;   Lowers argv[first_input_index..argc) into one WIR module.
;
; frontend_main(argc, argv) -> i32
;   Entry point for the standalone frontend binary.
;   Usage: weavec-bootstrap2 <output.wir> <input.weave> [input2.weave ...]

(program
  (name "driver")
  (version "0.1")

  (extern weave_frontend_set_strict_contracts (params (enabled i32)) (returns void))
  (extern weave_frontend_strict_contracts_enabled (params) (returns i32))
  (extern weave_audit_json_set_table (params (table ptr)) (returns void))
  (extern weave_audit_json_get_table (params) (returns ptr))

  (fn lower_source_file
    (params (input_path ptr) (output_path ptr))
    (returns i32)
    (do
      ; Open input
      (let in_fd i32 (call_i32 open (param_get input_path) (const_i32 0) (const_i32 0)))
      (if
        (condition (lt_i32 (local_get in_fd) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      ; Get file size
      (let file_size i64 (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 2)))
      (if
        (condition (lt_i64 (local_get file_size) (const_i64 0)))
        (then (do
          (call_i32 close (local_get in_fd))
          (return (const_i32 1))))
        (else (do)))
      (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 0))
      ; Allocate and read
      (let source ptr (call_ptr malloc (add_i64 (local_get file_size) (const_i64 1))))
      (if
        (condition (eq_ptr (local_get source) (const_null)))
        (then (do
          (call_i32 close (local_get in_fd))
          (return (const_i32 1))))
        (else (do)))
      (let bytes_read i64 (call_i64 read (local_get in_fd) (local_get source) (local_get file_size)))
      (call_i32 close (local_get in_fd))
      (if
        (condition (ne_i64 (local_get bytes_read) (local_get file_size)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (store_i8 (ptr_add (local_get source) (local_get file_size)) (const_i32 0))
      ; Lex and parse
      (let tokens ptr (call_ptr lex (local_get source) (local_get file_size)))
      (if
        (condition (eq_ptr (local_get tokens) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (let tree ptr (call_ptr parse (local_get tokens)))
      (if
        (condition (eq_ptr (local_get tree) (const_null)))
        (then (do
          (call_void tokens_free (local_get tokens))
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      ; Open output via the portability shim; see runtime/portable.c.
      (let out_fd i32 (call_i32 weave_rt_open_write_trunc (param_get output_path) (const_i32 420)))
      (if
        (condition (lt_i32 (local_get out_fd) (const_i32 0)))
        (then (do
          (call_void tree_free (local_get tree))
          (call_void tokens_free (local_get tokens))
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (call_i32 fchmod (local_get out_fd) (const_i32 420))
      ; Run lowering pass
      (call_void weave_rt_set_source_index (const_i64 0))
      (let status i32 (call_i32 lower_program
        (local_get out_fd) (local_get source) (local_get tree)))
      (call_i32 close (local_get out_fd))
      (call_void tree_free (local_get tree))
      (call_void tokens_free (local_get tokens))
      (call_void free (local_get source))
      (return (local_get status))))

  ; Read and parse one surface file, then emit either externs (pass_kind=0)
  ; or body declarations (pass_kind=1) into an already-open output fd.
  (fn lower_source_file_pass
    (params (input_path ptr) (out_fd i32) (pass_kind i32))
    (returns i32)
    (do
      (let in_fd i32 (call_i32 open (param_get input_path) (const_i32 0) (const_i32 0)))
      (if
        (condition (lt_i32 (local_get in_fd) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (let file_size i64 (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 2)))
      (if
        (condition (lt_i64 (local_get file_size) (const_i64 0)))
        (then (do
          (call_i32 close (local_get in_fd))
          (return (const_i32 1))))
        (else (do)))
      (call_i64 lseek (local_get in_fd) (const_i64 0) (const_i32 0))
      (let source ptr (call_ptr malloc (add_i64 (local_get file_size) (const_i64 1))))
      (if
        (condition (eq_ptr (local_get source) (const_null)))
        (then (do
          (call_i32 close (local_get in_fd))
          (return (const_i32 1))))
        (else (do)))
      (let bytes_read i64 (call_i64 read (local_get in_fd) (local_get source) (local_get file_size)))
      (call_i32 close (local_get in_fd))
      (if
        (condition (ne_i64 (local_get bytes_read) (local_get file_size)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (store_i8 (ptr_add (local_get source) (local_get file_size)) (const_i32 0))
      (let tokens ptr (call_ptr lex (local_get source) (local_get file_size)))
      (if
        (condition (eq_ptr (local_get tokens) (const_null)))
        (then (do
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (let tree ptr (call_ptr parse (local_get tokens)))
      (if
        (condition (eq_ptr (local_get tree) (const_null)))
        (then (do
          (call_void tokens_free (local_get tokens))
          (call_void free (local_get source))
          (return (const_i32 1))))
        (else (do)))
      (if
        (condition (eq_i32 (param_get pass_kind) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (call_i32 validate_quantum_program
              (local_get tree) (local_get source)) (const_i32 0)))
            (then (do
              (call_void tree_free (local_get tree))
              (call_void tokens_free (local_get tokens))
              (call_void free (local_get source))
              (return (const_i32 1))))
            (else (do)))))
        (else (do)))
      (let status i32 (const_i32 0))
      (if
        (condition (eq_i32 (param_get pass_kind) (const_i32 0)))
        (then (do
          (set status (call_i32 lower_program_externs
            (param_get out_fd) (local_get source) (local_get tree)))))
        (else (do
          (set status (call_i32 lower_program_decls
            (param_get out_fd) (local_get source) (local_get tree))))))
      (call_void tree_free (local_get tree))
      (call_void tokens_free (local_get tokens))
      (call_void free (local_get source))
      (return (local_get status))))

  (fn lower_sources
    (params (argc i32) (argv ptr) (output_path ptr) (first_input_index i64))
    (returns i32)
    (do
      (call_void weave_frontend_set_strict_contracts (const_i32 0))
      (let scan_idx i64 (const_i64 2))
      (while
        (condition (lt_i64 (local_get scan_idx) (cast_i32_to_i64 (param_get argc))))
        (do
          (let cur ptr (load_ptr (ptr_add (param_get argv) (mul_i64 (local_get scan_idx) (const_i64 8)))))
          (if
            (condition (ne_i32 (call_i32 cstr_equals
              (local_get cur) (const_string_ptr "--strict-contracts") (const_i64 18)) (const_i32 0)))
            (then (do (call_void weave_frontend_set_strict_contracts (const_i32 1))))
            (else (do)))
          (set scan_idx (add_i64 (local_get scan_idx) (const_i64 1)))))
      (if
        (condition (le_i64 (cast_i32_to_i64 (param_get argc)) (param_get first_input_index)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (let out_fd i32 (call_i32 weave_rt_open_write_trunc (param_get output_path) (const_i32 420)))
      (if
        (condition (lt_i32 (local_get out_fd) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (call_i32 fchmod (local_get out_fd) (const_i32 420))
      (call_void emit_wir_header (local_get out_fd))
      (let i i64 (param_get first_input_index))
      (while
        (condition (lt_i64 (local_get i) (cast_i32_to_i64 (param_get argc))))
        (do
          (let input_path ptr (load_ptr (ptr_add (param_get argv) (mul_i64 (local_get i) (const_i64 8)))))
          (call_void weave_rt_set_source_index
            (sub_i64 (local_get i) (param_get first_input_index)))
          (let status i32 (call_i32 lower_source_file_pass
            (local_get input_path) (local_get out_fd) (const_i32 0)))
          (if
            (condition (ne_i32 (local_get status) (const_i32 0)))
            (then (do
              (call_i32 close (local_get out_fd))
              (return (local_get status))))
            (else (do)))
          (set i (add_i64 (local_get i) (const_i64 1)))))
      ; Pass 2a: emit main.weave decls first (WIR decl order affects codegen).
      (set i (param_get first_input_index))
      (while
        (condition (lt_i64 (local_get i) (cast_i32_to_i64 (param_get argc))))
        (do
          (let input_path2 ptr (load_ptr (ptr_add (param_get argv) (mul_i64 (local_get i) (const_i64 8)))))
          (call_void weave_rt_set_source_index
            (sub_i64 (local_get i) (param_get first_input_index)))
          (if
            (condition (ne_i32 (call_i32 path_ends_with
              (local_get input_path2) (const_string_ptr "main.weave") (const_i64 10)) (const_i32 0)))
            (then (do
              (let status_main i32 (call_i32 lower_source_file_pass
                (local_get input_path2) (local_get out_fd) (const_i32 1)))
              (if
                (condition (ne_i32 (local_get status_main) (const_i32 0)))
                (then (do
                  (call_i32 close (local_get out_fd))
                  (return (local_get status_main))))
                (else (do)))))
            (else (do)))
          (set i (add_i64 (local_get i) (const_i64 1)))))
      ; Pass 2b: emit remaining source decls in argv order.
      (set i (param_get first_input_index))
      (while
        (condition (lt_i64 (local_get i) (cast_i32_to_i64 (param_get argc))))
        (do
          (let input_path3 ptr (load_ptr (ptr_add (param_get argv) (mul_i64 (local_get i) (const_i64 8)))))
          (call_void weave_rt_set_source_index
            (sub_i64 (local_get i) (param_get first_input_index)))
          (if
            (condition (eq_i32 (call_i32 path_ends_with
              (local_get input_path3) (const_string_ptr "main.weave") (const_i64 10)) (const_i32 0)))
            (then (do
              (let status3 i32 (call_i32 lower_source_file_pass
                (local_get input_path3) (local_get out_fd) (const_i32 1)))
              (if
                (condition (ne_i32 (local_get status3) (const_i32 0)))
                (then (do
                  (call_i32 close (local_get out_fd))
                  (return (local_get status3))))
                (else (do)))))
            (else (do)))
          (set i (add_i64 (local_get i) (const_i64 1)))))
      (call_void emit_wir_footer (local_get out_fd))
      (call_i32 close (local_get out_fd))
      (return (const_i32 0))))

  (fn frontend_main
    (params (argc i32) (argv ptr))
    (returns i32)
    (do
      (if
        (condition (lt_i32 (param_get argc) (const_i32 3)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (let output_path ptr (load_ptr (ptr_add (param_get argv) (const_i64 8))))
      (return (call_i32 lower_sources
        (param_get argc) (param_get argv) (local_get output_path) (const_i64 2)))))

  ; --- Explain mode (--explain) ---

  (fn count_return_sites_in_node
    (params (tree ptr) (source ptr) (node i64))
    (returns i64)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i64 0))))
        (else (do)))
      (let n i64 (const_i64 0))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (if
            (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "return") (const_i64 6)) (const_i32 0)))
            (then (do (set n (add_i64 (local_get n) (const_i64 1)))))
            (else (do)))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (set n (add_i64 (local_get n) (call_i64 count_return_sites_in_node
                (param_get tree) (param_get source) (local_get child))))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))))
        (else (do)))
      (return (local_get n))))

  (fn count_contract_clauses
    (params (tree ptr) (source ptr) (fn_node i64) (head ptr) (head_len i64))
    (returns i64)
    (do
      (let returns_node i64 (call_i64 nth_child (param_get tree) (param_get fn_node) (const_i64 3)))
      (let child i64 (call_i64 node_next_sibling (param_get tree) (local_get returns_node)))
      (let n i64 (const_i64 0))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
              (param_get head) (param_get head_len)) (const_i32 0)))
            (then (do (set n (add_i64 (local_get n) (const_i64 1)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (local_get n))))

  (fn explain_is_local_fn_name
    (params (tree ptr) (source ptr) (first_decl i64) (name_node i64))
    (returns i32)
    (do
      (let child i64 (param_get first_decl))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (let fname i64 (call_i64 nth_child (param_get tree) (local_get child) (const_i64 1)))
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 ident_nodes_equal
                      (param_get tree) (param_get source) (local_get fname) (param_get name_node)) (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do
                  (if
                    (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                      (const_string_ptr "entry") (const_i64 5)) (const_i32 0)))
                    (then (do
                      (if
                        (condition (ne_i32 (call_i32 ident_nodes_equal
                          (param_get tree) (param_get source) (local_get fname) (param_get name_node)) (const_i32 0)))
                        (then (do (return (const_i32 1))))
                        (else (do)))))
                    (else (do))))))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn find_decl_for_name_node
    (params (tree ptr) (source ptr) (first_decl i64) (name_node i64))
    (returns i64)
    (do
      (let child i64 (param_get first_decl))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (let fname i64 (call_i64 nth_child (param_get tree) (local_get child) (const_i64 1)))
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 ident_nodes_equal
                      (param_get tree) (param_get source) (local_get fname) (param_get name_node)) (const_i32 0)))
                    (then (do (return (local_get child))))
                    (else (do)))))
                (else (do
                  (if
                    (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                      (const_string_ptr "entry") (const_i64 5)) (const_i32 0)))
                    (then (do
                      (if
                        (condition (ne_i32 (call_i32 ident_nodes_equal
                          (param_get tree) (param_get source) (local_get fname) (param_get name_node)) (const_i32 0)))
                        (then (do (return (local_get child))))
                        (else (do)))))
                    (else (do))))))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i64 -1))))

  (fn count_while_loops_in_node
    (params (tree ptr) (source ptr) (node i64))
    (returns i64)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i64 0))))
        (else (do)))
      (let n i64 (const_i64 0))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (if
            (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "while") (const_i64 5)) (const_i32 0)))
            (then (do (set n (add_i64 (local_get n) (const_i64 1)))))
            (else (do)))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (set n (add_i64 (local_get n) (call_i64 count_while_loops_in_node
                (param_get tree) (param_get source) (local_get child))))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))))
        (else (do)))
      (return (local_get n))))

  (fn count_conditionals_in_node
    (params (tree ptr) (source ptr) (node i64))
    (returns i64)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i64 0))))
        (else (do)))
      (let n i64 (const_i64 0))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (if
            (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "if") (const_i64 2)) (const_i32 0)))
            (then (do (set n (add_i64 (local_get n) (const_i64 1)))))
            (else (do)))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (set n (add_i64 (local_get n) (call_i64 count_conditionals_in_node
                (param_get tree) (param_get source) (local_get child))))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))))
        (else (do)))
      (return (local_get n))))

  (fn count_calls_in_node
    (params (tree ptr) (source ptr) (node i64))
    (returns i64)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i64 0))))
        (else (do)))
      (let n i64 (const_i64 0))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (if
            (condition (or_bool
              (or_bool
                (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                  (const_string_ptr "call_i32") (const_i64 8)) (const_i32 0))
                (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                  (const_string_ptr "call_i64") (const_i64 8)) (const_i32 0)))
              (or_bool
                (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                  (const_string_ptr "call_ptr") (const_i64 8)) (const_i32 0))
                (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                  (const_string_ptr "call_void") (const_i64 9)) (const_i32 0)))))
            (then (do (set n (add_i64 (local_get n) (const_i64 1)))))
            (else (do)))
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (set n (add_i64 (local_get n) (call_i64 count_calls_in_node
                (param_get tree) (param_get source) (local_get child))))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))))
        (else (do)))
      (return (local_get n))))

  (fn count_external_calls_in_node
    (params (tree ptr) (source ptr) (node i64) (first_decl i64))
    (returns i64)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i64 0))))
        (else (do)))
      (let n i64 (const_i64 0))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (if
            (condition (or_bool
              (or_bool
