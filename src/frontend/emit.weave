            (then (do
              (call_void match_emit
                (param_get fd) (param_get source) (param_get tree) (param_get node))
              (return_void)))
            (else (do)))
          (if
            (condition (ne_i32 (call_i32 head_equals
              (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "try") (const_i64 3)) (const_i32 0)))
            (then (do
              (call_void try_emit
                (param_get fd) (param_get source) (param_get tree) (param_get node))
              (return_void)))
            (else (do)))
          (if
            (condition (ne_i32 (call_i32 if_expr_is_node
