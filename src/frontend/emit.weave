; SPDX-License-Identifier: Apache-2.0
; emit.weave — verbatim s-expression emission for the frontend lowering pass
;
; emit_node(fd, source, tree, node) writes any AST node as WIR text:
;   list   → ( child1 child2 ... )
;   ident  → raw source bytes
;   string → "raw source bytes"
;   int    → raw source bytes (decimal digits as they appear in source)
;
; This is the core primitive used throughout the frontend to copy subtrees
; verbatim into the WIR output without transformation.
;
; The frontend also accepts a small amount of typed surface sugar where the
; surrounding form provides an unambiguous WIR type:
;   (let x i32 42) -> (let x i32 (const_i32 42))
;   (let x i64 42) -> (let x i64 (const_i64 42))
;   (let x Qubit 0) -> (let x i64 (const_i64 0))
;
; Quantum surface statements (see docs/quantum-surface-syntax.md):
;   (qgate H q0)     -> qrt_ry / qrt_rz via quantum_nativize (Rigetti-style v1)
;   (qgate RY q0 t)  -> (call_void qrt_ry (local_get q0) t)
;   (qmeasure q0 c0) -> (let c0 i32 (call_i32 qrt_measure (local_get q0)))

(program
  (name "emit")
  (version "0.1")

  (fn emit_const_for_type
    (params (fd i32) (source ptr) (tree ptr) (type_node i64) (value_node i64))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "(const_"))
      (call_void emit_wir_type (param_get fd) (param_get source) (param_get tree) (param_get type_node))
      (call_void write_byte (param_get fd) (const_i32 32))
      (call_void write_node_text (param_get fd) (param_get source) (param_get tree) (param_get value_node))
      (call_void write_byte (param_get fd) (const_i32 41))
      (return_void)))

  (fn emit_wir_type
    (params (fd i32) (source ptr) (tree ptr) (type_node i64))
    (returns void)
    (do
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "Qubit") (const_i64 5)) (const_i32 0)))
        (then (do
          (call_void trace_event_for_node
            (const_string_ptr "lowering")
            (const_string_ptr "frontend.types")
            (const_string_ptr "lower-qubit-to-i64")
            (param_get source) (param_get tree) (param_get type_node) (const_i64 -1))
          (call_void write_cstr (param_get fd) (const_string_ptr "i64"))
          (return_void)))
        (else (do)))
      (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (param_get type_node))
      (return_void)))

  (fn emit_expr_for_type
    (params (fd i32) (source ptr) (tree ptr) (type_node i64) (expr_node i64))
    (returns void)
    (do
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get expr_node)) (call_i32 node_int)))
        (then (do
          (if
            (condition (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
                (const_string_ptr "i32") (const_i64 3)) (const_i32 0))
              (or_bool
                (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
                  (const_string_ptr "i64") (const_i64 3)) (const_i32 0))
                (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
                  (const_string_ptr "Qubit") (const_i64 5)) (const_i32 0)))))
            (then (do
              (call_void trace_event_for_node
                (const_string_ptr "lowering")
                (const_string_ptr "frontend.typed-literals")
                (const_string_ptr "wrap-typed-integer")
                (param_get source) (param_get tree)
                (param_get expr_node) (param_get type_node))
              (call_void emit_const_for_type
                (param_get fd) (param_get source) (param_get tree)
                (param_get type_node) (param_get expr_node))
              (return_void)))
            (else (do)))))
        (else (do)))
      (call_void emit_node (param_get fd) (param_get source) (param_get tree) (param_get expr_node))
      (return_void)))

  (fn emit_let_node
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (let name_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
      (let type_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
      (let expr_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
      (call_void write_cstr (param_get fd) (const_string_ptr "(let "))
      (call_void emit_node (param_get fd) (param_get source) (param_get tree) (local_get name_node))
      (call_void write_byte (param_get fd) (const_i32 32))
      (call_void emit_wir_type (param_get fd) (param_get source) (param_get tree) (local_get type_node))
      (call_void write_byte (param_get fd) (const_i32 32))
      (call_void emit_expr_for_type
        (param_get fd) (param_get source) (param_get tree)
        (local_get type_node) (local_get expr_node))
      (call_void write_byte (param_get fd) (const_i32 41))
      (return_void)))

  ; Lower (qgate GATE qargs...) to extern qrt_* calls (no peephole).
  (fn emit_qgate_direct
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (if
        (condition (ne_i32 (call_i32 rigetti_nativize_emit_qgate
          (param_get fd) (param_get source) (param_get tree) (param_get node)) (const_i32 0)))
        (then (do (return_void)))
        (else (do)))
      (let gate_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
      (call_void trace_event_for_node
        (const_string_ptr "lowering")
        (const_string_ptr "frontend.quantum")
        (const_string_ptr "lower-gate-to-runtime-call")
        (param_get source) (param_get tree) (param_get node) (local_get gate_node))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "CNOT") (const_i64 4)) (const_i32 0)))
        (then (do
          (let q0 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
          (let q1 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
          (call_void write_cstr (param_get fd) (const_string_ptr "(call_void qrt_cnot "))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get q0))
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get q1))
          (call_void write_byte (param_get fd) (const_i32 41))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "CZ") (const_i64 2)) (const_i32 0)))
        (then (do
          (let cz_q0 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
          (let cz_q1 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
          (call_void write_cstr (param_get fd) (const_string_ptr "(call_void qrt_cz "))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get cz_q0))
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get cz_q1))
          (call_void write_byte (param_get fd) (const_i32 41))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "SWAP") (const_i64 4)) (const_i32 0)))
        (then (do
          (let sw_q0 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
          (let sw_q1 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
          (call_void write_cstr (param_get fd) (const_string_ptr "(call_void qrt_swap "))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get sw_q0))
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get sw_q1))
          (call_void write_byte (param_get fd) (const_i32 41))
          (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get gate_node)
          (const_string_ptr "CCNOT") (const_i64 5)) (const_i32 0)))
        (then (do
          (let cc_q0 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
          (let cc_q1 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
          (let cc_q2 i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 4)))
          (call_void write_cstr (param_get fd) (const_string_ptr "(call_void qrt_ccnot "))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get cc_q0))
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get cc_q1))
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get cc_q2))
          (call_void write_byte (param_get fd) (const_i32 41))
          (return_void)))
        (else (do)))
      (let qubit_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
      (call_void write_cstr (param_get fd) (const_string_ptr "(call_void qrt_"))
      (call_void emit_node_text_lower (param_get fd) (param_get source) (param_get tree) (local_get gate_node))
      (call_void write_byte (param_get fd) (const_i32 32))
      (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get qubit_node))
      (let extra i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 3)))
      (if
        (condition (ne_i64 (local_get extra) (const_i64 -1)))
        (then (do
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_node (param_get fd) (param_get source) (param_get tree) (local_get extra))))
        (else (do)))
      (call_void write_byte (param_get fd) (const_i32 41))
      (return_void)))

  ; Process one statement in a (do ...) body. The peephole carries a "pending"
  ; self-inverse qgate from the previous iteration; if the current child cancels
  ; it, both are dropped. Otherwise the previous pending (if any) is flushed and
  ; - the current child becomes the new pending if it is a self-inverse qgate
  ; - or is emitted directly and the new pending is -1.
  ; Returns the new pending node id (or -1).
  ;
  ; Lifted out of emit_do_body so the loop body has a single top-level
  ; (set pending ...) and weavec's loop-phi pass handles the merge cleanly.
  (fn emit_do_step
    (params (fd i32) (source ptr) (tree ptr) (pending i64) (child i64))
    (returns i64)
    (do
      (if
        (condition (ne_i32 (call_i32 qgate_is_self_inverse_candidate
          (param_get tree) (param_get source) (param_get child)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (call_i32 qgate_self_inverse_match
              (param_get tree) (param_get source) (param_get pending) (param_get child)) (const_i32 0)))
            (then (do
              (call_void trace_event_for_range
                (const_string_ptr "optimization")
                (const_string_ptr "frontend.quantum-peephole")
                (const_string_ptr "cancel-self-inverse-pair")
                (param_get source) (param_get tree)
                (param_get pending) (param_get child)
                (call_i64 nth_child (param_get tree) (param_get child) (const_i64 1)))
              (return (const_i64 -1))))
            (else (do)))
          (if
            (condition (ne_i64 (param_get pending) (const_i64 -1)))
            (then (do
              (call_void write_byte (param_get fd) (const_i32 32))
              (call_void emit_qgate_direct
                (param_get fd) (param_get source) (param_get tree) (param_get pending))))
            (else (do)))
          (return (param_get child))))
        (else (do)))
      (if
        (condition (ne_i64 (param_get pending) (const_i64 -1)))
        (then (do
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_qgate_direct
            (param_get fd) (param_get source) (param_get tree) (param_get pending))))
        (else (do)))
      (call_void write_byte (param_get fd) (const_i32 32))
      (call_void emit_node (param_get fd) (param_get source) (param_get tree) (param_get child))
      (return (const_i64 -1))))

  ; Emit statements in (do ...) with the self-inverse-qgate peephole driven
  ; by emit_do_step. See quantum_optimize.weave for the predicate set
  ; (H, X, Y, Z, CNOT, CZ, SWAP, CCNOT cancel pairwise on identical operands).
  (fn emit_do_body
    (params (fd i32) (source ptr) (tree ptr) (do_node i64))
    (returns void)
    (do
      (let pending i64 (const_i64 -1))
      (let head i64 (call_i64 node_first_child (param_get tree) (param_get do_node)))
      (let child i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (set pending (call_i64 emit_do_step
            (param_get fd) (param_get source) (param_get tree)
            (local_get pending) (local_get child)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (if
        (condition (ne_i64 (local_get pending) (const_i64 -1)))
        (then (do
          (call_void write_byte (param_get fd) (const_i32 32))
          (call_void emit_qgate_direct
            (param_get fd) (param_get source) (param_get tree) (local_get pending))))
        (else (do)))
      (return_void)))

  ; Lower (qgate GATE qargs...) to extern qrt_* calls.
  (fn emit_qgate_node
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (call_void emit_qgate_direct (param_get fd) (param_get source) (param_get tree) (param_get node))
      (return_void)))

  ; Lower (qmeasure qubit result) to let + call_i32 qrt_measure.
  (fn emit_qmeasure_node
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (let qubit_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
      (let result_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
      (call_void trace_event_for_node
        (const_string_ptr "lowering")
        (const_string_ptr "frontend.quantum")
        (const_string_ptr "lower-measurement-to-runtime-call")
        (param_get source) (param_get tree) (param_get node) (local_get qubit_node))
      (call_void write_cstr (param_get fd) (const_string_ptr "(let "))
      (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (local_get result_node))
      (call_void write_cstr (param_get fd) (const_string_ptr " i32 (call_i32 qrt_measure "))
      (call_void emit_local_get_ident (param_get fd) (param_get source) (param_get tree) (local_get qubit_node))
      (call_void write_cstr (param_get fd) (const_string_ptr "))"))
      (return_void)))

  (fn emit_node
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (call_void emit_source_span_for_node
        (param_get fd) (param_get source) (param_get tree) (param_get node))
      (let kind i32 (call_i32 node_kind (param_get tree) (param_get node)))
      (if
        (condition (eq_i32 (local_get kind) (call_i32 node_list)))
        (then (do
          (if
            (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "do") (const_i64 2)) (const_i32 0)))
            (then (do
              (call_void write_byte (param_get fd) (const_i32 40))
              (call_void write_cstr (param_get fd) (const_string_ptr "do"))
              (call_void emit_do_body (param_get fd) (param_get source) (param_get tree) (param_get node))
              (call_void write_byte (param_get fd) (const_i32 41))
              (return_void)))
            (else (do)))
          (if
            (condition (and_bool
              (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
                (const_string_ptr "let") (const_i64 3)) (const_i32 0))
              (eq_i64 (call_i64 count_children (param_get tree) (param_get node)) (const_i64 4))))
            (then (do
              (call_void emit_let_node (param_get fd) (param_get source) (param_get tree) (param_get node))
              (return_void)))
            (else (do)))
          (if
            (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "qgate") (const_i64 5)) (const_i32 0)))
            (then (do
              (call_void emit_qgate_node (param_get fd) (param_get source) (param_get tree) (param_get node))
              (return_void)))
            (else (do)))
          (if
            (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "qmeasure") (const_i64 8)) (const_i32 0)))
            (then (do
              (call_void emit_qmeasure_node (param_get fd) (param_get source) (param_get tree) (param_get node))
              (return_void)))
            (else (do)))
          (call_void write_byte (param_get fd) (const_i32 40))
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (let first i32 (const_i32 1))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (if
                (condition (eq_i32 (local_get first) (const_i32 0)))
                (then (do (call_void write_byte (param_get fd) (const_i32 32))))
                (else (do (set first (const_i32 0)))))
              (call_void emit_node (param_get fd) (param_get source) (param_get tree) (local_get child))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
          (call_void write_byte (param_get fd) (const_i32 41))
          (return_void)))
        (else (do)))
      (if
        (condition (eq_i32 (local_get kind) (call_i32 node_string)))
        (then (do
          (call_void write_byte (param_get fd) (const_i32 34))
          (call_void write_node_text (param_get fd) (param_get source) (param_get tree) (param_get node))
          (call_void write_byte (param_get fd) (const_i32 34))
          (return_void)))
        (else (do)))
      ; ident and int: emit raw source bytes
      (call_void write_node_text (param_get fd) (param_get source) (param_get tree) (param_get node))
      (return_void)))
)