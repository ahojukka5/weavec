; SPDX-License-Identifier: Apache-2.0
; surface_decl_tree.weave — structural success-path lowering for ordinary decls
;
; Semantic validation stays in emit.weave, sst_emit_params, and
; lower_program_*. This module builds owned WIR declaration nodes that compose
; #410–#413 children. Unmigrated children return failure so the caller can keep
; the text renderer. A failed judgment never publishes a partial declaration
; subtree.

(program
  (name "surface_decl_tree")
  (version "0.1")

  (fn sdtt_reject
    (params (sdtt_r_wir ptr))
    (returns i64)
    (do
      (call_i32 wir_tree_mark_failed (param_get sdtt_r_wir))
      (return (const_i64 -1))))

  (fn sdtt_head_is
    (params
      (sdtt_h_tree ptr) (sdtt_h_source ptr) (sdtt_h_node i64)
      (sdtt_h_text ptr) (sdtt_h_len i64))
    (returns i32)
    (do
      (return (call_i32 head_equals
        (param_get sdtt_h_tree) (param_get sdtt_h_source)
        (param_get sdtt_h_node) (param_get sdtt_h_text)
        (param_get sdtt_h_len)))))

  ; Family heads that this issue must not tree-lower.
  (fn sdtt_head_unmigrated
    (params (sdtt_u_tree ptr) (sdtt_u_source ptr) (sdtt_u_node i64))
    (returns i32)
    (do
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "if") (const_i64 2))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "when") (const_i64 4))
              (const_i32 0)))
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "while") (const_i64 5))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "for") (const_i64 3))
              (const_i32 0)))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "loop") (const_i64 4))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "break") (const_i64 5))
              (const_i32 0)))
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "continue") (const_i64 8))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "match") (const_i64 5))
              (const_i32 0)))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "try") (const_i64 3))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "qgate") (const_i64 5))
              (const_i32 0)))
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "qmeasure") (const_i64 8))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "new") (const_i64 3))
              (const_i32 0)))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "variant") (const_i64 7))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node)
              (const_string_ptr "variant-tag") (const_i64 11))
              (const_i32 0)))
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node)
              (const_string_ptr "variant-payload") (const_i64 15))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node)
              (const_string_ptr "field-get") (const_i64 9))
              (const_i32 0)))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node)
              (const_string_ptr "field-set") (const_i64 9))
              (const_i32 0))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node) (const_string_ptr "do") (const_i64 2))
              (const_i32 0)))
          (or_bool
            (or_bool
              (ne_i32 (call_i32 sdtt_head_is
                (param_get sdtt_u_tree) (param_get sdtt_u_source)
                (param_get sdtt_u_node)
                (const_string_ptr "type-params") (const_i64 11))
                (const_i32 0))
              (ne_i32 (call_i32 sdtt_head_is
                (param_get sdtt_u_tree) (param_get sdtt_u_source)
                (param_get sdtt_u_node)
                (const_string_ptr "type-app") (const_i64 8))
                (const_i32 0)))
            (ne_i32 (call_i32 sdtt_head_is
              (param_get sdtt_u_tree) (param_get sdtt_u_source)
              (param_get sdtt_u_node)
              (const_string_ptr "type-args") (const_i64 9))
              (const_i32 0)))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  ; Recursively reject unmigrated descendants so the text path stays the
  ; diagnostic authority and no check runs before the tree path is committed.
  (fn sdtt_node_tree_supported
    (params (sdtt_n_tree ptr) (sdtt_n_source ptr) (sdtt_n_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get sdtt_n_node) (const_i64 -1)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind
          (param_get sdtt_n_tree) (param_get sdtt_n_node))
          (call_i32 node_list)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 comment_is_node
          (param_get sdtt_n_tree) (param_get sdtt_n_source)
          (param_get sdtt_n_node))
          (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 sdtt_head_unmigrated
          (param_get sdtt_n_tree) (param_get sdtt_n_source)
          (param_get sdtt_n_node))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let sdtt_n_child i64 (call_i64 node_first_child
        (param_get sdtt_n_tree) (param_get sdtt_n_node)))
      (while
        (condition (ne_i64 (local_get sdtt_n_child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 sdtt_node_tree_supported
              (param_get sdtt_n_tree) (param_get sdtt_n_source)
              (local_get sdtt_n_child))
              (const_i32 0)))
            (then (do (return (const_i32 0))))
            (else (do)))
          (set sdtt_n_child (call_i64 node_next_sibling
            (param_get sdtt_n_tree) (local_get sdtt_n_child)))))
      (return (const_i32 1))))

  (fn sdtt_body_tree_supported
    (params (sdtt_b_tree ptr) (sdtt_b_source ptr) (sdtt_b_decl i64))
    (returns i32)
    (do
      (let sdtt_b_stmt i64 (call_i64 surface_fn_body_first_stmt
        (param_get sdtt_b_tree) (param_get sdtt_b_source)
        (param_get sdtt_b_decl)))
      (while
        (condition (ne_i64 (local_get sdtt_b_stmt) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 comment_is_node
              (param_get sdtt_b_tree) (param_get sdtt_b_source)
              (local_get sdtt_b_stmt))
              (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (call_i32 sdtt_node_tree_supported
                  (param_get sdtt_b_tree) (param_get sdtt_b_source)
                  (local_get sdtt_b_stmt))
                  (const_i32 0)))
                (then (do (return (const_i32 0))))
                (else (do)))))
            (else (do)))
          (set sdtt_b_stmt (call_i64 node_next_sibling
            (param_get sdtt_b_tree) (local_get sdtt_b_stmt)))))
      (return (const_i32 1))))

  (fn sdtt_symbol_atom
    (params
      (sdtt_s_wir ptr) (sdtt_s_source ptr)
      (sdtt_s_tree ptr) (sdtt_s_node i64))
    (returns i64)
    (do
      (if
        (condition (eq_i32 (call_i32 surface_node_is_ident
          (param_get sdtt_s_tree) (param_get sdtt_s_node))
          (const_i32 0)))
        (then (do (return (call_i64 sdtt_reject (param_get sdtt_s_wir)))))
        (else (do)))
      (let sdtt_s_start i64 (call_i64 node_text_start
        (param_get sdtt_s_tree) (param_get sdtt_s_node)))
      (let sdtt_s_length i64 (call_i64 node_text_len
        (param_get sdtt_s_tree) (param_get sdtt_s_node)))
      (let sdtt_s_wir_name ptr (call_ptr weave_surface_symbol_wir_name
        (param_get sdtt_s_source) (local_get sdtt_s_start)
        (local_get sdtt_s_length)))
      (if
        (condition (ne_ptr (local_get sdtt_s_wir_name) (const_null)))
        (then (do
          (return (call_i64 wir_decl_atom
            (param_get sdtt_s_wir) (local_get sdtt_s_wir_name)))))
        (else (do)))
      (return (call_i64 wir_scalar_source_ident
        (param_get sdtt_s_wir) (param_get sdtt_s_source)
        (param_get sdtt_s_tree) (param_get sdtt_s_node)))))

  (fn sdtt_bind_local
    (params
      (sdtt_l_source ptr) (sdtt_l_tree ptr)
      (sdtt_l_name i64) (sdtt_l_type i32))
    (returns void)
    (do
      (call_i32 weave_surface_local_add
        (param_get sdtt_l_source)
        (call_i64 node_text_start
          (param_get sdtt_l_tree) (param_get sdtt_l_name))
        (call_i64 node_text_len
          (param_get sdtt_l_tree) (param_get sdtt_l_name))
        (param_get sdtt_l_type))
      (return_void)))

  (fn sdtt_build_params
    (params
      (sdtt_p_wir ptr) (sdtt_p_source ptr)
      (sdtt_p_tree ptr) (sdtt_p_decl i64))
    (returns i64)
    (do
      (let sdtt_p_node i64 (call_i64 surface_fn_params_node
        (param_get sdtt_p_tree) (param_get sdtt_p_source)
        (param_get sdtt_p_decl)))
      (if
        (condition (eq_i32 (call_i32 surface_parameters_shape_valid
          (param_get sdtt_p_tree) (param_get sdtt_p_source)
          (local_get sdtt_p_node))
          (const_i32 0)))
        (then (do (return (call_i64 sdtt_reject (param_get sdtt_p_wir)))))
        (else (do)))
      (call_void sst_prepare_params
        (param_get sdtt_p_tree) (param_get sdtt_p_source)
        (local_get sdtt_p_node))
      (let sdtt_p_list i64 (call_i64 wir_decl_params (param_get sdtt_p_wir)))
      (if
        (condition (lt_i64 (local_get sdtt_p_list) (const_i64 0)))
        (then (do (return (const_i64 -1))))
        (else (do)))
      (let sdtt_p_pair i64 (call_i64 surface_params_first_pair
        (param_get sdtt_p_tree) (param_get sdtt_p_source)
        (local_get sdtt_p_node)))
      (while
        (condition (ne_i64 (local_get sdtt_p_pair) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 node_kind
              (param_get sdtt_p_tree) (local_get sdtt_p_pair))
              (call_i32 node_list)))
            (then (do (return (call_i64 sdtt_reject (param_get sdtt_p_wir)))))
            (else (do)))
          (let sdtt_p_name_node i64 (call_i64 nth_child
            (param_get sdtt_p_tree) (local_get sdtt_p_pair) (const_i64 0)))
          (let sdtt_p_type_node i64 (call_i64 nth_child
            (param_get sdtt_p_tree) (local_get sdtt_p_pair) (const_i64 1)))
          (let sdtt_p_type i32 (call_i32 sst_type_code
            (param_get sdtt_p_tree) (param_get sdtt_p_source)
            (local_get sdtt_p_type_node)))
          (let sdtt_p_name i64 (call_i64 wir_scalar_source_ident
            (param_get sdtt_p_wir) (param_get sdtt_p_source)
            (param_get sdtt_p_tree) (local_get sdtt_p_name_node)))
          (let sdtt_p_type_atom i64 (call_i64 sstt_wir_type_atom
            (param_get sdtt_p_wir) (local_get sdtt_p_type)))
          (let sdtt_p_item i64 (call_i64 wir_decl_param
            (param_get sdtt_p_wir) (local_get sdtt_p_name)
            (local_get sdtt_p_type_atom)))
          (if
            (condition (or_bool
              (lt_i64 (local_get sdtt_p_item) (const_i64 0))
              (eq_i32 (call_i32 wir_decl_append
                (param_get sdtt_p_wir) (local_get sdtt_p_list)
                (local_get sdtt_p_item))
                (const_i32 0))))
            (then (do (return (const_i64 -1))))
            (else (do)))
          (set sdtt_p_pair (call_i64 node_next_sibling
            (param_get sdtt_p_tree) (local_get sdtt_p_pair)))))
      (return (local_get sdtt_p_list))))

  (fn sdtt_build_returns
    (params
      (sdtt_rt_wir ptr) (sdtt_rt_source ptr)
      (sdtt_rt_tree ptr) (sdtt_rt_decl i64))
    (returns i64)
    (do
      (let sdtt_rt_type_node i64 (call_i64 surface_fn_return_type_node
        (param_get sdtt_rt_tree) (param_get sdtt_rt_source)
        (param_get sdtt_rt_decl)))
      (if
        (condition (eq_i64 (local_get sdtt_rt_type_node) (const_i64 -1)))
        (then (do (return (call_i64 sdtt_reject (param_get sdtt_rt_wir)))))
        (else (do)))
      (let sdtt_rt_code i32 (call_i32 sst_type_code
        (param_get sdtt_rt_tree) (param_get sdtt_rt_source)
        (local_get sdtt_rt_type_node)))
      (call_i32 sst_require_defined_type
        (param_get sdtt_rt_tree) (param_get sdtt_rt_source)
        (local_get sdtt_rt_type_node) (local_get sdtt_rt_code))
      (call_void weave_surface_set_return_type (local_get sdtt_rt_code))
      (if
        (condition (ne_i32 (call_i32 ident_equals
          (param_get sdtt_rt_tree) (param_get sdtt_rt_source)
          (local_get sdtt_rt_type_node)
          (const_string_ptr "Qubit") (const_i64 5))
          (const_i32 0)))
        (then (do
          (call_void trace_lower_qubit_to_i64
            (param_get sdtt_rt_source) (param_get sdtt_rt_tree)
            (local_get sdtt_rt_type_node) (const_i64 -1))))
        (else (do)))
      (let sdtt_rt_atom i64 (call_i64 sstt_wir_type_atom
        (param_get sdtt_rt_wir) (local_get sdtt_rt_code)))
      (return (call_i64 wir_decl_returns
        (param_get sdtt_rt_wir) (local_get sdtt_rt_atom)))))

  (fn sdtt_build_let_stmt
    (params
      (sdtt_ls_wir ptr) (sdtt_ls_source ptr)
      (sdtt_ls_tree ptr) (sdtt_ls_node i64))
    (returns i64)
    (do
      (let sdtt_ls_count i64 (call_i64 count_children
        (param_get sdtt_ls_tree) (param_get sdtt_ls_node)))
      (if
        (condition (eq_i64 (local_get sdtt_ls_count) (const_i64 3)))
        (then (do
          (let sdtt_ls_iname i64 (call_i64 nth_child
            (param_get sdtt_ls_tree) (param_get sdtt_ls_node) (const_i64 1)))
          (let sdtt_ls_iexpr i64 (call_i64 nth_child
            (param_get sdtt_ls_tree) (param_get sdtt_ls_node) (const_i64 2)))
          (let sdtt_ls_itype i32 (call_i32 li_infer_type
            (param_get sdtt_ls_tree) (param_get sdtt_ls_source)
            (local_get sdtt_ls_iexpr)))
          (if
            (condition (eq_i32 (local_get sdtt_ls_itype)
              (call_i32 surface_type_unknown)))
            (then (do (return (call_i64 sdtt_reject (param_get sdtt_ls_wir)))))
            (else (do)))
          (let sdtt_ls_ilet i64 (call_i64 sstt_build_let
            (param_get sdtt_ls_wir) (param_get sdtt_ls_source)
            (param_get sdtt_ls_tree) (local_get sdtt_ls_iname)
            (local_get sdtt_ls_itype) (local_get sdtt_ls_iexpr)))
          (if
            (condition (ge_i64 (local_get sdtt_ls_ilet) (const_i64 0)))
            (then (do
              (call_void sdtt_bind_local
                (param_get sdtt_ls_source) (param_get sdtt_ls_tree)
                (local_get sdtt_ls_iname) (local_get sdtt_ls_itype))))
            (else (do)))
          (return (local_get sdtt_ls_ilet))))
        (else (do)))
      (if
        (condition (ne_i64 (local_get sdtt_ls_count) (const_i64 4)))
        (then (do (return (call_i64 sdtt_reject (param_get sdtt_ls_wir)))))
        (else (do)))
      (let sdtt_ls_name i64 (call_i64 nth_child
        (param_get sdtt_ls_tree) (param_get sdtt_ls_node) (const_i64 1)))
      (let sdtt_ls_type_node i64 (call_i64 nth_child
        (param_get sdtt_ls_tree) (param_get sdtt_ls_node) (const_i64 2)))
      (let sdtt_ls_expr i64 (call_i64 nth_child
        (param_get sdtt_ls_tree) (param_get sdtt_ls_node) (const_i64 3)))
      (let sdtt_ls_type i32 (call_i32 sst_type_code
        (param_get sdtt_ls_tree) (param_get sdtt_ls_source)
        (local_get sdtt_ls_type_node)))
      (let sdtt_ls_let i64 (call_i64 sstt_build_let
        (param_get sdtt_ls_wir) (param_get sdtt_ls_source)
        (param_get sdtt_ls_tree) (local_get sdtt_ls_name)
        (local_get sdtt_ls_type) (local_get sdtt_ls_expr)))
      (if
        (condition (ge_i64 (local_get sdtt_ls_let) (const_i64 0)))
        (then (do
          (call_void sdtt_bind_local
            (param_get sdtt_ls_source) (param_get sdtt_ls_tree)
            (local_get sdtt_ls_name) (local_get sdtt_ls_type))))
        (else (do)))
      (return (local_get sdtt_ls_let))))

  (fn sdtt_build_stmt
    (params
      (sdtt_st_wir ptr) (sdtt_st_source ptr)
      (sdtt_st_tree ptr) (sdtt_st_node i64))
    (returns i64)
    (do
      (if
        (condition (ne_i32 (call_i32 node_kind
          (param_get sdtt_st_tree) (param_get sdtt_st_node))
          (call_i32 node_list)))
        (then (do (return (call_i64 sdtt_reject (param_get sdtt_st_wir)))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 sdtt_head_is
          (param_get sdtt_st_tree) (param_get sdtt_st_source)
          (param_get sdtt_st_node) (const_string_ptr "let") (const_i64 3))
          (const_i32 0)))
        (then (do
          (return (call_i64 sdtt_build_let_stmt
            (param_get sdtt_st_wir) (param_get sdtt_st_source)
            (param_get sdtt_st_tree) (param_get sdtt_st_node)))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (call_i32 sdtt_head_is
            (param_get sdtt_st_tree) (param_get sdtt_st_source)
            (param_get sdtt_st_node) (const_string_ptr "set") (const_i64 3))
            (const_i32 0))
          (eq_i64 (call_i64 count_children
            (param_get sdtt_st_tree) (param_get sdtt_st_node))
            (const_i64 3))))
        (then (do
          (let sdtt_st_set_name i64 (call_i64 nth_child
            (param_get sdtt_st_tree) (param_get sdtt_st_node) (const_i64 1)))
          (let sdtt_st_set_expr i64 (call_i64 nth_child
            (param_get sdtt_st_tree) (param_get sdtt_st_node) (const_i64 2)))
          (let sdtt_st_set_type i32 (call_i32 surface_ident_type
            (param_get sdtt_st_tree) (param_get sdtt_st_source)
            (local_get sdtt_st_set_name)))
          (return (call_i64 sstt_build_set
            (param_get sdtt_st_wir) (param_get sdtt_st_source)
            (param_get sdtt_st_tree) (local_get sdtt_st_set_name)
            (local_get sdtt_st_set_type) (local_get sdtt_st_set_expr)))))
        (else (do)))
      (if
