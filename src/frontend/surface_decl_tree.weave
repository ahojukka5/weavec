  (fn sdtt_try_publish_const
    (params
      (sdtt_tc_fd i32) (sdtt_tc_source ptr)
      (sdtt_tc_tree ptr) (sdtt_tc_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i32 (call_i32 sdtt_node_tree_supported
          (param_get sdtt_tc_tree) (param_get sdtt_tc_source)
          (param_get sdtt_tc_node))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let sdtt_tc_wir ptr (call_ptr wir_tree_new))
      (if
        (condition (eq_ptr (local_get sdtt_tc_wir) (const_null)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let sdtt_tc_root i64 (call_i64 sdtt_build_const
        (local_get sdtt_tc_wir) (param_get sdtt_tc_source)
        (param_get sdtt_tc_tree) (param_get sdtt_tc_node)))
      (let sdtt_tc_ok i32 (call_i32 sdtt_publish_root
        (param_get sdtt_tc_fd) (local_get sdtt_tc_wir)
        (local_get sdtt_tc_root)))
      (call_void wir_tree_free (local_get sdtt_tc_wir))
      (return (local_get sdtt_tc_ok))))
)
