            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "struct") (const_i64 6))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "enum") (const_i64 4))
                (const_i32 0))))
          (or_bool
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "program") (const_i64 7))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "module") (const_i64 6))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "requires") (const_i64 8))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "ensures") (const_i64 7))
                (const_i32 0))))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "name") (const_i64 4))
              (const_i32 0))
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "version") (const_i64 7))
              (const_i32 0)))
          (or_bool
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "field") (const_i64 5))
              (const_i32 0))
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "field-set") (const_i64 9))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "type-args") (const_i64 9))
                (const_i32 0))))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "print") (const_i64 5))
