  (fn surface_parameters_shape_valid
    (params (tree ptr) (source ptr) (params_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get params_node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind
          (param_get tree) (param_get params_node)) (call_i32 node_list)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 surface_params_is_verbose
          (param_get tree) (param_get source) (param_get params_node)) (const_i32 0)))
        (then (do
          (if
            (condition (eq_i32 (call_i32 surface_params_is_compact
              (param_get tree) (param_get source) (param_get params_node))
              (const_i32 0)))
            (then (do (return (const_i32 0))))
            (else (do)))))
        (else (do)))
      (let param i64 (call_i64 surface_params_first_pair
        (param_get tree) (param_get source) (param_get params_node)))
      ; An explicit empty group `()` as the sole element after the `params`
      ; head is the established zero-parameter marker used throughout extern
      ; declarations; accept it as no parameters rather than a malformed one.
      ; Nested ifs (not and_bool, which evaluates both sides eagerly) are
      ; required here: node_kind on param -1 (the "no sibling" sentinel) is
      ; out of bounds.
      (if
        (condition (ne_i64 (local_get param) (const_i64 -1)))
        (then (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get param)) (call_i32 node_list)))
            (then (do
              (if
                (condition (eq_i64 (call_i64 count_children (param_get tree) (local_get param)) (const_i64 0)))
                (then (do
                  (if
                    (condition (eq_i64 (call_i64 node_next_sibling (param_get tree) (local_get param)) (const_i64 -1)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))))
            (else (do)))))
        (else (do)))
      (while
        (condition (ne_i64 (local_get param) (const_i64 -1)))
        (do
          (if
            (condition (or_bool
              (ne_i32 (call_i32 node_kind (param_get tree) (local_get param)) (call_i32 node_list))
