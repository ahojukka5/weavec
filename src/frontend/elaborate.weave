; SPDX-License-Identifier: Apache-2.0
; elaborate.weave — typed surface facts and canonical call elaboration
;
; The self-hosted frontend owns all language meaning in this module. The host
; runtime only stores copied symbol/local names so facts survive parser teardown
; between files in one compilation.

(program
  (name "elaborate")
  (version "0.1")

  (fn surface_type_unknown (params) (returns i32) (do (return (const_i32 0))))
  (fn surface_type_void    (params) (returns i32) (do (return (const_i32 1))))
  (fn surface_type_i32     (params) (returns i32) (do (return (const_i32 2))))
  (fn surface_type_i64     (params) (returns i32) (do (return (const_i32 3))))
  (fn surface_type_f32     (params) (returns i32) (do (return (const_i32 4))))
  (fn surface_type_f64     (params) (returns i32) (do (return (const_i32 5))))
  (fn surface_type_bool    (params) (returns i32) (do (return (const_i32 6))))
  (fn surface_type_ptr     (params) (returns i32) (do (return (const_i32 7))))

  (fn surface_type_code
    (params (tree ptr) (source ptr) (type_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get type_node) (const_i64 -1)))
        (then (do (return (call_i32 surface_type_unknown))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "void") (const_i64 4)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_void))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "i32") (const_i64 3)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_i32))))
        (else (do)))
      (if
        (condition (or_bool
          (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
            (const_string_ptr "i64") (const_i64 3)) (const_i32 0))
          (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
            (const_string_ptr "Qubit") (const_i64 5)) (const_i32 0))))
        (then (do (return (call_i32 surface_type_i64))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "f32") (const_i64 3)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_f32))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "f64") (const_i64 3)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_f64))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "bool") (const_i64 4)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_bool))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "ptr") (const_i64 3)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_ptr))))
        (else (do)))
      (return (call_i32 surface_type_unknown))))

  (fn surface_emit_type_name
    (params (fd i32) (type i32))
    (returns void)
    (do
      (if (condition (eq_i32 (param_get type) (call_i32 surface_type_void)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "void")) (return_void)))
        (else (do)))
      (if (condition (eq_i32 (param_get type) (call_i32 surface_type_i32)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "i32")) (return_void)))
        (else (do)))
      (if (condition (eq_i32 (param_get type) (call_i32 surface_type_i64)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "i64")) (return_void)))
        (else (do)))
      (if (condition (eq_i32 (param_get type) (call_i32 surface_type_f32)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "f32")) (return_void)))
        (else (do)))
      (if (condition (eq_i32 (param_get type) (call_i32 surface_type_f64)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "f64")) (return_void)))
        (else (do)))
      (if (condition (eq_i32 (param_get type) (call_i32 surface_type_bool)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "bool")) (return_void)))
        (else (do)))
      (if (condition (eq_i32 (param_get type) (call_i32 surface_type_ptr)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "ptr")) (return_void)))
        (else (do)))
      (call_void write_cstr (param_get fd) (const_string_ptr "unknown"))
      (return_void)))

  (fn surface_error_prefix
    (params (node_label ptr))
    (returns void)
    (do
      (call_void weave_surface_set_error)
      (call_void write_cstr (const_i32 2) (const_string_ptr "weavec: surface "))
      (call_void write_cstr (const_i32 2) (param_get node_label))
      (call_void write_cstr (const_i32 2) (const_string_ptr ": "))
      (return_void)))

  (fn surface_node_is_ident
    (params (tree ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_ident)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn surface_node_is_list_head
    (params (tree ptr) (source ptr) (node i64) (head ptr) (head_len i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (return (call_i32 head_equals
        (param_get tree) (param_get source) (param_get node)
        (param_get head) (param_get head_len)))))

  (fn surface_parameters_shape_valid
    (params (tree ptr) (source ptr) (params_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i32 (call_i32 surface_node_is_list_head
          (param_get tree) (param_get source) (param_get params_node)
          (const_string_ptr "params") (const_i64 6)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let head i64 (call_i64 node_first_child (param_get tree) (param_get params_node)))
      (let param i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (while
        (condition (ne_i64 (local_get param) (const_i64 -1)))
        (do
          (if
            (condition (or_bool
              (ne_i32 (call_i32 node_kind (param_get tree) (local_get param)) (call_i32 node_list))
              (ne_i64 (call_i64 count_children (param_get tree) (local_get param)) (const_i64 2))))
            (then (do (return (const_i32 0))))
            (else (do)))
          (let name_node i64 (call_i64 nth_child (param_get tree) (local_get param) (const_i64 0)))
          (let type_node i64 (call_i64 nth_child (param_get tree) (local_get param) (const_i64 1)))
          (if
            (condition (or_bool
              (eq_i32 (call_i32 surface_node_is_ident (param_get tree) (local_get name_node)) (const_i32 0))
              (eq_i32 (call_i32 surface_node_is_ident (param_get tree) (local_get type_node)) (const_i32 0))))
            (then (do (return (const_i32 0))))
            (else (do)))
          (set param (call_i64 node_next_sibling (param_get tree) (local_get param)))))
      (return (const_i32 1))))

  (fn surface_callable_shape_valid
    (params (tree ptr) (source ptr) (decl_node i64))
    (returns i32)
    (do
      (if
        (condition (lt_i64 (call_i64 count_children (param_get tree) (param_get decl_node)) (const_i64 4)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let name_node i64 (call_i64 nth_child (param_get tree) (param_get decl_node) (const_i64 1)))
      (let params_node i64 (call_i64 nth_child (param_get tree) (param_get decl_node) (const_i64 2)))
      (let returns_node i64 (call_i64 nth_child (param_get tree) (param_get decl_node) (const_i64 3)))
      (if
        (condition (eq_i32 (call_i32 surface_node_is_ident
          (param_get tree) (local_get name_node)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 surface_parameters_shape_valid
          (param_get tree) (param_get source) (local_get params_node)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 surface_node_is_list_head
          (param_get tree) (param_get source) (local_get returns_node)
          (const_string_ptr "returns") (const_i64 7)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i64 (call_i64 count_children (param_get tree) (local_get returns_node)) (const_i64 2)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let type_node i64 (call_i64 nth_child (param_get tree) (local_get returns_node) (const_i64 1)))
      (return (call_i32 surface_node_is_ident (param_get tree) (local_get type_node)))))

  (fn surface_register_parameters
    (params (tree ptr) (source ptr) (params_node i64))
    (returns i32)
    (do
      (let head i64 (call_i64 node_first_child (param_get tree) (param_get params_node)))
      (let param i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (while
        (condition (ne_i64 (local_get param) (const_i64 -1)))
        (do
          (let type_node i64 (call_i64 nth_child (param_get tree) (local_get param) (const_i64 1)))
          (let type i32 (call_i32 surface_type_code (param_get tree) (param_get source) (local_get type_node)))
          (if
            (condition (eq_i32 (local_get type) (call_i32 surface_type_unknown)))
            (then (do
              (call_void surface_error_prefix (const_string_ptr "declaration"))
              (call_void write_cstr (const_i32 2) (const_string_ptr "unknown parameter type"))
              (call_void write_byte (const_i32 2) (const_i32 10))
              (return (const_i32 1))))
            (else (do)))
          (if
            (condition (ne_i32 (call_i32 weave_surface_symbol_add_parameter (local_get type)) (const_i32 0)))
            (then (do
              (call_void surface_error_prefix (const_string_ptr "declaration"))
              (call_void write_cstr (const_i32 2) (const_string_ptr "too many parameters or invalid symbol state"))
              (call_void write_byte (const_i32 2) (const_i32 10))
              (return (const_i32 1))))
            (else (do)))
          (set param (call_i64 node_next_sibling (param_get tree) (local_get param)))))
      (return (const_i32 0))))

  (fn surface_register_callable
    (params (tree ptr) (source ptr) (decl_node i64))
    (returns i32)
    (do
      ; Malformed declarations remain owned by the established frontend/backend
      ; validators. Semantic registration must never dereference missing children.
      (if
        (condition (eq_i32 (call_i32 surface_callable_shape_valid
          (param_get tree) (param_get source) (param_get decl_node)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let name_node i64 (call_i64 nth_child (param_get tree) (param_get decl_node) (const_i64 1)))
      (let params_node i64 (call_i64 nth_child (param_get tree) (param_get decl_node) (const_i64 2)))
      (let returns_node i64 (call_i64 nth_child (param_get tree) (param_get decl_node) (const_i64 3)))
      (let return_type_node i64 (call_i64 nth_child (param_get tree) (local_get returns_node) (const_i64 1)))
      (let return_type i32 (call_i32 surface_type_code
        (param_get tree) (param_get source) (local_get return_type_node)))
      (if
        (condition (eq_i32 (local_get return_type) (call_i32 surface_type_unknown)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "declaration"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "unknown return type for "))
          (call_void emit_node_text (const_i32 2) (param_get source) (param_get tree) (local_get name_node))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (return (const_i32 1))))
        (else (do)))
      (let symbol_status i32 (call_i32 weave_surface_symbol_begin
        (param_get source)
        (call_i64 node_text_start (param_get tree) (local_get name_node))
        (call_i64 node_text_len (param_get tree) (local_get name_node))
        (local_get return_type)))
      (if
        (condition (lt_i32 (local_get symbol_status) (const_i32 0)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "declaration"))
          (if
            (condition (eq_i32 (local_get symbol_status) (const_i32 -2)))
            (then (do (call_void write_cstr (const_i32 2) (const_string_ptr "duplicate symbol "))))
            (else (do (call_void write_cstr (const_i32 2) (const_string_ptr "cannot register symbol ")))))
          (call_void emit_node_text (const_i32 2) (param_get source) (param_get tree) (local_get name_node))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (return (const_i32 1))))
        (else (do)))
      (return (call_i32 surface_register_parameters
        (param_get tree) (param_get source) (local_get params_node)))))

  (fn surface_register_const
    (params (tree ptr) (source ptr) (decl_node i64))
    (returns i32)
    (do
      (if
        (condition (ne_i64 (call_i64 count_children (param_get tree) (param_get decl_node)) (const_i64 4)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let name_node i64 (call_i64 nth_child (param_get tree) (param_get decl_node) (const_i64 1)))
      (let type_node i64 (call_i64 nth_child (param_get tree) (param_get decl_node) (const_i64 2)))
      (if
        (condition (or_bool
          (eq_i32 (call_i32 surface_node_is_ident (param_get tree) (local_get name_node)) (const_i32 0))
          (eq_i32 (call_i32 surface_node_is_ident (param_get tree) (local_get type_node)) (const_i32 0))))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let type i32 (call_i32 surface_type_code (param_get tree) (param_get source) (local_get type_node)))
      (if
        (condition (eq_i32 (local_get type) (call_i32 surface_type_unknown)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (let status i32 (call_i32 weave_surface_symbol_begin
        (param_get source)
        (call_i64 node_text_start (param_get tree) (local_get name_node))
        (call_i64 node_text_len (param_get tree) (local_get name_node))
        (local_get type)))
      (if
        (condition (lt_i32 (local_get status) (const_i32 0)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "declaration"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "duplicate or invalid constant "))
          (call_void emit_node_text (const_i32 2) (param_get source) (param_get tree) (local_get name_node))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn surface_register_program_decls
    (params (tree ptr) (source ptr))
    (returns i32)
    (do
      (let child i64 (call_i64 program_first_decl (param_get tree) (param_get source)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (or_bool
                  (or_bool
                    (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                      (const_string_ptr "fn") (const_i64 2)) (const_i32 0))
                    (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                      (const_string_ptr "extern") (const_i64 6)) (const_i32 0)))
                  (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                    (const_string_ptr "entry") (const_i64 5)) (const_i32 0))))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 surface_register_callable
                      (param_get tree) (param_get source) (local_get child)) (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "const") (const_i64 5)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 surface_register_const
                      (param_get tree) (param_get source) (local_get child)) (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn surface_prepare_params
    (params (tree ptr) (source ptr) (params_node i64))
    (returns void)
    (do
      (call_void weave_surface_locals_reset)
      (if
        (condition (eq_i32 (call_i32 surface_parameters_shape_valid
          (param_get tree) (param_get source) (param_get params_node)) (const_i32 0)))
        (then (do (return_void)))
        (else (do)))
      (let head i64 (call_i64 node_first_child (param_get tree) (param_get params_node)))
      (let param i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (while
        (condition (ne_i64 (local_get param) (const_i64 -1)))
        (do
          (let name_node i64 (call_i64 nth_child (param_get tree) (local_get param) (const_i64 0)))
          (let type_node i64 (call_i64 nth_child (param_get tree) (local_get param) (const_i64 1)))
          (call_i32 weave_surface_local_add
            (param_get source)
            (call_i64 node_text_start (param_get tree) (local_get name_node))
            (call_i64 node_text_len (param_get tree) (local_get name_node))
            (call_i32 surface_type_code (param_get tree) (param_get source) (local_get type_node)))
          (set param (call_i64 node_next_sibling (param_get tree) (local_get param)))))
      (return_void)))

  (fn surface_prepare_returns
    (params (tree ptr) (source ptr) (returns_node i64))
    (returns void)
    (do
      (let type_node i64 (call_i64 nth_child (param_get tree) (param_get returns_node) (const_i64 1)))
      (call_void weave_surface_set_return_type
        (call_i32 surface_type_code (param_get tree) (param_get source) (local_get type_node)))
      (return_void)))

  (fn surface_note_let
    (params (tree ptr) (source ptr) (let_node i64))
    (returns void)
    (do
      (let name_node i64 (call_i64 nth_child (param_get tree) (param_get let_node) (const_i64 1)))
      (let type_node i64 (call_i64 nth_child (param_get tree) (param_get let_node) (const_i64 2)))
      (call_i32 weave_surface_local_add
        (param_get source)
        (call_i64 node_text_start (param_get tree) (local_get name_node))
        (call_i64 node_text_len (param_get tree) (local_get name_node))
        (call_i32 surface_type_code (param_get tree) (param_get source) (local_get type_node)))
      (return_void)))

  (fn surface_ident_type
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (or_bool
          (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get node)
            (const_string_ptr "true") (const_i64 4)) (const_i32 0))
          (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get node)
            (const_string_ptr "false") (const_i64 5)) (const_i32 0))))
        (then (do (return (call_i32 surface_type_bool))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get node)
          (const_string_ptr "null") (const_i64 4)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_ptr))))
        (else (do)))
      (return (call_i32 weave_surface_local_type
        (param_get source)
        (call_i64 node_text_start (param_get tree) (param_get node))
        (call_i64 node_text_len (param_get tree) (param_get node))))))

  (fn surface_explicit_head_type
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "call_i32") (const_i64 8)) (const_i32 0))
            (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "const_i32") (const_i64 9)) (const_i32 0)))
          (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
            (const_string_ptr "cast_i64_to_i32") (const_i64 15)) (const_i32 0))))
        (then (do (return (call_i32 surface_type_i32))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "call_i64") (const_i64 8)) (const_i32 0))
            (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "const_i64") (const_i64 9)) (const_i32 0)))
          (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (param_get node)
            (const_string_ptr "cast_i32_to_i64") (const_i64 15)) (const_i32 0))))
        (then (do (return (call_i32 surface_type_i64))))
        (else (do)))
      (if
