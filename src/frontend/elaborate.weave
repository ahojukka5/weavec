; SPDX-License-Identifier: Apache-2.0
; elaborate.weave — typed surface facts and canonical call elaboration
;
; The self-hosted frontend owns all language meaning in this module. The host
; runtime only stores copied symbol/local names so facts survive parser teardown
; between files in one compilation.

(program
  (name "elaborate")
  (version "0.1")

  ; Zero remains the absence/unknown sentinel. Every resolved primitive is an
  ; opaque reference interned in the compiler-owned semantic type graph.
  (fn surface_type_unknown (params) (returns i32) (do (return (const_i32 0))))
  (fn surface_type_void    (params) (returns i32) (do (return (call_i32 weave_semantic_type_primitive (const_string_ptr "void")))))
  (fn surface_type_i32     (params) (returns i32) (do (return (call_i32 weave_semantic_type_primitive (const_string_ptr "i32")))))
  (fn surface_type_i64     (params) (returns i32) (do (return (call_i32 weave_semantic_type_primitive (const_string_ptr "i64")))))
  (fn surface_type_f32     (params) (returns i32) (do (return (call_i32 weave_semantic_type_primitive (const_string_ptr "f32")))))
  (fn surface_type_f64     (params) (returns i32) (do (return (call_i32 weave_semantic_type_primitive (const_string_ptr "f64")))))
  (fn surface_type_bool    (params) (returns i32) (do (return (call_i32 weave_semantic_type_primitive (const_string_ptr "bool")))))
  (fn surface_type_ptr     (params) (returns i32) (do (return (call_i32 weave_semantic_type_primitive (const_string_ptr "ptr")))))

  (fn surface_type_code
    (params (tree ptr) (source ptr) (type_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get type_node) (const_i64 -1)))
        (then (do (return (call_i32 surface_type_unknown))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "void") (const_i64 4)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_void))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "i32") (const_i64 3)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_i32))))
        (else (do)))
      (if
        (condition (or_bool
          (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
            (const_string_ptr "i64") (const_i64 3)) (const_i32 0))
          (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
            (const_string_ptr "Qubit") (const_i64 5)) (const_i32 0))))
        (then (do (return (call_i32 surface_type_i64))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "f32") (const_i64 3)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_f32))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "f64") (const_i64 3)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_f64))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "bool") (const_i64 4)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_bool))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get type_node)
          (const_string_ptr "ptr") (const_i64 3)) (const_i32 0)))
        (then (do (return (call_i32 surface_type_ptr))))
        (else (do)))
      (return (call_i32 surface_type_unknown))))

  (fn surface_emit_type_name
    (params (fd i32) (type i32))
    (returns void)
    (do
      (call_void write_cstr
        (param_get fd) (call_ptr weave_semantic_type_display (param_get type)))
      (return_void)))

  (fn surface_error_prefix
    (params (node_label ptr))
    (returns void)
    (do
      (call_void weave_surface_set_error)
      (call_void write_cstr (const_i32 2) (const_string_ptr "weavec: surface "))
      (call_void write_cstr (const_i32 2) (param_get node_label))
      (call_void write_cstr (const_i32 2) (const_string_ptr ": "))
      (return_void)))

  (fn surface_node_is_ident
    (params (tree ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_ident)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn surface_node_is_list_head
    (params (tree ptr) (source ptr) (node i64) (head ptr) (head_len i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (return (call_i32 head_equals
        (param_get tree) (param_get source) (param_get node)
        (param_get head) (param_get head_len)))))

  ; Underscore-shaped heads stay WIR-shaped (`add_i32`, `ptr_add`, `local_get`)
  ; unless the symbol table already registered them as callables.
  (fn surface_ident_contains_underscore
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i32 (call_i32 surface_node_is_ident
          (param_get tree) (param_get node)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let sc_start i64 (call_i64 node_text_start
        (param_get tree) (param_get node)))
      (let sc_len i64 (call_i64 node_text_len
        (param_get tree) (param_get node)))
      (let sc_i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get sc_i) (local_get sc_len)))
        (do
          (if
            (condition (eq_i32 (load_u8 (ptr_add (param_get source)
              (add_i64 (local_get sc_start) (local_get sc_i))))
              (const_i32 95)))
            (then (do (return (const_i32 1))))
            (else (do)))
          (set sc_i (add_i64 (local_get sc_i) (const_i64 1)))))
      (return (const_i32 0))))

  (fn surface_is_wrapped_call
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (return (call_i32 surface_node_is_list_head
        (param_get tree) (param_get source) (param_get node)
        (const_string_ptr "call") (const_i64 4)))))

  ; A Lisp-head call is `(f args...)` where `f` is not a reserved syntax head.
  ; Reserved heads are dispatched before this predicate in emit_node. Names that
  ; contain `_` stay WIR-shaped unless they are registered callables.
  (fn surface_is_direct_call
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i32 (call_i32 node_kind
          (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do))
        (else (do (return (const_i32 0)))))
      (if
        (condition (ne_i32 (call_i32 surface_is_wrapped_call
          (param_get tree) (param_get source) (param_get node))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 surface_is_wir_call_node
          (param_get tree) (param_get source) (param_get node))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let sc_head i64 (call_i64 node_first_child
        (param_get tree) (param_get node)))
      (if
        (condition (eq_i32 (call_i32 surface_node_is_ident
          (param_get tree) (local_get sc_head)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 surface_ident_is_reserved_syntax
          (param_get tree) (param_get source) (local_get sc_head))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (let sc_start i64 (call_i64 node_text_start
        (param_get tree) (local_get sc_head)))
      (let sc_len i64 (call_i64 node_text_len
        (param_get tree) (local_get sc_head)))
      (let sc_known i32 (call_i32 weave_surface_symbol_return_type
        (param_get source) (local_get sc_start) (local_get sc_len)))
      (if
        (condition (ne_i32 (local_get sc_known) (call_i32 surface_type_unknown)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 surface_ident_contains_underscore
          (param_get tree) (param_get source) (local_get sc_head))
          (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do (return (const_i32 1)))))))

  (fn surface_is_call_node
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 surface_is_wrapped_call
          (param_get tree) (param_get source) (param_get node))
          (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (call_i32 surface_is_direct_call
        (param_get tree) (param_get source) (param_get node)))))

  (fn surface_call_name_node
    (params (tree ptr) (source ptr) (node i64))
    (returns i64)
    (do
      (if
        (condition (or_bool
          (ne_i32 (call_i32 surface_is_wrapped_call
            (param_get tree) (param_get source) (param_get node))
            (const_i32 0))
          (ne_i32 (call_i32 surface_is_wir_call_node
            (param_get tree) (param_get source) (param_get node))
            (const_i32 0))))
        (then (do (return (call_i64 nth_child
          (param_get tree) (param_get node) (const_i64 1)))))
        (else (do (return (call_i64 node_first_child
          (param_get tree) (param_get node))))))))

  (fn surface_call_prefix_count
    (params (tree ptr) (source ptr) (node i64))
    (returns i64)
    (do
      (if
        (condition (ne_i32 (call_i32 surface_is_wrapped_call
          (param_get tree) (param_get source) (param_get node))
          (const_i32 0)))
        (then (do (return (const_i64 2))))
        (else (do (return (const_i64 1)))))))

  (fn surface_ident_is_reserved_syntax
    (params (tree ptr) (source ptr) (node i64))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 surface_ident_is_operator_head
          (param_get tree) (param_get source) (param_get node))
          (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "fn") (const_i64 2))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "entry") (const_i64 5))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "let") (const_i64 3))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "set") (const_i64 3))
                (const_i32 0))))
          (or_bool
            (or_bool
              (or_bool
                (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                  (param_get node) (const_string_ptr "if") (const_i64 2))
                  (const_i32 0))
                (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                  (param_get node) (const_string_ptr "when") (const_i64 4))
                  (const_i32 0)))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "return") (const_i64 6))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "call") (const_i64 4))
                (const_i32 0))
              (or_bool
                (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                  (param_get node) (const_string_ptr "op") (const_i64 2))
                  (const_i32 0))
                (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                  (param_get node) (const_string_ptr "match") (const_i64 5))
                  (const_i32 0)))))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "do") (const_i64 2))
              (const_i32 0))
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "while") (const_i64 5))
              (const_i32 0)))
          (or_bool
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "for") (const_i64 3))
              (const_i32 0))
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "cast") (const_i64 4))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "try") (const_i64 3))
                (const_i32 0))))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "new") (const_i64 3))
              (const_i32 0))
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "variant") (const_i64 7))
              (const_i32 0)))
          (or_bool
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "field-get") (const_i64 9))
              (const_i32 0))
            (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
              (param_get node) (const_string_ptr "interp") (const_i64 6))
              (const_i32 0)))))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (or_bool
          (or_bool
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "condition") (const_i64 9))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "then") (const_i64 4))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "else") (const_i64 4))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "params") (const_i64 6))
                (const_i32 0))))
          (or_bool
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "returns") (const_i64 7))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "break") (const_i64 5))
                (const_i32 0)))
            (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "continue") (const_i64 8))
                (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source)
                (param_get node) (const_string_ptr "case") (const_i64 4))
