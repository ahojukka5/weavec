          (call_void write_cstr (const_i32 2) (const_string_ptr "expected "))
          (call_void surface_emit_type_name (const_i32 2) (param_get expected))
          (call_void write_cstr (const_i32 2) (const_string_ptr ", got "))
          (call_void surface_emit_type_name (const_i32 2) (local_get actual_ty))
          (call_void write_byte (const_i32 2) (const_i32 10))))
        (else (do)))
      (return_void)))

  (fn surface_emit_const_for_code
    (params (fd i32) (source ptr) (tree ptr) (type i32) (node i64))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "(const_"))
      (call_void surface_emit_type_name (param_get fd) (param_get type))
      (call_void write_byte (param_get fd) (const_i32 32))
      (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (param_get node))
      (call_void write_byte (param_get fd) (const_i32 41))
      (return_void)))

  (fn surface_emit_expr_expected
    (params (fd i32) (source ptr) (tree ptr) (node i64) (expected i32))
    (returns void)
    (do
      (let kind i32 (call_i32 node_kind (param_get tree) (param_get node)))
      (if
        (condition (and_bool
          (eq_i32 (local_get kind) (call_i32 node_int))
          (or_bool
            (or_bool
              (eq_i32 (param_get expected) (call_i32 surface_type_i32))
              (eq_i32 (param_get expected) (call_i32 surface_type_i64)))
            (or_bool
              (eq_i32 (param_get expected) (call_i32 surface_type_f32))
              (eq_i32 (param_get expected) (call_i32 surface_type_f64))))))
        (then (do
          (call_void surface_emit_const_for_code
            (param_get fd) (param_get source) (param_get tree) (param_get expected) (param_get node))
          (return_void)))
        (else (do)))
      (if
        (condition (and_bool
          (eq_i32 (local_get kind) (call_i32 node_string))
          (eq_i32 (param_get expected) (call_i32 surface_type_ptr))))
        (then (do
          (call_void write_cstr (param_get fd) (const_string_ptr "(const_string_ptr "))
          (call_void weave_surface_write_string_quoted
            (param_get fd) (param_get source)
            (call_i64 node_text_start (param_get tree) (param_get node))
            (call_i64 node_text_len (param_get tree) (param_get node))
            (cast_i64_to_i32 (call_i64 node_value
              (param_get tree) (param_get node))))
          (call_void write_byte (param_get fd) (const_i32 41))
          (return_void)))
        (else (do)))
      (if
        (condition (and_bool
          (eq_i32 (local_get kind) (call_i32 node_ident))
          (eq_i32 (param_get expected) (call_i32 surface_type_bool))))
        (then (do
          (if
            (condition (or_bool
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get node)
                (const_string_ptr "true") (const_i64 4)) (const_i32 0))
              (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get node)
                (const_string_ptr "false") (const_i64 5)) (const_i32 0))))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "(const_bool "))
              (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (param_get node))
              (call_void write_byte (param_get fd) (const_i32 41))
              (return_void)))
            (else (do)))))
        (else (do)))
      (if
        (condition (and_bool
          (eq_i32 (local_get kind) (call_i32 node_ident))
          (eq_i32 (param_get expected) (call_i32 surface_type_ptr))))
        (then (do
          (if
            (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get node)
              (const_string_ptr "null") (const_i64 4)) (const_i32 0)))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "(const_null)"))
              (return_void)))
            (else (do)))))
        (else (do)))
      (call_void emit_node (param_get fd) (param_get source) (param_get tree) (param_get node))
      (return_void)))

  (fn surface_emit_call_prefix
    (params (fd i32) (return_type i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "(call_"))
      (call_void surface_emit_type_name (param_get fd) (param_get return_type))
      (return_void)))

  (fn surface_emit_call
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (let name_node i64 (call_i64 surface_call_name_node
        (param_get tree) (param_get source) (param_get node)))
      (if
        (condition (eq_i32 (call_i32 surface_node_is_ident
          (param_get tree) (local_get name_node)) (const_i32 0)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "call"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "missing function name"))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (call_void write_cstr (param_get fd) (const_string_ptr "(const_i32 0)"))
          (return_void)))
        (else (do)))
      (let name_start i64 (call_i64 node_text_start (param_get tree) (local_get name_node)))
      (let name_len i64 (call_i64 node_text_len (param_get tree) (local_get name_node)))
      (let return_type i32 (call_i32 weave_surface_symbol_return_type
        (param_get source) (local_get name_start) (local_get name_len)))
      (let expected_count i32 (call_i32 weave_surface_symbol_parameter_count
        (param_get source) (local_get name_start) (local_get name_len)))
      (let actual_count i64 (sub_i64
        (call_i64 count_children (param_get tree) (param_get node))
        (call_i64 surface_call_prefix_count
          (param_get tree) (param_get source) (param_get node))))
      (if
        (condition (eq_i32 (local_get return_type) (call_i32 surface_type_unknown)))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "call"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "unresolved function "))
          (call_void emit_node_text (const_i32 2) (param_get source) (param_get tree) (local_get name_node))
          (call_void write_byte (const_i32 2) (const_i32 10))
          (set return_type (call_i32 surface_type_i32))))
        (else (do)))
      (if
        (condition (and_bool
          (ge_i32 (local_get expected_count) (const_i32 0))
          (ne_i64 (local_get actual_count) (cast_i32_to_i64 (local_get expected_count)))))
        (then (do
          (call_void surface_error_prefix (const_string_ptr "call"))
          (call_void write_cstr (const_i32 2) (const_string_ptr "wrong arity for "))
          (call_void emit_node_text (const_i32 2) (param_get source) (param_get tree) (local_get name_node))
          (call_void write_cstr (const_i32 2) (const_string_ptr ": expected "))
          (call_void write_i64_dec (const_i32 2) (cast_i32_to_i64 (local_get expected_count)))
          (call_void write_cstr (const_i32 2) (const_string_ptr ", got "))
          (call_void write_i64_dec (const_i32 2) (local_get actual_count))
          (call_void write_byte (const_i32 2) (const_i32 10))))
        (else (do)))
      (call_void surface_emit_call_prefix (param_get fd) (local_get return_type))
      (call_void write_byte (param_get fd) (const_i32 32))
      (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (local_get name_node))
      (let arg i64 (call_i64 node_next_sibling (param_get tree) (local_get name_node)))
      (let arg_index i32 (const_i32 0))
      (while
        (condition (ne_i64 (local_get arg) (const_i64 -1)))
        (do
          (let expected i32 (call_i32 weave_surface_symbol_parameter_type
            (param_get source) (local_get name_start) (local_get name_len) (local_get arg_index)))
          (let actual_ty i32 (call_i32 surface_expr_type
            (param_get tree) (param_get source) (local_get arg) (local_get expected)))
          (if
            (condition (and_bool
              (ne_i32 (local_get expected) (call_i32 surface_type_unknown))
              (and_bool
                (ne_i32 (local_get actual_ty) (call_i32 surface_type_unknown))
                (ne_i32 (local_get expected) (local_get actual_ty)))))
            (then (do
              (call_void surface_error_prefix (const_string_ptr "call"))
              (call_void write_cstr (const_i32 2) (const_string_ptr "argument type mismatch for "))
              (call_void emit_node_text (const_i32 2) (param_get source) (param_get tree) (local_get name_node))
              (call_void write_cstr (const_i32 2) (const_string_ptr ": expected "))
              (call_void surface_emit_type_name (const_i32 2) (local_get expected))
              (call_void write_cstr (const_i32 2) (const_string_ptr ", got "))
              (call_void surface_emit_type_name (const_i32 2) (local_get actual_ty))
              (call_void write_byte (const_i32 2) (const_i32 10))))
            (else (do)))
          (call_void write_byte (param_get fd) (const_i32 32))
          (if
            (condition (eq_i32 (local_get expected) (call_i32 surface_type_unknown)))
            (then (do (call_void emit_node
              (param_get fd) (param_get source) (param_get tree) (local_get arg))))
            (else (do (call_void surface_emit_expr_expected
              (param_get fd) (param_get source) (param_get tree) (local_get arg) (local_get expected)))))
          (set arg_index (add_i32 (local_get arg_index) (const_i32 1)))
          (set arg (call_i64 node_next_sibling (param_get tree) (local_get arg)))))
      (call_void write_byte (param_get fd) (const_i32 41))
      (return_void)))

  (fn surface_emit_return
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (let value i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
      (let expected i32 (call_i32 weave_surface_get_return_type))
      (call_void surface_check_expr_expected
        (param_get tree) (param_get source) (local_get value) (local_get expected)
        (const_string_ptr "return"))
      (call_void write_cstr (param_get fd) (const_string_ptr "(return "))
      (call_void surface_emit_expr_expected
        (param_get fd) (param_get source) (param_get tree) (local_get value)
        (local_get expected))
      (call_void write_byte (param_get fd) (const_i32 41))
      (return_void)))

  (fn surface_emit_set
    (params (fd i32) (source ptr) (tree ptr) (node i64))
    (returns void)
    (do
      (let name_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 1)))
      (let value_node i64 (call_i64 nth_child (param_get tree) (param_get node) (const_i64 2)))
      (let expected i32 (call_i32 surface_ident_type
        (param_get tree) (param_get source) (local_get name_node)))
      (call_void surface_check_expr_expected
        (param_get tree) (param_get source) (local_get value_node) (local_get expected)
        (const_string_ptr "assignment"))
      (call_void write_cstr (param_get fd) (const_string_ptr "(set "))
      (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (local_get name_node))
      (call_void write_byte (param_get fd) (const_i32 32))
      (if
        (condition (eq_i32 (local_get expected) (call_i32 surface_type_unknown)))
        (then (do (call_void emit_node
          (param_get fd) (param_get source) (param_get tree) (local_get value_node))))
        (else (do (call_void surface_emit_expr_expected
          (param_get fd) (param_get source) (param_get tree) (local_get value_node) (local_get expected)))))
      (call_void write_byte (param_get fd) (const_i32 41))
      (return_void)))
)
