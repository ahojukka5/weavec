; SPDX-License-Identifier: Apache-2.0
; modules.weave — explicit module/import/export interface validation
;
; The self-hosted frontend owns the module grammar and diagnostics. Host C only
; retains copied module, import, export, and symbol names between parser passes.

(program
  (name "modules")
  (version "0.1")

  (fn surface_module_error
    (params
      (source ptr) (tree ptr) (node i64) (message ptr)
      (code ptr) (role ptr) (symbol_node i64))
    (returns void)
    (do
      (let module_diag_start i64 (const_i64 -1))
      (let module_diag_length i64 (const_i64 0))
      (let module_diag_symbol_start i64 (const_i64 -1))
      (let module_diag_symbol_length i64 (const_i64 0))
      (if
        (condition (ne_i64 (param_get node) (const_i64 -1)))
        (then (do
          (set module_diag_start (call_i64 node_text_start
            (param_get tree) (param_get node)))
          (set module_diag_length (call_i64 node_text_len
            (param_get tree) (param_get node)))
          (if
            (condition (ne_i64 (param_get symbol_node) (const_i64 -1)))
            (then (do
              (set module_diag_symbol_start (call_i64 node_text_start
                (param_get tree) (param_get symbol_node)))
              (set module_diag_symbol_length (call_i64 node_text_len
                (param_get tree) (param_get symbol_node)))))
            (else (do)))
          (call_void weave_rt_diag_record
            (param_get code)
            (param_get source)
            (local_get module_diag_start)
            (local_get module_diag_length)
            (const_null)
            (const_null)
            (const_i32 -1)
            (const_i32 -1)
            (const_i32 -1)
            (param_get role)
            (param_get source)
            (local_get module_diag_symbol_start)
            (local_get module_diag_symbol_length)
            (const_i32 0))))
        (else (do)))
      (call_void surface_error_prefix (const_string_ptr "module"))
      (call_void write_cstr (const_i32 2) (param_get message))
      (if
        (condition (ne_i64 (param_get node) (const_i64 -1)))
        (then (do
          (call_void write_cstr (const_i32 2) (const_string_ptr " "))
          (call_void emit_node_text
            (const_i32 2) (param_get source) (param_get tree) (param_get node))))
        (else (do)))
      (call_void write_byte (const_i32 2) (const_i32 10))
      (return_void)))

  (fn surface_module_root_head
    (params (tree ptr))
    (returns i64)
    (do
      (if
        (condition (ne_i32 (call_i32 node_kind (param_get tree) (const_i64 0))
          (call_i32 node_list)))
        (then (do (return (const_i64 -1))))
        (else (do)))
      (return (call_i64 node_first_child (param_get tree) (const_i64 0)))))

  (fn surface_module_is_legacy
    (params (tree ptr) (source ptr))
    (returns i32)
    (do
      (let head i64 (call_i64 surface_module_root_head (param_get tree)))
      (if
        (condition (eq_i64 (local_get head) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (return (call_i32 ident_equals
        (param_get tree) (param_get source) (local_get head)
        (const_string_ptr "program") (const_i64 7)))))

  (fn surface_module_is_explicit
    (params (tree ptr) (source ptr))
    (returns i32)
    (do
      (let head i64 (call_i64 surface_module_root_head (param_get tree)))
      (if
        (condition (eq_i64 (local_get head) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (return (call_i32 ident_equals
        (param_get tree) (param_get source) (local_get head)
        (const_string_ptr "module") (const_i64 6)))))

  (fn surface_module_name_node
    (params (tree ptr))
    (returns i64)
    (do
      (return (call_i64 nth_child
        (param_get tree) (const_i64 0) (const_i64 1)))))

  (fn surface_module_register_export
    (params (tree ptr) (source ptr) (clause i64))
    (returns i32)
    (do
      (let head i64 (call_i64 node_first_child (param_get tree) (param_get clause)))
      (let symbol i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (if
        (condition (eq_i64 (local_get symbol) (const_i64 -1)))
        (then (do
          (call_void surface_module_error
            (param_get source) (param_get tree) (param_get clause)
            (const_string_ptr "export requires at least one symbol")
            (const_string_ptr "frontend.module.export-empty")
            (const_string_ptr "export")
            (const_i64 -1))
          (return (const_i32 1))))
        (else (do)))
      (while
        (condition (ne_i64 (local_get symbol) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 node_kind
              (param_get tree) (local_get symbol)) (call_i32 node_ident)))
            (then (do
              (call_void surface_module_error
                (param_get source) (param_get tree) (local_get symbol)
                (const_string_ptr "export symbol must be an identifier")
                (const_string_ptr "frontend.module.export-invalid-symbol")
                (const_string_ptr "export-symbol")
                (local_get symbol))
              (return (const_i32 1))))
            (else (do)))
          (let status i32 (call_i32 weave_surface_module_add_export
            (param_get source)
            (call_i64 node_text_start (param_get tree) (local_get symbol))
            (call_i64 node_text_len (param_get tree) (local_get symbol))))
          (if
            (condition (lt_i32 (local_get status) (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (local_get status) (const_i32 -2)))
                (then (do
                  (call_void surface_module_error
                    (param_get source) (param_get tree) (local_get symbol)
                    (const_string_ptr "duplicate export")
                    (const_string_ptr "frontend.module.duplicate-export")
                    (const_string_ptr "export-symbol")
                    (local_get symbol))))
                (else (do
                  (call_void surface_module_error
                    (param_get source) (param_get tree) (local_get symbol)
                    (const_string_ptr "cannot register export")
                    (const_string_ptr "frontend.module.export-registration")
                    (const_string_ptr "export-symbol")
                    (local_get symbol)))))
              (return (const_i32 1))))
            (else (do)))
          (set symbol (call_i64 node_next_sibling
            (param_get tree) (local_get symbol)))))
      (return (const_i32 0))))

  (fn surface_module_register_import
    (params (tree ptr) (source ptr) (clause i64))
    (returns i32)
    (do
      (if
        (condition (ne_i64 (call_i64 count_children
          (param_get tree) (param_get clause)) (const_i64 3)))
        (then (do
          (call_void surface_module_error
            (param_get source) (param_get tree) (param_get clause)
            (const_string_ptr "import shape is (import MODULE (SYMBOL...))")
            (const_string_ptr "frontend.module.import-shape")
            (const_string_ptr "import")
            (const_i64 -1))
          (return (const_i32 1))))
        (else (do)))
      (let module_node i64 (call_i64 nth_child
        (param_get tree) (param_get clause) (const_i64 1)))
      (let symbols_node i64 (call_i64 nth_child
        (param_get tree) (param_get clause) (const_i64 2)))
      (if
        (condition (or_bool
          (ne_i32 (call_i32 node_kind (param_get tree) (local_get module_node))
            (call_i32 node_ident))
          (ne_i32 (call_i32 node_kind (param_get tree) (local_get symbols_node))
            (call_i32 node_list))))
        (then (do
          (call_void surface_module_error
            (param_get source) (param_get tree) (param_get clause)
            (const_string_ptr "import requires a module and symbol list")
            (const_string_ptr "frontend.module.import-shape")
            (const_string_ptr "import")
            (const_i64 -1))
          (return (const_i32 1))))
        (else (do)))
      (let symbol i64 (call_i64 node_first_child
        (param_get tree) (local_get symbols_node)))
      (if
        (condition (eq_i64 (local_get symbol) (const_i64 -1)))
        (then (do
          (call_void surface_module_error
            (param_get source) (param_get tree) (local_get symbols_node)
            (const_string_ptr "import symbol list cannot be empty")
            (const_string_ptr "frontend.module.import-empty")
            (const_string_ptr "import")
            (local_get module_node))
          (return (const_i32 1))))
        (else (do)))
      (while
        (condition (ne_i64 (local_get symbol) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 node_kind
              (param_get tree) (local_get symbol)) (call_i32 node_ident)))
            (then (do
              (call_void surface_module_error
                (param_get source) (param_get tree) (local_get symbol)
                (const_string_ptr "import symbol must be an identifier")
                (const_string_ptr "frontend.module.import-invalid-symbol")
                (const_string_ptr "import-symbol")
                (local_get symbol))
              (return (const_i32 1))))
            (else (do)))
          (let status i32 (call_i32 weave_surface_module_add_import
            (param_get source)
            (call_i64 node_text_start (param_get tree) (local_get module_node))
            (call_i64 node_text_len (param_get tree) (local_get module_node))
            (call_i64 node_text_start (param_get tree) (local_get symbol))
            (call_i64 node_text_len (param_get tree) (local_get symbol))))
          (if
            (condition (lt_i32 (local_get status) (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (local_get status) (const_i32 -2)))
                (then (do
                  (call_void surface_module_error
                    (param_get source) (param_get tree) (local_get symbol)
                    (const_string_ptr "duplicate import")
                    (const_string_ptr "frontend.module.duplicate-import")
                    (const_string_ptr "import-symbol")
                    (local_get symbol))))
                (else (do
                  (if
                    (condition (eq_i32 (local_get status) (const_i32 -3)))
                    (then (do
                      (call_void surface_module_error
                        (param_get source) (param_get tree) (local_get symbol)
                        (const_string_ptr "conflicting imported binding")
                        (const_string_ptr "frontend.module.conflicting-import")
                        (const_string_ptr "import-symbol")
                        (local_get symbol))))
                    (else (do
                      (call_void surface_module_error
                        (param_get source) (param_get tree) (local_get symbol)
                        (const_string_ptr "cannot register import")
                        (const_string_ptr "frontend.module.import-registration")
                        (const_string_ptr "import-symbol")
                        (local_get symbol))))))))
              (return (const_i32 1))))
            (else (do)))
          (set symbol (call_i64 node_next_sibling
            (param_get tree) (local_get symbol)))))
      (return (const_i32 0))))

  (fn surface_prepare_module
    (params (tree ptr) (source ptr))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 surface_module_is_legacy
          (param_get tree) (param_get source)) (const_i32 0)))
        (then (do
          (if
            (condition (ne_i32 (call_i32 weave_surface_module_use_legacy)
              (const_i32 0)))
            (then (do
              (call_void surface_module_error
                (param_get source) (param_get tree) (const_i64 0)
                (const_string_ptr "cannot mix legacy program and explicit module roots")
                (const_string_ptr "frontend.module.mixed-roots")
                (const_string_ptr "module")
                (const_i64 -1))
              (return (const_i32 1))))
            (else (do)))
          (return (const_i32 0))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 surface_module_is_explicit
          (param_get tree) (param_get source)) (const_i32 0)))
        (then (do
          (call_void surface_module_error
            (param_get source) (param_get tree) (const_i64 0)
            (const_string_ptr "root must be program or module")
            (const_string_ptr "frontend.module.invalid-root")
            (const_string_ptr "root")
            (const_i64 -1))
          (return (const_i32 1))))
        (else (do)))
      (let name_node i64 (call_i64 surface_module_name_node (param_get tree)))
      (if
        (condition (or_bool
          (eq_i64 (local_get name_node) (const_i64 -1))
          (ne_i32 (call_i32 node_kind (param_get tree) (local_get name_node))
            (call_i32 node_ident))))
        (then (do
          (call_void surface_module_error
            (param_get source) (param_get tree) (local_get name_node)
            (const_string_ptr "module name must be an identifier")
            (const_string_ptr "frontend.module.invalid-name")
            (const_string_ptr "module-name")
            (local_get name_node))
          (return (const_i32 1))))
        (else (do)))
      (let begin_status i32 (call_i32 weave_surface_module_begin
        (param_get source)
        (call_i64 node_text_start (param_get tree) (local_get name_node))
        (call_i64 node_text_len (param_get tree) (local_get name_node))))
      (if
        (condition (lt_i32 (local_get begin_status) (const_i32 0)))
        (then (do
          (if
            (condition (eq_i32 (local_get begin_status) (const_i32 -2)))
            (then (do
              (call_void surface_module_error
                (param_get source) (param_get tree) (local_get name_node)
                (const_string_ptr "duplicate module")
                (const_string_ptr "frontend.module.duplicate")
                (const_string_ptr "module-name")
                (local_get name_node))))
            (else (do
              (if
                (condition (eq_i32 (local_get begin_status) (const_i32 -3)))
                (then (do
                  (call_void surface_module_error
                    (param_get source) (param_get tree) (local_get name_node)
                    (const_string_ptr "cannot mix explicit modules with legacy programs")
                    (const_string_ptr "frontend.module.mixed-roots")
                    (const_string_ptr "module-name")
                    (local_get name_node))))
                (else (do
                  (call_void surface_module_error
                    (param_get source) (param_get tree) (local_get name_node)
                    (const_string_ptr "cannot register module")
                    (const_string_ptr "frontend.module.registration")
                    (const_string_ptr "module-name")
                    (local_get name_node))))))))
          (return (const_i32 1))))
        (else (do)))
      (let child i64 (call_i64 node_next_sibling
        (param_get tree) (local_get name_node)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind
              (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals
                  (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "export") (const_i64 6)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 surface_module_register_export
                      (param_get tree) (param_get source) (local_get child))
                      (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))
              (if
                (condition (ne_i32 (call_i32 head_equals
                  (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "import") (const_i64 6)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 surface_module_register_import
                      (param_get tree) (param_get source) (local_get child))
                      (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling
            (param_get tree) (local_get child)))))
      (return (const_i32 0))))

  (fn surface_select_module
    (params (tree ptr) (source ptr))
    (returns i32)
    (do
      (if
        (condition (ne_i32 (call_i32 surface_module_is_legacy
          (param_get tree) (param_get source)) (const_i32 0)))
        (then (do (return (call_i32 weave_surface_module_use_legacy))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 surface_module_is_explicit
          (param_get tree) (param_get source)) (const_i32 0)))
        (then (do (return (const_i32 -1))))
        (else (do)))
      (let name_node i64 (call_i64 surface_module_name_node (param_get tree)))
      (return (call_i32 weave_surface_module_select
        (param_get source)
        (call_i64 node_text_start (param_get tree) (local_get name_node))
        (call_i64 node_text_len (param_get tree) (local_get name_node))))))

  (fn surface_validate_module_export
    (params (tree ptr) (source ptr) (clause i64))
    (returns i32)
    (do
      (let head i64 (call_i64 node_first_child (param_get tree) (param_get clause)))
      (let symbol i64 (call_i64 node_next_sibling (param_get tree) (local_get head)))
      (while
        (condition (ne_i64 (local_get symbol) (const_i64 -1)))
        (do
          (if
            (condition (ne_i32 (call_i32 weave_surface_module_export_status
              (param_get source)
              (call_i64 node_text_start (param_get tree) (local_get symbol))
              (call_i64 node_text_len (param_get tree) (local_get symbol)))
              (const_i32 0)))
            (then (do
              (call_void surface_module_error
                (param_get source) (param_get tree) (local_get symbol)
                (const_string_ptr "exported symbol is not declared in this module")
                (const_string_ptr "frontend.module.export-undeclared")
                (const_string_ptr "export-symbol")
                (local_get symbol))
              (return (const_i32 1))))
            (else (do)))
          (set symbol (call_i64 node_next_sibling
            (param_get tree) (local_get symbol)))))
      (return (const_i32 0))))

  (fn surface_validate_module_import
    (params (tree ptr) (source ptr) (clause i64))
    (returns i32)
    (do
      (let module_node i64 (call_i64 nth_child
        (param_get tree) (param_get clause) (const_i64 1)))
      (let symbols_node i64 (call_i64 nth_child
        (param_get tree) (param_get clause) (const_i64 2)))
      (let symbol i64 (call_i64 node_first_child
        (param_get tree) (local_get symbols_node)))
      (while
        (condition (ne_i64 (local_get symbol) (const_i64 -1)))
        (do
          (let status i32 (call_i32 weave_surface_module_import_status
            (param_get source)
            (call_i64 node_text_start (param_get tree) (local_get module_node))
            (call_i64 node_text_len (param_get tree) (local_get module_node))
            (call_i64 node_text_start (param_get tree) (local_get symbol))
            (call_i64 node_text_len (param_get tree) (local_get symbol))))
          (if
            (condition (ne_i32 (local_get status) (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (local_get status) (const_i32 -1)))
                (then (do
                  (call_void surface_module_error
                    (param_get source) (param_get tree) (local_get module_node)
                    (const_string_ptr "imported module does not exist")
                    (const_string_ptr "frontend.module.import-missing-module")
                    (const_string_ptr "import-module")
                    (local_get module_node))))
                (else (do
                  (if
                    (condition (eq_i32 (local_get status) (const_i32 -2)))
                    (then (do
                      (call_void surface_module_error
                        (param_get source) (param_get tree) (local_get symbol)
                        (const_string_ptr "imported symbol does not exist")
                        (const_string_ptr "frontend.module.import-missing-symbol")
                        (const_string_ptr "import-symbol")
                        (local_get symbol))))
                    (else (do
                      (call_void surface_module_error
                        (param_get source) (param_get tree) (local_get symbol)
                        (const_string_ptr "imported symbol is private")
                        (const_string_ptr "frontend.module.import-private-symbol")
                        (const_string_ptr "import-symbol")
                        (local_get symbol))))))))
              (return (const_i32 1))))
            (else (do)))
          (set symbol (call_i64 node_next_sibling
            (param_get tree) (local_get symbol)))))
      (return (const_i32 0))))

  (fn surface_validate_module_interfaces
    (params (tree ptr) (source ptr))
    (returns i32)
    (do
      (if
        (condition (eq_i32 (call_i32 surface_module_is_explicit
          (param_get tree) (param_get source)) (const_i32 0)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (lt_i32 (call_i32 surface_select_module
          (param_get tree) (param_get source)) (const_i32 0)))
        (then (do
          (call_void surface_module_error
            (param_get source) (param_get tree) (const_i64 0)
            (const_string_ptr "module was not registered during declaration pass")
            (const_string_ptr "frontend.module.unregistered")
            (const_string_ptr "module")
            (call_i64 surface_module_name_node (param_get tree)))
          (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 weave_surface_module_current_has_cycle)
          (const_i32 0)))
        (then (do
          (call_void surface_module_error
            (param_get source) (param_get tree)
            (call_i64 surface_module_name_node (param_get tree))
            (const_string_ptr "import cycle includes module")
            (const_string_ptr "frontend.module.import-cycle")
            (const_string_ptr "module-name")
            (call_i64 surface_module_name_node (param_get tree)))
          (return (const_i32 1))))
        (else (do)))
      (let name_node i64 (call_i64 surface_module_name_node (param_get tree)))
      (let child i64 (call_i64 node_next_sibling
        (param_get tree) (local_get name_node)))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind
              (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals
                  (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "export") (const_i64 6)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 surface_validate_module_export
                      (param_get tree) (param_get source) (local_get child))
                      (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))
              (if
                (condition (ne_i32 (call_i32 head_equals
                  (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "import") (const_i64 6)) (const_i32 0)))
                (then (do
                  (if
                    (condition (ne_i32 (call_i32 surface_validate_module_import
                      (param_get tree) (param_get source) (local_get child))
                      (const_i32 0)))
                    (then (do (return (const_i32 1))))
                    (else (do)))))
                (else (do)))))
            (else (do)))
          (set child (call_i64 node_next_sibling
            (param_get tree) (local_get child)))))
      (return (const_i32 0))))
)
