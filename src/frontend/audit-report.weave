  (fn audit_program
    (params (fd i32) (source ptr) (tree ptr))
    (returns i32)
    (do
      (let first_decl i64 (call_i64 program_first_decl (param_get tree) (param_get source)))
      (let effect_table ptr (call_ptr effect_table_build
        (param_get tree) (param_get source) (local_get first_decl)))
      (let child i64 (local_get first_decl))
      (while
        (condition (ne_i64 (local_get child) (const_i64 -1)))
        (do
          (if
            (condition (eq_i32 (call_i32 node_kind (param_get tree) (local_get child)) (call_i32 node_list)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                  (const_string_ptr "fn") (const_i64 2)) (const_i32 0)))
                (then (do
                  (call_void audit_fn (param_get fd) (param_get source) (param_get tree) (local_get child)
                    (local_get first_decl) (local_get effect_table))))
                (else (do
                  (if
                    (condition (ne_i32 (call_i32 head_equals (param_get tree) (param_get source) (local_get child)
                      (const_string_ptr "entry") (const_i64 5)) (const_i32 0)))
                    (then (do
                      (if
                        (condition (eq_i32 (call_i32 explain_entry_has_fn_def
                          (param_get tree) (param_get source) (local_get first_decl) (local_get child)) (const_i32 0)))
                        (then (do
                          (if
                            (condition (eq_i32 (call_i32 explain_entry_is_stub
                              (param_get tree) (local_get child)) (const_i32 0)))
                            (then (do
                              (call_void audit_fn (param_get fd) (param_get source) (param_get tree) (local_get child)
                                (local_get first_decl) (local_get effect_table))))
                            (else (do
                              (call_void audit_entry_stub (param_get fd) (param_get source) (param_get tree) (local_get child)))))))
                        (else (do)))))
                    (else (do))))))))
            (else (do)))
          (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))
      (call_void effect_table_free (local_get effect_table))
      (return (const_i32 0))))

  (fn audit_program_json
    (params (fd i32) (source ptr) (tree ptr))
    (returns i32)
    (do
      (return (call_i32 explain_program_audit_json (param_get fd) (param_get source) (param_get tree)))))

  (fn audit_file
    (params (input_path ptr))
    (returns i32)
    (do
      (return (call_i32 explain_file_mode (param_get input_path) (const_i32 2)))))

  (fn audit_file_json
    (params (input_path ptr))
    (returns i32)
    (do
      (return (call_i32 explain_file_mode (param_get input_path) (const_i32 3)))))
