; SPDX-License-Identifier: Apache-2.0
; audit-report.weave — compiler audit report mode (--audit)

(program
  (name "audit-report")
  (version "0.1")

  (fn audit_is_known_runtime_name
    (params (tree ptr) (source ptr) (name_node i64))
    (returns i32)
    (do
      (if
        (condition (eq_i64 (param_get name_node) (const_i64 -1)))
        (then (do (return (const_i32 0))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "malloc") (const_i64 6)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "free") (const_i64 4)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "realloc") (const_i64 7)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "puts") (const_i64 4)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "putchar") (const_i64 7)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "strlen") (const_i64 6)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "weave_rt_fatal") (const_i64 15)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "weave_rt_read_file") (const_i64 19)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "weave_rt_write_file") (const_i64 20)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (param_get name_node)
          (const_string_ptr "weave_rt_contract_fail") (const_i64 22)) (const_i32 0)))
        (then (do (return (const_i32 1))))
        (else (do)))
      (return (const_i32 0))))

  (fn audit_collect_callees_node
    (params (direct_ctx ptr) (runtime_ctx ptr) (unknown_ctx ptr)
      (tree ptr) (source ptr) (node i64) (first_decl i64))
    (returns void)
    (do
      (if
        (condition (eq_i64 (param_get node) (const_i64 -1)))
        (then (do (return_void)))
        (else (do)))
      (if
        (condition (ne_i32 (call_i32 explain_node_is_call (param_get tree) (param_get source) (param_get node)) (const_i32 0)))
        (then (do
          (let callee i64 (call_i64 surface_call_name_node
            (param_get tree) (param_get source) (param_get node)))
          (if
            (condition (ne_i32 (call_i32 explain_is_local_fn_name
              (param_get tree) (param_get source) (param_get first_decl) (local_get callee)) (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (call_i32 explain_ctx_contains
                  (param_get direct_ctx) (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                (then (do
                  (call_void explain_ctx_add (param_get direct_ctx) (local_get callee))))
                (else (do)))))
            (else (do)))
          (if
            (condition (eq_i32 (call_i32 explain_is_local_fn_name
              (param_get tree) (param_get source) (param_get first_decl) (local_get callee)) (const_i32 0)))
            (then (do
              (if
                (condition (ne_i32 (call_i32 audit_is_known_runtime_name
                  (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                (then (do
                  (if
                    (condition (eq_i32 (call_i32 explain_ctx_contains
                      (param_get runtime_ctx) (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                    (then (do
                      (call_void explain_ctx_add (param_get runtime_ctx) (local_get callee))))
                    (else (do)))))
                (else (do)))))
            (else (do)))
          (if
            (condition (eq_i32 (call_i32 explain_is_local_fn_name
              (param_get tree) (param_get source) (param_get first_decl) (local_get callee)) (const_i32 0)))
            (then (do
              (if
                (condition (eq_i32 (call_i32 audit_is_known_runtime_name
                  (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                (then (do
                  (if
                    (condition (eq_i32 (call_i32 explain_ctx_contains
                      (param_get unknown_ctx) (param_get tree) (param_get source) (local_get callee)) (const_i32 0)))
                    (then (do
                      (call_void explain_ctx_add (param_get unknown_ctx) (local_get callee))))
                    (else (do)))))
                (else (do)))))
            (else (do)))))
        (else (do)))
      (if
        (condition (eq_i32 (call_i32 node_kind (param_get tree) (param_get node)) (call_i32 node_list)))
        (then (do
          (let child i64 (call_i64 node_first_child (param_get tree) (param_get node)))
          (while
            (condition (ne_i64 (local_get child) (const_i64 -1)))
            (do
              (call_void audit_collect_callees_node
                (param_get direct_ctx) (param_get runtime_ctx) (param_get unknown_ctx)
                (param_get tree) (param_get source) (local_get child) (param_get first_decl))
              (set child (call_i64 node_next_sibling (param_get tree) (local_get child)))))))
        (else (do)))
      (return_void)))

  (fn audit_emit_callee_list
    (params (fd i32) (source ptr) (tree ptr) (ctx ptr))
    (returns void)
    (do
      (let n i64 (call_i64 explain_ctx_count (param_get ctx)))
      (if
        (condition (eq_i64 (local_get n) (const_i64 0)))
        (then (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  none"))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do
          (let i i64 (const_i64 0))
          (while
            (condition (lt_i64 (local_get i) (local_get n)))
            (do
              (call_void write_cstr (param_get fd) (const_string_ptr "  "))
              (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
                (call_i64 explain_ctx_name_at (param_get ctx) (local_get i)))
              (call_void write_byte (param_get fd) (const_i32 10))
              (set i (add_i64 (local_get i) (const_i64 1))))))))
      (return_void)))

  (fn audit_emit_yes_no
    (params (fd i32) (flag i32))
    (returns void)
    (do
      (if
        (condition (ne_i32 (param_get flag) (const_i32 0)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "yes"))))
        (else (do (call_void write_cstr (param_get fd) (const_string_ptr "no")))))
      (return_void)))

  (fn audit_emit_effect_status
    (params (fd i32) (label ptr) (status i32))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "  "))
      (call_void write_cstr (param_get fd) (param_get label))
      (call_void write_cstr (param_get fd) (const_string_ptr ": "))
      (if
        (condition (eq_i32 (param_get status) (const_i32 0)))
        (then (do (call_void write_cstr (param_get fd) (const_string_ptr "verified"))))
        (else (do
          (if
            (condition (eq_i32 (param_get status) (const_i32 1)))
            (then (do (call_void write_cstr (param_get fd) (const_string_ptr "FAILED"))))
            (else (do (call_void write_cstr (param_get fd) (const_string_ptr "unknown"))))))))
      (call_void write_byte (param_get fd) (const_i32 10))
      (return_void)))

  (fn audit_runtime_ctx_find_alloc
    (params (tree ptr) (source ptr) (runtime_ctx ptr))
    (returns i64)
    (do
      (let n i64 (call_i64 explain_ctx_count (param_get runtime_ctx)))
      (let i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get i) (local_get n)))
        (do
          (let name i64 (call_i64 explain_ctx_name_at (param_get runtime_ctx) (local_get i)))
          (if
            (condition (ne_i32 (call_i32 effect_is_alloc_name
              (param_get tree) (param_get source) (local_get name)) (const_i32 0)))
            (then (do (return (local_get name))))
            (else (do)))
          (set i (add_i64 (local_get i) (const_i64 1)))))
      (return (const_i64 -1))))

  (fn audit_runtime_ctx_find_io
    (params (tree ptr) (source ptr) (runtime_ctx ptr))
    (returns i64)
    (do
      (let n i64 (call_i64 explain_ctx_count (param_get runtime_ctx)))
      (let i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get i) (local_get n)))
        (do
          (let name i64 (call_i64 explain_ctx_name_at (param_get runtime_ctx) (local_get i)))
          (if
            (condition (ne_i32 (call_i32 effect_is_io_name
              (param_get tree) (param_get source) (local_get name)) (const_i32 0)))
            (then (do (return (local_get name))))
            (else (do)))
          (if
            (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get name)
              (const_string_ptr "free") (const_i64 4)) (const_i32 0)))
            (then (do (return (local_get name))))
            (else (do)))
          (if
            (condition (ne_i32 (call_i32 ident_equals (param_get tree) (param_get source) (local_get name)
              (const_string_ptr "weave_rt_fatal") (const_i64 15)) (const_i32 0)))
            (then (do (return (local_get name))))
            (else (do)))
          (set i (add_i64 (local_get i) (const_i64 1)))))
      (return (const_i64 -1))))

  (fn audit_runtime_ctx_find_nondeterministic
    (params (tree ptr) (source ptr) (runtime_ctx ptr))
    (returns i64)
    (do
      (let n i64 (call_i64 explain_ctx_count (param_get runtime_ctx)))
      (let i i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get i) (local_get n)))
        (do
          (let name i64 (call_i64 explain_ctx_name_at (param_get runtime_ctx) (local_get i)))
          (if
            (condition (ne_i32 (call_i32 effect_is_nondeterministic_name
              (param_get tree) (param_get source) (local_get name)) (const_i32 0)))
            (then (do (return (local_get name))))
            (else (do)))
          (set i (add_i64 (local_get i) (const_i64 1)))))
      (return (const_i64 -1))))

  (fn audit_emit_effect_reasons
    (params (fd i32) (source ptr) (tree ptr) (fn_node i64) (effect_table ptr)
      (runtime_ctx ptr) (unknown_ctx ptr))
    (returns void)
    (do
      (let any i32 (const_i32 0))
      (let has_no_alloc i32 (call_i32 fn_has_no_alloc_clause (param_get tree) (param_get source) (param_get fn_node)))
      (let has_pure i32 (call_i32 fn_has_pure_clause (param_get tree) (param_get source) (param_get fn_node)))
      (let has_det i32 (call_i32 fn_has_deterministic_clause (param_get tree) (param_get source) (param_get fn_node)))
      (let trans_alloc i32 (call_i32 effect_table_trans_alloc (param_get effect_table) (param_get fn_node)))
      (let trans_purity i32 (call_i32 effect_table_trans_purity (param_get effect_table) (param_get fn_node)))
      (let trans_det i32 (call_i32 effect_table_trans_det (param_get effect_table) (param_get fn_node)))
      (if
        (condition (and_bool
          (ne_i32 (local_get has_no_alloc) (const_i32 0))
          (eq_i32 (local_get trans_alloc) (const_i32 1))))
        (then (do
          (if
            (condition (eq_i32 (local_get any) (const_i32 0)))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "Reasons:"))
              (call_void write_byte (param_get fd) (const_i32 10))
              (set any (const_i32 1))))
            (else (do)))
          (call_void write_cstr (param_get fd) (const_string_ptr "  no_alloc failed: calls allocation function "))
          (let alloc_name i64 (call_i64 audit_runtime_ctx_find_alloc
            (param_get tree) (param_get source) (param_get runtime_ctx)))
          (if
            (condition (ne_i64 (local_get alloc_name) (const_i64 -1)))
            (then (do
              (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (local_get alloc_name))))
            (else (do
              (call_void write_cstr (param_get fd) (const_string_ptr "malloc")))))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get has_no_alloc) (const_i32 0))
          (eq_i32 (local_get trans_alloc) (const_i32 2))))
        (then (do
          (if
            (condition (eq_i32 (local_get any) (const_i32 0)))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "Reasons:"))
              (call_void write_byte (param_get fd) (const_i32 10))
              (set any (const_i32 1))))
            (else (do)))
          (call_void write_cstr (param_get fd) (const_string_ptr "  no_alloc unknown: calls unknown function "))
          (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
            (call_i64 explain_ctx_name_at (param_get unknown_ctx) (const_i64 0)))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get has_pure) (const_i32 0))
          (eq_i32 (local_get trans_purity) (const_i32 1))))
        (then (do
          (if
            (condition (eq_i32 (local_get any) (const_i32 0)))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "Reasons:"))
              (call_void write_byte (param_get fd) (const_i32 10))
              (set any (const_i32 1))))
            (else (do)))
          (let io_name i64 (call_i64 audit_runtime_ctx_find_io
            (param_get tree) (param_get source) (param_get runtime_ctx)))
          (let alloc_name2 i64 (call_i64 audit_runtime_ctx_find_alloc
            (param_get tree) (param_get source) (param_get runtime_ctx)))
          (call_void write_cstr (param_get fd) (const_string_ptr "  pure failed: calls "))
          (if
            (condition (ne_i64 (local_get alloc_name2) (const_i64 -1)))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "allocation function "))
              (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (local_get alloc_name2))))
            (else (do
              (if
                (condition (ne_i64 (local_get io_name) (const_i64 -1)))
                (then (do
                  (call_void write_cstr (param_get fd) (const_string_ptr "I/O function "))
                  (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (local_get io_name))))
                (else (do
                  (call_void write_cstr (param_get fd) (const_string_ptr "impure function"))))))))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get has_pure) (const_i32 0))
          (eq_i32 (local_get trans_purity) (const_i32 2))))
        (then (do
          (if
            (condition (eq_i32 (local_get any) (const_i32 0)))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "Reasons:"))
              (call_void write_byte (param_get fd) (const_i32 10))
              (set any (const_i32 1))))
            (else (do)))
          (call_void write_cstr (param_get fd) (const_string_ptr "  pure unknown: calls unknown function "))
          (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
            (call_i64 explain_ctx_name_at (param_get unknown_ctx) (const_i64 0)))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get has_det) (const_i32 0))
          (eq_i32 (local_get trans_det) (const_i32 1))))
        (then (do
          (if
            (condition (eq_i32 (local_get any) (const_i32 0)))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "Reasons:"))
              (call_void write_byte (param_get fd) (const_i32 10))
              (set any (const_i32 1))))
            (else (do)))
          (let nd_name i64 (call_i64 audit_runtime_ctx_find_nondeterministic
            (param_get tree) (param_get source) (param_get runtime_ctx)))
          (call_void write_cstr (param_get fd) (const_string_ptr "  deterministic failed: calls nondeterministic function "))
          (if
            (condition (ne_i64 (local_get nd_name) (const_i64 -1)))
            (then (do
              (call_void emit_node_text (param_get fd) (param_get source) (param_get tree) (local_get nd_name))))
            (else (do
              (call_void write_cstr (param_get fd) (const_string_ptr "unknown")))))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (if
        (condition (and_bool
          (ne_i32 (local_get has_det) (const_i32 0))
          (eq_i32 (local_get trans_det) (const_i32 2))))
        (then (do
          (if
            (condition (eq_i32 (local_get any) (const_i32 0)))
            (then (do
              (call_void write_cstr (param_get fd) (const_string_ptr "Reasons:"))
              (call_void write_byte (param_get fd) (const_i32 10))
              (set any (const_i32 1))))
            (else (do)))
          (call_void write_cstr (param_get fd) (const_string_ptr "  deterministic unknown: calls unknown external function "))
          (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
            (call_i64 explain_ctx_name_at (param_get unknown_ctx) (const_i64 0)))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (return_void)))

  (fn audit_emit_effect_contracts
    (params (fd i32) (source ptr) (tree ptr) (fn_node i64) (first_decl i64) (effect_table ptr)
      (runtime_ctx ptr) (unknown_ctx ptr))
    (returns void)
    (do
      (let has_any i32 (call_i32 fn_declares_any_effect_clause
        (param_get tree) (param_get source) (param_get fn_node)))
      (call_void write_cstr (param_get fd) (const_string_ptr "Effect contracts:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (if
        (condition (eq_i32 (local_get has_any) (const_i32 0)))
        (then (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  none declared"))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do
          (let has_pure i32 (call_i32 fn_has_pure_clause (param_get tree) (param_get source) (param_get fn_node)))
          (let has_no_alloc i32 (call_i32 fn_has_no_alloc_clause (param_get tree) (param_get source) (param_get fn_node)))
          (let has_det i32 (call_i32 fn_has_deterministic_clause (param_get tree) (param_get source) (param_get fn_node)))
          (if
            (condition (ne_i32 (local_get has_no_alloc) (const_i32 0)))
            (then (do
              (call_void audit_emit_effect_status (param_get fd) (const_string_ptr "no_alloc")
                (call_i32 effect_table_trans_alloc (param_get effect_table) (param_get fn_node)))))
            (else (do)))
          (if
            (condition (ne_i32 (local_get has_pure) (const_i32 0)))
            (then (do
              (call_void audit_emit_effect_status (param_get fd) (const_string_ptr "pure")
                (call_i32 effect_table_trans_purity (param_get effect_table) (param_get fn_node)))))
            (else (do)))
          (if
            (condition (ne_i32 (local_get has_det) (const_i32 0)))
            (then (do
              (call_void audit_emit_effect_status (param_get fd) (const_string_ptr "deterministic")
                (call_i32 effect_table_trans_det (param_get effect_table) (param_get fn_node)))))
            (else (do)))
          (call_void audit_emit_effect_reasons
            (param_get fd) (param_get source) (param_get tree) (param_get fn_node) (param_get effect_table)
            (param_get runtime_ctx) (param_get unknown_ctx)))))
      (return_void)))

  (fn audit_emit_purity_line
    (params (fd i32) (effect_table ptr) (fn_node i64) (allocations i64) (runtime_ctx ptr) (unknown_ctx ptr))
    (returns void)
    (do
      (call_void write_cstr (param_get fd) (const_string_ptr "  conservative: "))
      (let label ptr (const_string_ptr "pure"))
      (if
        (condition (ne_ptr (param_get effect_table) (const_null)))
        (then (do
          (let purity i32 (call_i32 effect_table_trans_purity (param_get effect_table) (param_get fn_node)))
          (if
            (condition (eq_i32 (local_get purity) (const_i32 1)))
            (then (do (set label (const_string_ptr "impure"))))
            (else (do)))
          (if
            (condition (eq_i32 (local_get purity) (const_i32 2)))
            (then (do (set label (const_string_ptr "unknown"))))
            (else (do)))))
        (else (do
          (let runtime_n i64 (call_i64 explain_ctx_count (param_get runtime_ctx)))
          (let unknown_n i64 (call_i64 explain_ctx_count (param_get unknown_ctx)))
          (if
            (condition (gt_i64 (param_get allocations) (const_i64 0)))
            (then (do (set label (const_string_ptr "impure"))))
            (else (do)))
          (if
            (condition (gt_i64 (local_get runtime_n) (const_i64 0)))
            (then (do (set label (const_string_ptr "impure"))))
            (else (do)))
          (if
            (condition (and_bool
              (eq_i64 (param_get allocations) (const_i64 0))
              (and_bool
                (eq_i64 (local_get runtime_n) (const_i64 0))
                (gt_i64 (local_get unknown_n) (const_i64 0)))))
            (then (do (set label (const_string_ptr "unknown"))))
            (else (do))))))
      (call_void write_cstr (param_get fd) (local_get label))
      (call_void write_byte (param_get fd) (const_i32 10))
      (return_void)))

  (fn audit_emit_warnings
    (params (fd i32) (source ptr) (tree ptr)
      (n_req i64) (n_ens i64) (allocations i64)
      (runtime_ctx ptr) (unknown_ctx ptr))
    (returns void)
    (do
      (let any i32 (const_i32 0))
      (if
        (condition (eq_i64 (param_get n_req) (const_i64 0)))
        (then (do
          (set any (const_i32 1))
          (call_void write_cstr (param_get fd) (const_string_ptr "  function has no requires clauses"))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (if
        (condition (eq_i64 (param_get n_ens) (const_i64 0)))
        (then (do
          (set any (const_i32 1))
          (call_void write_cstr (param_get fd) (const_string_ptr "  function has no ensures clauses"))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (let rn i64 (call_i64 explain_ctx_count (param_get runtime_ctx)))
      (let ri i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get ri) (local_get rn)))
        (do
          (set any (const_i32 1))
          (call_void write_cstr (param_get fd) (const_string_ptr "  calls external/runtime function "))
          (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
            (call_i64 explain_ctx_name_at (param_get runtime_ctx) (local_get ri)))
          (call_void write_byte (param_get fd) (const_i32 10))
          (set ri (add_i64 (local_get ri) (const_i64 1)))))
      (if
        (condition (gt_i64 (param_get allocations) (const_i64 0)))
        (then (do
          (set any (const_i32 1))
          (call_void write_cstr (param_get fd) (const_string_ptr "  function appears to allocate memory"))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (let un i64 (call_i64 explain_ctx_count (param_get unknown_ctx)))
      (let ui i64 (const_i64 0))
      (while
        (condition (lt_i64 (local_get ui) (local_get un)))
        (do
          (set any (const_i32 1))
          (call_void write_cstr (param_get fd) (const_string_ptr "  purity is unknown because callee "))
          (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
            (call_i64 explain_ctx_name_at (param_get unknown_ctx) (local_get ui)))
          (call_void write_cstr (param_get fd) (const_string_ptr " was not found"))
          (call_void write_byte (param_get fd) (const_i32 10))
          (set ui (add_i64 (local_get ui) (const_i64 1)))))
      (if
        (condition (eq_i32 (local_get any) (const_i32 0)))
        (then (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  none"))
          (call_void write_byte (param_get fd) (const_i32 10))))
        (else (do)))
      (return_void)))

  (fn audit_fn
    (params (fd i32) (source ptr) (tree ptr) (fn_node i64) (first_decl i64) (effect_table ptr))
    (returns void)
    (do
      (let do_node i64 (call_i64 fn_find_do_child (param_get tree) (param_get source) (param_get fn_node)))
      (let returns_sites i64 (const_i64 0))
      (let conditionals i64 (const_i64 0))
      (let loop_sites i64 (const_i64 0))
      (let allocations i64 (const_i64 0))
      (let direct_ctx ptr (const_null))
      (let runtime_ctx ptr (const_null))
      (let unknown_ctx ptr (const_null))
      (if
        (condition (ne_i64 (local_get do_node) (const_i64 -1)))
        (then (do
          (set returns_sites (call_i64 count_return_sites_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (set conditionals (call_i64 count_conditionals_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (set loop_sites (call_i64 count_while_loops_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (set allocations (call_i64 count_allocations_in_node
            (param_get tree) (param_get source) (local_get do_node)))
          (set direct_ctx (call_ptr explain_ctx_new))
          (set runtime_ctx (call_ptr explain_ctx_new))
          (set unknown_ctx (call_ptr explain_ctx_new))
          (call_void audit_collect_callees_node
            (local_get direct_ctx) (local_get runtime_ctx) (local_get unknown_ctx)
            (param_get tree) (param_get source) (local_get do_node) (param_get first_decl))))
        (else (do)))
      (let n_req i64 (call_i64 count_contract_clauses
        (param_get tree) (param_get source) (param_get fn_node)
        (const_string_ptr "requires") (const_i64 8)))
      (let n_ens i64 (call_i64 count_contract_clauses
        (param_get tree) (param_get source) (param_get fn_node)
        (const_string_ptr "ensures") (const_i64 7)))
      (call_void write_cstr (param_get fd) (const_string_ptr "Function: "))
      (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
        (call_i64 nth_child (param_get tree) (param_get fn_node) (const_i64 1)))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "Parameters:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void explain_emit_params (param_get fd) (param_get source) (param_get tree) (param_get fn_node))
      (call_void write_cstr (param_get fd) (const_string_ptr "Returns: "))
      (call_void emit_node_text (param_get fd) (param_get source) (param_get tree)
        (call_i64 fn_return_type_node (param_get tree) (param_get fn_node)))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "Contracts:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  requires:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void explain_emit_contract_lines
        (param_get fd) (param_get source) (param_get tree) (param_get fn_node)
        (const_string_ptr "requires") (const_i64 8))
      (call_void write_cstr (param_get fd) (const_string_ptr "  ensures:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void explain_emit_contract_lines
        (param_get fd) (param_get source) (param_get tree) (param_get fn_node)
        (const_string_ptr "ensures") (const_i64 7))
      (call_void audit_emit_effect_contracts
        (param_get fd) (param_get source) (param_get tree) (param_get fn_node) (param_get first_decl) (param_get effect_table)
        (local_get runtime_ctx) (local_get unknown_ctx))
      (call_void write_cstr (param_get fd) (const_string_ptr "Control flow:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  return sites: "))
      (call_void write_i64_dec (param_get fd) (local_get returns_sites))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  conditionals: "))
      (call_void write_i64_dec (param_get fd) (local_get conditionals))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  loops: "))
      (call_void write_i64_dec (param_get fd) (local_get loop_sites))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "Calls:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  direct calls:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (if
        (condition (ne_ptr (local_get direct_ctx) (const_null)))
        (then (do
          (call_void audit_emit_callee_list (param_get fd) (param_get source) (param_get tree) (local_get direct_ctx))))
        (else (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  none"))
          (call_void write_byte (param_get fd) (const_i32 10)))))
      (call_void write_cstr (param_get fd) (const_string_ptr "  external calls:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (if
        (condition (ne_ptr (local_get runtime_ctx) (const_null)))
        (then (do
          (call_void audit_emit_callee_list (param_get fd) (param_get source) (param_get tree) (local_get runtime_ctx))))
        (else (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  none"))
          (call_void write_byte (param_get fd) (const_i32 10)))))
      (call_void write_cstr (param_get fd) (const_string_ptr "Memory:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  allocation: "))
      (let has_alloc i32 (const_i32 0))
      (if
        (condition (ne_ptr (param_get effect_table) (const_null)))
        (then (do
          (if
            (condition (eq_i32 (call_i32 effect_table_trans_alloc (param_get effect_table) (param_get fn_node)) (const_i32 1)))
            (then (do (set has_alloc (const_i32 1))))
            (else (do)))))
        (else (do
          (if
            (condition (gt_i64 (local_get allocations) (const_i64 0)))
            (then (do (set has_alloc (const_i32 1))))
            (else (do))))))
      (call_void audit_emit_yes_no (param_get fd) (local_get has_alloc))
      (call_void write_byte (param_get fd) (const_i32 10))
      (call_void write_cstr (param_get fd) (const_string_ptr "  runtime calls:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (if
        (condition (and_bool
          (ne_ptr (local_get runtime_ctx) (const_null))
          (gt_i64 (call_i64 explain_ctx_count (local_get runtime_ctx)) (const_i64 0))))
        (then (do
          (call_void audit_emit_callee_list (param_get fd) (param_get source) (param_get tree) (local_get runtime_ctx))))
        (else (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  none"))
          (call_void write_byte (param_get fd) (const_i32 10)))))
      (call_void write_cstr (param_get fd) (const_string_ptr "Purity:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (if
        (condition (ne_ptr (local_get runtime_ctx) (const_null)))
        (then (do
          (call_void audit_emit_purity_line (param_get fd) (param_get effect_table) (param_get fn_node)
            (local_get allocations) (local_get runtime_ctx) (local_get unknown_ctx))))
        (else (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  conservative: pure"))
          (call_void write_byte (param_get fd) (const_i32 10)))))
      (call_void write_cstr (param_get fd) (const_string_ptr "Warnings:"))
      (call_void write_byte (param_get fd) (const_i32 10))
      (if
        (condition (and_bool
          (ne_ptr (local_get runtime_ctx) (const_null))
          (ne_ptr (local_get unknown_ctx) (const_null))))
        (then (do
          (call_void audit_emit_warnings (param_get fd) (param_get source) (param_get tree)
            (local_get n_req) (local_get n_ens) (local_get allocations)
            (local_get runtime_ctx) (local_get unknown_ctx))))
        (else (do
          (call_void write_cstr (param_get fd) (const_string_ptr "  none"))
          (call_void write_byte (param_get fd) (const_i32 10)))))
      (call_void write_byte (param_get fd) (const_i32 10))
      (if
        (condition (ne_ptr (local_get direct_ctx) (const_null)))
        (then (do (call_void explain_ctx_free (local_get direct_ctx))))
        (else (do)))
      (if
        (condition (ne_ptr (local_get runtime_ctx) (const_null)))
        (then (do (call_void explain_ctx_free (local_get runtime_ctx))))
        (else (do)))
      (if
        (condition (ne_ptr (local_get unknown_ctx) (const_null)))
        (then (do (call_void explain_ctx_free (local_get unknown_ctx))))
        (else (do)))
      (return_void)))

